---
import '../styles/global.css';
import GameScene from '../components/GameScene.astro';
import Brand from '../components/Brand.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../data/site.js';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
  hideFooter?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  noIndex = false,
  hideFooter = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isCompareSection =
  path === '/compare/' || path.startsWith('/compare/') || path.startsWith('/models/');
const showScene = !hideFooter && !isCompareSection;

const nav = [
  { href: '/#learn', label: 'Learn', current: false },
  { href: '/guides/', label: 'Guides', current: path === '/guides/' || path.startsWith('/guides/') },
  { href: '/games/', label: 'Games', current: path === '/games/' || path.startsWith('/games/') },
  {
    href: '/compare/',
    label: 'AI Tools',
    current: path === '/compare/' || path.startsWith('/compare/') || path.startsWith('/models/'),
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ColinBuilds',
  alternateName: SITE_TITLE,
  url: 'https://colinbuilds.com/',
  description: SITE_DESCRIPTION,
};
---

<!doctype html>
<html lang="en" class:list={[hideFooter && 'h-dvh']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="application-name" content="ColinBuilds" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class:list={['bg-black text-white antialiased', hideFooter ? 'flex h-dvh flex-col overflow-hidden' : 'min-h-screen', showScene && 'has-scene']}>
    <header class:list={['border-b border-neutral-800 bg-black/95 backdrop-blur', hideFooter && 'shrink-0']}>
      <div class="mx-auto flex max-w-[90rem] flex-wrap items-center justify-between gap-x-4 px-6 py-4 lg:flex-nowrap">
        <a href="/" class="shrink-0 text-base font-semibold tracking-tight">
          <Brand />
        </a>
        <nav
          class="order-3 flex w-full flex-wrap items-center gap-x-4 gap-y-1 text-sm lg:order-none lg:w-auto lg:flex-1 lg:justify-center lg:gap-5"
          aria-label="Main"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'inline-flex min-h-8 items-center border-b-2 py-1 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-400',
                  item.current
                    ? 'border-cyan-400 text-white'
                    : 'border-transparent text-neutral-400',
                ]}
                aria-current={item.current ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-1 lg:ml-0">
          <a
            href="/compare/"
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-neutral-300 transition hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            aria-label="AI Tools"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path stroke-linecap="round" d="m20 20-3-3"></path>
            </svg>
          </a>
          <span
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-neutral-300"
            aria-hidden="true"
            title="Dark mode"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <circle cx="12" cy="12" r="4"></circle>
              <path stroke-linecap="round" d="M12 3v1.5M12 19.5V21M4.93 4.93l1.06 1.06M17.99 17.99l1.06 1.06M3 12h1.5M19.5 12H21M4.93 19.07l1.06-1.06M17.99 6.01l1.06-1.06"></path>
            </svg>
          </span>
        </div>
      </div>
    </header>
    <main class:list={[hideFooter && 'flex min-h-0 flex-1 flex-col']}>
      {showScene && <GameScene />}
      <slot />
    </main>
    {
      !hideFooter && (
        <footer class="border-t border-neutral-800 py-8 text-center text-sm text-neutral-500">
          <Brand /> · A place to learn. Read or play.
        </footer>
      )
    }
  </body>
</html>

---
import '../styles/global.css';
import Brand from '../components/Brand.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'ColinBuilds.com AI Model Directory' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-black text-white antialiased">
    <header class="border-b border-neutral-800 bg-black/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" class="text-sm font-semibold tracking-wide">
          <Brand />
        </a>
        <span class="rounded-full border border-neutral-700 px-3 py-1 text-xs text-neutral-400">
          AI Model Directory
        </span>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-neutral-800 py-8 text-center text-sm text-neutral-500">
      <Brand /> · Programmatic SEO directory
    </footer>
  </body>
</html>

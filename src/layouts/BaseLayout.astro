---
import '../styles/global.css';
import GameScene from '../components/GameScene.astro';
import Brand from '../components/Brand.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../data/site.js';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
  hideFooter?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  noIndex = false,
  hideFooter = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isCompareSection =
  path === '/compare/' || path.startsWith('/compare/') || path.startsWith('/models/');
const isGuidesSection = path === '/guides/' || path.startsWith('/guides/');
const showScene = !hideFooter && !isCompareSection && !isGuidesSection;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ColinBuilds',
  alternateName: SITE_TITLE,
  url: 'https://colinbuilds.com/',
  description: SITE_DESCRIPTION,
};
---

<!doctype html>
<html lang="en" data-theme="dark" class:list={[hideFooter && 'h-dvh']}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('cb-theme');
          if (t !== 'light') t = 'dark';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="application-name" content="ColinBuilds" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class:list={['bg-black text-white antialiased', hideFooter ? 'flex h-dvh flex-col overflow-hidden' : 'min-h-screen', showScene && 'has-scene']}>
    <header class:list={['site-header border-b border-neutral-800 bg-black/95 backdrop-blur', hideFooter && 'shrink-0']}>
      <div class="mx-auto flex max-w-[90rem] items-center justify-between gap-x-4 px-6 py-4">
        <a href="/" class="shrink-0 text-base font-semibold tracking-tight">
          <Brand />
        </a>
        <div class="flex items-center gap-1">
          <a
            href="/compare/"
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-neutral-300 transition hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            aria-label="API Pricing"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path stroke-linecap="round" d="m20 20-3-3"></path>
            </svg>
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main class:list={[hideFooter && 'flex min-h-0 flex-1 flex-col']}>
      {showScene && <GameScene />}
      <slot />
    </main>
    {
      !hideFooter && (
        <footer class="site-footer border-t border-neutral-800 py-8 text-center text-sm text-neutral-500">
          <Brand /> · A place to learn. Read or play.
        </footer>
      )
    }
  </body>
</html>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Brand from '../../components/Brand.astro';
import EnterpriseRoutingCalculator from '../../components/EnterpriseRoutingCalculator.astro';
import { routingModelFromEntry } from '../../lib/enterpriseRouting';
import { hasVerifiedPricing } from '../../lib/pricing';
import { getCollection } from 'astro:content';

const liveEntries = (await getCollection('models')).filter(
  (entry) => entry.data.draft !== true && hasVerifiedPricing(entry.data),
);

const modelAEntry = liveEntries.find((entry) => entry.slug === 'gpt-4o') ?? liveEntries[0];
const modelBEntry =
  liveEntries.find((entry) => entry.slug === 'deepseek-v4-flash') ??
  liveEntries.find((entry) => entry.slug !== modelAEntry?.slug) ??
  liveEntries[1];

const modelA = modelAEntry ? routingModelFromEntry(modelAEntry) : null;
const modelB = modelBEntry ? routingModelFromEntry(modelBEntry) : null;
---

<BaseLayout
  title="Enterprise model routing calculator (preview) | ColinBuilds.com"
  description="Preview: estimate monthly API savings when routing routine traffic to low-cost models and reserving premium models for complex tasks."
  noIndex={true}
>
  <div class="border-b border-amber-500/30 bg-amber-500/10 px-6 py-3 text-center text-sm text-amber-100">
    Labs preview — not indexed, not linked from the public directory. Chief approval required before launch.
  </div>

  <section class="mx-auto max-w-6xl px-6 py-14">
    <p class="mb-3 text-sm font-medium tracking-wide">
      <Brand />
      <span class="text-neutral-500"> · Labs preview</span>
    </p>
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
      Cut AI API spend with model routing
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-neutral-400">
      Sample pair preview. On comparison pages, rates load from each model&apos;s database file automatically.
    </p>

    {
      modelA && modelB ? (
        <div class="mt-10">
          <EnterpriseRoutingCalculator modelA={modelA} modelB={modelB} />
        </div>
      ) : (
        <p class="mt-10 text-sm text-neutral-500">Needs two priced live models.</p>
      )
    }
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from '../components/Brand.astro';
import { getLiveComparisonPairs } from '../lib/compare';
import { getCollection } from 'astro:content';

const hasOfficialCalculatorPricing = (model: { data: { cost_input_1m?: number; cost_output_1m?: number } }) =>
  model.data.cost_input_1m != null && model.data.cost_output_1m != null;

const models = (await getCollection('models'))
  .filter(hasOfficialCalculatorPricing)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const { allComparisons } = await getLiveComparisonPairs();

const usd = (value: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: value < 1 ? 3 : 2,
  }).format(value);

const formatContext = (value?: number) => {
  if (value == null) return null;
  return `${new Intl.NumberFormat('en-US').format(value)} token context`;
};

const cardSummary = (model: (typeof models)[number]) => {
  const { cost_input_1m, cost_output_1m, context_window, pricing_note } = model.data;
  if (cost_input_1m != null && cost_output_1m != null) {
    return `${usd(cost_input_1m)} in · ${usd(cost_output_1m)} out / 1M`;
  }
  if (pricing_note) return 'No official API price · see page';
  const context = formatContext(context_window);
  if (context) return context;
  return model.data.entry_badge ?? 'Model profile';
};

const badgeFor = (model: (typeof models)[number]) => {
  if (model.data.entry_badge) return model.data.entry_badge;
  if (model.data.entry_type === 'reference') return 'Reference';
  if (model.data.entry_type === 'open-weight') return 'Open-weight';
  return 'Model';
};

const badgeClassFor = (model: (typeof models)[number]) =>
  model.data.entry_type === 'reference'
    ? 'border-blue-500/30 bg-blue-500/10 text-blue-300'
    : model.data.entry_type === 'open-weight'
      ? 'border-neutral-600 bg-neutral-900 text-neutral-300'
      : 'border-cyan-500/30 bg-cyan-500/10 text-cyan-300';
---

<BaseLayout
  title="ColinBuilds.com | AI Model Directory"
  description="Compare API pricing, context windows, and model profiles for GPT-4o, Claude Sonnet, DeepSeek, Qwen, Mistral, and more."
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <p class="mb-3 text-sm font-medium tracking-wide">
      <Brand />
    </p>
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
      AI Model Directory
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-neutral-400">
      API pricing and context windows for the models builders compare every day.
    </p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        models.map((model) => (
          <a
            href={`/models/${model.slug}`}
            class="group rounded-2xl border border-neutral-800 bg-neutral-950 p-6 transition hover:border-blue-500/50 hover:bg-neutral-900"
          >
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-xl font-semibold text-white group-hover:text-cyan-400">
                {model.data.title}
              </h2>
              <span class={`shrink-0 rounded-full border px-2 py-0.5 text-xs ${badgeClassFor(model)}`}>
                {badgeFor(model)}
              </span>
            </div>
            <p class="mt-2 text-sm text-neutral-500">{cardSummary(model)}</p>
          </a>
        ))
      }
    </div>

    {
      allComparisons.length > 0 && (
        <section class="mt-16 border-t border-neutral-800 pt-16">
          <h2 class="text-2xl font-bold tracking-tight text-white">Match-ups</h2>
          <p class="mt-2 max-w-2xl text-neutral-400">
            Head-to-head API cost and benchmark comparisons across every live model in the directory.
          </p>
          <ul class="mt-8 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {
              allComparisons.map((comparison) => (
                <li>
                  <a
                    href={comparison.href}
                    class="block rounded-xl border border-neutral-800 bg-neutral-950 px-4 py-3 text-sm text-neutral-300 transition hover:border-cyan-500/40 hover:bg-neutral-900 hover:text-cyan-300"
                  >
                    {comparison.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      )
    }
  </section>
</BaseLayout>

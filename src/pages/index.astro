---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const models = (await getCollection('models')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="ColinBuilds | AI Model Directory">
  <section class="mx-auto max-w-6xl px-6 py-16">
    <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-cyan-400">
      Programmatic SEO Directory
    </p>
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
      AI Model Directory
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-400">
      High-speed model profiles sourced from your Obsidian vault via Vault CMS. Each page is generated from local Markdown frontmatter.
    </p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        models.map((model) => (
          <a
            href={`/models/${model.id}`}
            class="group rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition hover:border-cyan-500/40 hover:bg-slate-900"
          >
            <h2 class="text-xl font-semibold text-white group-hover:text-cyan-300">
              {model.data.title}
            </h2>
            <p class="mt-2 text-sm text-slate-400">
              {new Intl.NumberFormat('en-US').format(model.data.context_window)} token context · MMLU {model.data.mmlu_score}%
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

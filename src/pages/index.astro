---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    id: 'learn',
    href: '#learn',
    title: 'Learn',
    description: 'Step-by-step lessons from the very basics of AI.',
    icon: 'learn',
    accent: 'cyan',
  },
  {
    id: 'guides',
    href: '#guides',
    title: 'Guides',
    description: 'Beginner guides to help you understand tools and topics.',
    icon: 'guides',
    accent: 'green',
  },
  {
    id: 'builds',
    href: '/builds/nebula-x/',
    title: 'Builds',
    description: "Explore projects I've built and learn from them.",
    icon: 'builds',
    accent: 'purple',
  },
  {
    id: 'tools',
    href: '#tools',
    title: 'Tools',
    description: 'Useful tools and resources to save you time.',
    icon: 'tools',
    accent: 'yellow',
  },
  {
    id: 'games',
    href: '#games',
    title: 'Games',
    description: 'Learn by playing. Fun, simple and interactive.',
    icon: 'games',
    accent: 'pink',
  },
  {
    id: 'weekly',
    href: '#weekly',
    title: 'Weekly',
    description: 'Weekly blog posts and thoughts on AI and more.',
    icon: 'weekly',
    accent: 'sky',
  },
  {
    id: 'compare',
    href: '/compare/',
    title: 'Compare AI',
    description: 'Compare AI models and APIs side by side.',
    icon: 'compare',
    accent: 'blue',
  },
] as const;

const accents = {
  cyan: {
    icon: 'text-cyan-400',
    hover: 'hover:border-cyan-400 focus-visible:border-cyan-400',
    explore: 'text-cyan-400 group-hover:text-cyan-300',
  },
  green: {
    icon: 'text-green-400',
    hover: 'hover:border-green-400 focus-visible:border-green-400',
    explore: 'text-green-400 group-hover:text-green-300',
  },
  purple: {
    icon: 'text-purple-400',
    hover: 'hover:border-purple-400 focus-visible:border-purple-400',
    explore: 'text-purple-400 group-hover:text-purple-300',
  },
  yellow: {
    icon: 'text-yellow-400',
    hover: 'hover:border-yellow-400 focus-visible:border-yellow-400',
    explore: 'text-yellow-400 group-hover:text-yellow-300',
  },
  pink: {
    icon: 'text-pink-400',
    hover: 'hover:border-pink-400 focus-visible:border-pink-400',
    explore: 'text-pink-400 group-hover:text-pink-300',
  },
  sky: {
    icon: 'text-sky-300',
    hover: 'hover:border-sky-300 focus-visible:border-sky-300',
    explore: 'text-sky-300 group-hover:text-sky-200',
  },
  blue: {
    icon: 'text-blue-400',
    hover: 'hover:border-blue-400 focus-visible:border-blue-400',
    explore: 'text-blue-400 group-hover:text-blue-300',
  },
};

const principles = [
  {
    title: 'Beginner Friendly',
    body: 'No confusing jargon. We explain everything in plain English.',
    icon: 'shield',
    iconClass: 'text-cyan-400',
  },
  {
    title: 'Learn by Doing',
    body: 'Practical lessons, real projects and hands-on learning that builds real skills.',
    icon: 'smile',
    iconClass: 'text-yellow-400',
  },
  {
    title: 'A Safe Space',
    body: 'Be curious, ask questions, and learn at your own pace.',
    icon: 'heart',
    iconClass: 'text-pink-400',
  },
];

const iconBox = 'h-6 w-6';
---

<BaseLayout
  title="ColinBuilds.com | Learn, build and explore"
  description="Learn, build and explore AI — from zero to confident. Choose your path or start with the basics."
>
  <div class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-80 bg-[radial-gradient(ellipse_at_top,_rgba(34,211,238,0.12),_transparent_65%)]"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-[90rem] px-6 py-12 pb-20">
      <section id="start-here" aria-labelledby="home-hero-title">
        <h1 id="home-hero-title" class="max-w-xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
          Welcome to <span class="text-cyan-400">ColinBuilds</span>
        </h1>
        <p class="mt-4 max-w-lg text-neutral-400">
          Learn, build and explore AI — from zero to confident. Choose your path or start with the basics.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="#start-here"
            class="inline-flex items-center gap-2 rounded-lg bg-cyan-400 px-4 py-2.5 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
            </svg>
            New here? Start Here
          </a>
          <a
            href="#sections"
            class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-4 py-2.5 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
          >
            Browse all sections
          </a>
        </div>
      </section>

      <section id="sections" class="mt-14" aria-label="All sections">
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7">
          {
            sections.map((section) => {
              const tone = accents[section.accent];
              return (
                <li class="min-w-0">
                  <a
                    id={section.id}
                    href={section.href}
                    class:list={[
                      'group flex h-full scroll-mt-24 flex-col rounded-xl border border-neutral-800 bg-neutral-950 p-5 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400',
                      tone.hover,
                    ]}
                  >
                    <span class:list={['inline-flex', tone.icon]}>
                      {section.icon === 'learn' && (
                        <svg class={iconBox} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M22 10v6M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path>
                        </svg>
                      )}
                      {section.icon === 'guides' && (
                        <svg class={iconBox} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v14M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path>
                        </svg>
                      )}
                      {section.icon === 'builds' && (
                        <svg class={iconBox} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3.3 7 12 12l8.7-5M12 22V12"></path>
                        </svg>
                      )}
                      {section.icon === 'tools' && (
                        <svg class={iconBox} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"></path>
                        </svg>
                      )}
                      {section.icon === 'games' && (
                        <svg class={iconBox} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6 11h4M8 9v4m7 .5h.01M18 10h.01M6.5 6h11A3.5 3.5 0 0 1 21 9.5v3A5.5 5.5 0 0 1 15.5 18h-7A5.5 5.5 0 0 1 3 12.5v-3A3.5 3.5 0 0 1 6.5 6Z"></path>
                        </svg>
                      )}
                      {section.icon === 'weekly' && (
                        <svg class={iconBox} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
                        </svg>
                      )}
                      {section.icon === 'compare' && (
                        <svg class={iconBox} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path>
                          <path stroke-linecap="round" d="M7 21h10M12 3v18"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path>
                        </svg>
                      )}
                    </span>
                    <h2 class="mt-4 text-base font-semibold tracking-tight text-white">{section.title}</h2>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-400">{section.description}</p>
                    <span class:list={['mt-5 text-sm', tone.explore]}>Explore →</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section class="mt-14" aria-label="How we teach">
        <ul class="grid grid-cols-1 divide-y divide-neutral-800 overflow-hidden rounded-xl border border-neutral-800 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          {
            principles.map((principle) => (
              <li class="px-6 py-6">
                <span class:list={['inline-flex', principle.iconClass]}>
                  {principle.icon === 'shield' && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.68 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"></path>
                    </svg>
                  )}
                  {principle.icon === 'smile' && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path stroke-linecap="round" d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"></path>
                    </svg>
                  )}
                  {principle.icon === 'heart' && (
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                    </svg>
                  )}
                </span>
                <h2 class="mt-3 text-base font-semibold tracking-tight text-white">{principle.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-neutral-400">{principle.body}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

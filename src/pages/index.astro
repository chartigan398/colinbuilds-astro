---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from '../components/Brand.astro';
import { SITE_DESCRIPTION } from '../data/site.js';

const startHere = [
  {
    href: '/guides/',
    title: 'Start with AI',
    description: 'Four short guides. Begin with the history, then what the words mean.',
    cta: 'Start learning →',
    accent: 'green',
  },
  {
    href: '/philosophia/',
    title: 'Learn philosophy',
    description: 'Short lessons on ways of thinking. One idea at a time.',
    cta: 'Open philosophy →',
    accent: 'cyan',
  },
  {
    href: '/games/',
    title: 'Practise with games',
    description: 'Memory, maths, spelling, typing and reactions.',
    cta: 'Open games →',
    accent: 'pink',
  },
];

const alsoHere = [
  {
    href: '/builds/nebula-x/',
    title: 'Builds',
    description: 'Nebula X, a free music visualizer that runs on your computer.',
    cta: 'Open Nebula X →',
    accent: 'purple',
  },
  {
    href: '/compare/',
    title: 'AI Tools',
    description: 'Compare API prices and model pages. For people who already use the tools.',
    cta: 'Compare models →',
    accent: 'blue',
  },
  {
    href: '/weekly/',
    title: 'AI Weekly',
    description: 'A roundup of AI news. Written for people who already follow this field.',
    cta: 'Read edition 01 →',
    accent: 'sky',
  },
];

const accents = {
  cyan: 'hover:border-cyan-400 text-cyan-400 group-hover:text-cyan-300',
  green: 'hover:border-green-400 text-green-400 group-hover:text-green-300',
  purple: 'hover:border-purple-400 text-purple-400 group-hover:text-purple-300',
  pink: 'hover:border-pink-400 text-pink-400 group-hover:text-pink-300',
  sky: 'hover:border-sky-300 text-sky-300 group-hover:text-sky-200',
  blue: 'hover:border-blue-400 text-blue-400 group-hover:text-blue-300',
};
---

<BaseLayout title="ColinBuilds — Free lessons for beginners" description={SITE_DESCRIPTION}>
  <div class="relative mx-auto max-w-6xl px-6 py-12 pb-20">
    <section aria-labelledby="home-hero-title">
      <h1 id="home-hero-title" class="max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
        Welcome to <Brand />
      </h1>
      <p class="mt-4 max-w-xl text-lg text-neutral-400">
        Free lessons, guides and games for beginners.
      </p>
      <p class="mt-3 max-w-xl text-neutral-400">
        A free learning hub. Start with AI, try a philosophy lesson, or practise with a game.
      </p>
      <a
        href="/learn/"
        class="mt-8 inline-flex items-center rounded-lg border border-cyan-400 bg-cyan-400 px-5 py-2.5 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
      >
        Start learning
      </a>
    </section>

    <section class="mt-16" aria-labelledby="start-here-title">
      <h2 id="start-here-title" class="text-sm font-semibold tracking-widest text-cyan-400">Start here</h2>
      <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {
          startHere.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'group game-listing-card flex h-full flex-col rounded-xl border border-neutral-800 bg-neutral-950/80 p-5 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400',
                  accents[item.accent].split(' ')[0],
                ]}
              >
                <h3 class="text-lg font-semibold tracking-tight text-white">{item.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-400">{item.description}</p>
                <span class:list={['mt-5 text-sm', accents[item.accent].split(' ').slice(1).join(' ')]}>
                  {item.cta}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16" aria-labelledby="also-here-title">
      <h2 id="also-here-title" class="text-sm font-semibold tracking-widest text-cyan-400">Also here</h2>
      <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          alsoHere.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'group game-listing-card flex h-full flex-col rounded-xl border border-neutral-800 bg-neutral-950/80 p-5 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400',
                  accents[item.accent].split(' ')[0],
                ]}
              >
                <h3 class="text-lg font-semibold tracking-tight text-white">{item.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-400">{item.description}</p>
                <span class:list={['mt-5 text-sm', accents[item.accent].split(' ').slice(1).join(' ')]}>
                  {item.cta}
                </span>
              </a>
            </li>
          ))
        }
        <li>
          <div class="flex h-full flex-col rounded-xl border border-neutral-800 bg-neutral-950/80 p-5">
            <h3 class="text-lg font-semibold tracking-tight text-white">More tools</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-400">
              Extra tools besides the price comparison. Not ready yet.
            </p>
            <span class="mt-5 text-sm text-neutral-500">Coming soon</span>
          </div>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

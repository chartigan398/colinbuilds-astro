---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides'))
  .filter((entry) => entry.data.draft !== true)
  .sort((a, b) => a.data.guide_no.localeCompare(b.data.guide_no));
---

<BaseLayout
  title="Guides | ColinBuilds"
  description="Beginner guides to help you understand tools and topics."
>
  <div class="mx-auto max-w-6xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · Guides</span>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Guides</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Beginner guides to help you understand tools and topics. Plain English. No jargon unless we explain it.
    </p>

    {
      guides.length === 0 ? (
        <p class="mt-10 text-sm text-neutral-500">No guides yet.</p>
      ) : (
        <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {guides.map((guide) => (
            <li>
              <a
                href={`/guides/${guide.slug}/`}
                class="group flex h-full flex-col rounded-xl border border-neutral-800 bg-neutral-950 p-5 transition hover:border-green-400 focus-visible:border-green-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
              >
                <p class="text-xs font-semibold tracking-widest text-cyan-400">
                  {guide.data.guide_no}
                </p>
                <h2 class="mt-2 text-lg font-semibold tracking-tight text-white">{guide.data.title}</h2>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-400">{guide.data.description}</p>
                <span class="mt-5 text-sm text-green-400 group-hover:text-green-300">Read guide →</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

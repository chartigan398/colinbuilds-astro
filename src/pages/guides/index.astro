---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides'))
  .filter((entry) => entry.data.draft !== true)
  .sort((a, b) => a.data.guide_no.localeCompare(b.data.guide_no));
---

<BaseLayout
  title="Guides | ColinBuilds"
  description="Four short beginner guides to AI. What it is, how it learns, and what a prompt is. No coding needed."
>
  <div class="mx-auto max-w-6xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/learn/" class="transition hover:text-cyan-400">Learn</a>
      <span> · Guides</span>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Guides</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Read them in order. Guide 01 to Guide 04. Each one is short. You do not need coding.
    </p>
    <p class="mt-2 text-sm text-neutral-500" id="guide-progress" hidden></p>

    {
      guides.length === 0 ? (
        <p class="mt-10 text-sm text-neutral-500">No guides yet.</p>
      ) : (
        <ol class="mt-10 grid grid-cols-1 gap-4">
          {guides.map((guide) => (
            <li>
              <a
                href={`/guides/${guide.slug}/`}
                data-guide-slug={guide.slug}
                class="group game-listing-card flex h-full flex-col rounded-xl border border-neutral-800 bg-neutral-950/80 p-5 transition hover:border-green-400 focus-visible:border-green-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
              >
                <p class="text-xs font-semibold tracking-widest text-cyan-400">
                  Guide {guide.data.guide_no}
                  <span class="guide-done ml-2 hidden text-neutral-500" data-done={guide.slug}>
                    · Done
                  </span>
                </p>
                <h2 class="mt-2 text-lg font-semibold tracking-tight text-white">{guide.data.title}</h2>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-400">{guide.data.description}</p>
                <span class="mt-5 text-sm text-green-400 group-hover:text-green-300">Read guide →</span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>

<script>
  const doneKey = 'cb-guides-done';
  try {
    const done = JSON.parse(localStorage.getItem(doneKey) || '[]');
    const total = document.querySelectorAll('[data-guide-slug]').length;
    document.querySelectorAll('[data-done]').forEach((el) => {
      if (done.includes(el.getAttribute('data-done'))) el.classList.remove('hidden');
    });
    const progress = document.getElementById('guide-progress');
    if (progress && total) {
      progress.hidden = false;
      progress.textContent = `${done.filter((slug: string) => document.querySelector(`[data-guide-slug="${slug}"]`)).length} of ${total} finished on this computer.`;
    }
  } catch (e) {}
</script>

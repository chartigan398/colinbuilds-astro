---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides'))
  .filter((entry) => entry.data.draft !== true)
  .sort((a, b) => a.data.guide_no.localeCompare(b.data.guide_no));
---

<BaseLayout
  title="AI Guides | ColinBuilds"
  description="Four short beginner guides to AI. What it is, how it learns, and what a prompt is. No coding needed."
>
  <div class="page">
    <p class="crumbs">
      <a href="/">Home</a>
      <span> · </span>
      <a href="/learn/">Learn</a>
      <span> · AI</span>
    </p>
    <h1 class="mt-4 text-4xl text-white sm:text-5xl">AI</h1>
    <p class="lede">Read them in order. Guide 01 to Guide 04. Each one is short. You do not need coding.</p>
    <p class="mt-3 text-sm text-neutral-500" id="guide-progress" hidden></p>

    {
      guides.length === 0 ? (
        <p class="mt-10 text-sm text-neutral-500">No guides yet.</p>
      ) : (
        <ol class="row-list">
          {guides.map((guide) => (
            <li>
              <a href={`/guides/${guide.slug}/`} data-guide-slug={guide.slug} class="row-link">
                <div>
                  <p class="row-kicker">
                    Guide {guide.data.guide_no}
                    <span class="guide-done hidden" data-done={guide.slug}>
                      · Done
                    </span>
                  </p>
                  <h2 class="row-title">{guide.data.title}</h2>
                  <p class="row-desc">{guide.data.description}</p>
                </div>
                <span class="row-cta">Read →</span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>

<script>
  const doneKey = 'cb-guides-done';
  try {
    const done = JSON.parse(localStorage.getItem(doneKey) || '[]');
    const total = document.querySelectorAll('[data-guide-slug]').length;
    document.querySelectorAll('[data-done]').forEach((el) => {
      if (done.includes(el.getAttribute('data-done'))) el.classList.remove('hidden');
    });
    const progress = document.getElementById('guide-progress');
    if (progress && total) {
      progress.hidden = false;
      progress.textContent = `${done.filter((slug: string) => document.querySelector(`[data-guide-slug="${slug}"]`)).length} of ${total} finished on this computer.`;
    }
  } catch (e) {}
</script>

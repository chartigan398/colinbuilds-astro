---
import '../../styles/philosophia.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCheck from '../../components/GuideCheck.astro';
import { getCollection, render } from 'astro:content';
import { guideChecks } from '../../data/guide-checks.js';

export async function getStaticPaths() {
  const guides = (await getCollection('guides'))
    .filter((entry) => entry.data.draft !== true)
    .sort((a, b) => a.data.guide_no.localeCompare(b.data.guide_no));

  return guides.map((guide, index) => ({
    params: { slug: guide.slug },
    props: {
      guide,
      previous: index > 0 ? guides[index - 1] : null,
      next: index < guides.length - 1 ? guides[index + 1] : null,
    },
  }));
}

const { guide, previous, next } = Astro.props;
const { Content } = await render(guide);
const published = guide.data.pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const updated = guide.data.updatedDate
  ? guide.data.updatedDate.toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;
const guideNo = guide.data.guide_no;
const isGuideSeries = guide.slug !== 'a-beginners-history-of-ai';
const checks = guideChecks[guideNo] ?? [];
const related =
  guideNo === '01'
    ? [{ href: '/guides/what-are-ai-machine-learning-and-generative-ai/', label: 'Next: what the words mean' }]
    : guideNo === '02'
      ? [
          { href: '/guides/how-machine-learning-actually-learns/', label: 'Next: how it learns' },
          { href: '/philosophia/', label: 'More lessons: philosophy' },
        ]
      : guideNo === '03'
        ? [
            { href: '/guides/what-is-a-prompt/', label: 'Next: what is a prompt' },
            { href: '/games/math-sprint/', label: 'Practise: Math Sprint' },
          ]
        : [
            { href: '/games/typing-speed/', label: 'Practise: Typing Speed' },
            { href: '/philosophia/', label: 'More lessons: philosophy' },
          ];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Article', 'LearningResource'],
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.pubDate.toISOString(),
  dateModified: (guide.data.updatedDate ?? guide.data.pubDate).toISOString(),
  educationalLevel: 'beginner',
  isAccessibleForFree: true,
  url: new URL(`/guides/${guide.slug}/`, Astro.site).href,
  author: { '@type': 'Organization', name: 'ColinBuilds' },
  publisher: { '@type': 'Organization', name: 'ColinBuilds', url: 'https://colinbuilds.com/' },
};
---

<BaseLayout
  title={`${guide.data.title} | ColinBuilds`}
  description={guide.data.description}
  jsonLd={articleJsonLd}
>
  <article class:list={['mx-auto max-w-3xl px-6 py-12 pb-20', isGuideSeries && 'guide-02']}>
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/learn/" class="transition hover:text-cyan-400">Learn</a>
      <span> · </span>
      <a href="/guides/" class="transition hover:text-cyan-400">Guides</a>
    </p>
    <p class="mt-3 text-sm font-semibold tracking-widest text-cyan-400">Guide {guideNo}</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-cyan-400 sm:text-4xl">{guide.data.title}</h1>
    <p class="mt-3 text-sm text-neutral-500">
      Published {published}
      {updated && updated !== published ? ` · Updated ${updated}` : ''}
    </p>
    <p class:list={['mt-4', isGuideSeries ? 'text-cyan-400' : 'text-neutral-400']}>{guide.data.description}</p>
    {
      guideNo === '01' && (
        <nav class="guide-toc mt-8 rounded-xl border border-neutral-800 p-5" aria-label="Contents">
          <p class="text-sm font-semibold tracking-widest text-cyan-400">Contents</p>
          <ol id="guide-toc-list" class="mt-3 grid gap-2 text-sm text-neutral-400"></ol>
        </nav>
      )
    }
    <div class="guide-prose mt-10">
      <Content />
    </div>
    {checks.length > 0 && <div class="mt-12"><GuideCheck questions={checks} /></div>}
    <nav class="mt-12 flex flex-wrap items-center justify-between gap-3" aria-label="Guide series">
      {
        previous ? (
          <a
            href={`/guides/${previous.slug}/`}
            class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
          >
            Previous: Guide {previous.data.guide_no}
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next ? (
          <a
            href={`/guides/${next.slug}/`}
            class="inline-flex items-center rounded-lg border border-cyan-400 bg-cyan-400 px-3 py-2 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            data-mark-done={guide.slug}
          >
            Next: Guide {next.data.guide_no}
          </a>
        ) : (
          <a
            href="/learn/"
            class="inline-flex items-center rounded-lg border border-cyan-400 bg-cyan-400 px-3 py-2 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            data-mark-done={guide.slug}
          >
            More lessons
          </a>
        )
      }
    </nav>
    <p class="mt-8 text-sm text-neutral-500">Also:</p>
    <ul class="mt-2 grid gap-2 text-sm">
      {
        related.map((item) => (
          <li>
            <a href={item.href} class="text-cyan-400 transition hover:text-cyan-300">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLImageElement>('.guide-prose img').forEach((img, index) => {
    img.decoding = 'async';
    if (index > 0) img.loading = 'lazy';
  });

  const tocList = document.getElementById('guide-toc-list');
  if (tocList) {
    document.querySelectorAll<HTMLHeadingElement>('.guide-prose h2').forEach((heading) => {
      if (!heading.id) {
        heading.id = heading.textContent
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '');
      }
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent;
      link.className = 'transition hover:text-cyan-400';
      item.appendChild(link);
      tocList.appendChild(item);
    });
  }

  const doneKey = 'cb-guides-done';
  document.querySelectorAll<HTMLAnchorElement>('[data-mark-done]').forEach((link) => {
    link.addEventListener('click', () => {
      const slug = link.getAttribute('data-mark-done');
      if (!slug) return;
      try {
        const done = JSON.parse(localStorage.getItem(doneKey) || '[]');
        if (!done.includes(slug)) done.push(slug);
        localStorage.setItem(doneKey, JSON.stringify(done));
      } catch (e) {}
    });
  });
</script>

<style>
  .guide-prose :global(img:not(.guide-photo):not(.guide-logo):not(.mnist-sample)) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: var(--cb-bg);
    border-radius: 0.75rem;
    border: 1px solid var(--cb-border);
  }

  .guide-prose :global(p:has(img)) {
    margin-top: 2.75rem;
    margin-bottom: 0.75rem;
  }

  .guide-prose :global(p:has(img) + h2) {
    margin-top: 0;
  }

  .guide-prose :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--cb-accent);
  }

  .guide-prose :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--cb-accent);
  }

  .guide-prose :global(p) {
    margin-top: 0.85rem;
    line-height: 1.7;
    color: var(--cb-fg);
  }

  .guide-prose :global(ul) {
    margin-top: 0.85rem;
    padding-left: 1.25rem;
    color: var(--cb-fg);
    line-height: 1.7;
    list-style: disc;
  }

  .guide-prose :global(ol) {
    margin-top: 0.85rem;
    padding-left: 1.25rem;
    color: var(--cb-fg);
    line-height: 1.75;
    list-style: decimal;
  }

  .guide-prose :global(li) {
    margin-top: 0.35rem;
  }

  .guide-prose :global(blockquote) {
    margin-top: 1rem;
    border-left: 2px solid var(--cb-accent);
    padding-left: 1rem;
    color: var(--cb-fg);
    font-style: italic;
  }

  .guide-prose :global(a) {
    color: var(--cb-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .guide-prose :global(a:hover) {
    color: var(--cb-accent-hot);
  }

  .guide-prose :global(em) {
    color: var(--cb-fg);
  }

  .guide-prose :global(strong) {
    color: var(--cb-fg);
    font-weight: 600;
  }

  .guide-02 .guide-prose :global(strong) {
    color: var(--cb-accent);
    font-weight: 600;
  }

  .guide-prose :global(.guide-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 1.75rem;
    color: var(--cb-fg);
    font-size: 0.875rem;
  }

  .guide-prose :global(.guide-meta span) {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--cb-border);
    border-radius: 999px;
  }

  .guide-prose :global(figure) {
    margin: 1.75rem 0 2rem;
  }

  .guide-prose :global(figcaption) {
    margin-top: 0.75rem;
    color: var(--cb-fg);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .guide-prose :global(.guide-diagram) {
    overflow: hidden;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--cb-border);
    border-radius: 0.75rem;
    background: var(--cb-bg-raised);
  }

  .guide-prose :global(.guide-map) {
    display: grid;
    gap: 1.75rem;
  }

  .guide-prose :global(.map-box) {
    position: relative;
    padding: 1rem 1.15rem;
    border: 1px solid var(--cb-border);
    border-radius: 0.75rem;
    background: var(--cb-bg-raised);
  }

  .guide-prose :global(.map-box b) {
    display: block;
    color: var(--cb-accent);
    font-size: 1.05rem;
  }

  .guide-prose :global(.map-box span) {
    color: var(--cb-fg);
    font-size: 0.9rem;
  }

  .guide-prose :global(.map-box:not(:last-of-type)::after) {
    content: '↓';
    position: absolute;
    left: 50%;
    bottom: -1.45rem;
    color: var(--cb-accent);
    font-weight: 700;
    transform: translateX(-50%);
  }

  .guide-prose :global(.map-note) {
    margin: 0;
    color: var(--cb-fg);
    font-size: 0.875rem;
  }

  .guide-prose :global(.teach-test) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: start;
  }

  .guide-prose :global(.split-heading) {
    margin: 0 0 0.85rem;
    color: var(--cb-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .guide-prose :global(.teach-photos) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .guide-prose :global(.labelled-photo),
  .guide-prose :global(.test-photo) {
    margin: 0;
  }

  .guide-prose :global(.guide-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.65rem;
  }

  .guide-prose :global(.photo-label),
  .guide-prose :global(.computer-guess) {
    display: block;
    margin-top: 0.4rem;
    color: var(--cb-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .guide-prose :global(.computer-guess) {
    font-size: 1.15rem;
    letter-spacing: 0.14em;
  }

  .guide-prose :global(.split-text) {
    margin: 0.85rem 0 0;
    color: var(--cb-fg);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .guide-prose :global(.teach-arrow) {
    align-self: center;
    color: var(--cb-accent);
    font-size: 1.75rem;
    font-weight: 700;
    text-align: center;
    padding-top: 1.5rem;
  }

  .guide-prose :global(.mail-row) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  .guide-prose :global(.mail-card) {
    padding: 1.15rem;
    border: 1px solid var(--cb-border);
    border-radius: 0.75rem;
    background: var(--cb-bg-raised);
  }

  .guide-prose :global(.mail-card p) {
    margin: 0.35rem 0 0;
  }

  .guide-prose :global(.mail-card .mail-meta) {
    margin: 0;
    color: var(--cb-fg);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .guide-prose :global(.learn-loop) {
    display: grid;
    gap: 1.75rem;
  }

  .guide-prose :global(.mnist-sample) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    background: #fff;
    border: 1px solid var(--cb-border);
    border-radius: 0.75rem;
    image-rendering: pixelated;
  }

  .guide-prose :global(.hallucination) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  .guide-prose :global(.answer-card) {
    padding: 1.15rem;
    border: 1px solid var(--cb-border);
    border-radius: 0.75rem;
    background: var(--cb-bg-raised);
  }

  .guide-prose :global(.answer-card p) {
    margin: 0.5rem 0 0;
    color: var(--cb-fg);
  }

  .guide-prose :global(.answer-card .label) {
    color: var(--cb-fg);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .guide-prose :global(.answer-card.false) {
    border-color: var(--cb-accent);
  }

  .guide-prose :global(.false-mark) {
    color: var(--cb-accent);
    font-weight: 700;
  }

  .guide-prose :global(.guide-callout) {
    margin: 1.75rem 0 2.25rem;
    padding: 1.35rem;
    border: 1px solid var(--cb-accent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--cb-accent) 12%, transparent);
  }

  .guide-prose :global(.guide-callout h2) {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.05rem;
  }

  .guide-prose :global(.guide-callout p) {
    margin-top: 0.45rem;
  }

  .guide-prose :global(.guide-recap p) {
    font-weight: 700;
    color: var(--cb-fg);
  }

  .guide-prose :global(.guide-key) {
    margin: 1.25rem 0;
    padding: 1rem 1.15rem;
    border-left: 4px solid var(--cb-accent);
    background: var(--cb-bg-raised);
  }

  .guide-prose :global(.guide-logo-wrap) {
    display: flex;
    justify-content: center;
    padding: 1.5rem 1.25rem;
    border: 1px solid var(--cb-border);
    border-radius: 0.75rem;
    background: var(--cb-bg-raised);
  }

  .guide-prose :global(.guide-logo) {
    display: block;
    width: min(100%, 18rem);
    height: auto;
  }

  .guide-prose :global(.table-wrap) {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    margin: 1.25rem 0;
  }

  .guide-prose :global(table) {
    width: 100%;
    min-width: 28rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .guide-prose :global(th),
  .guide-prose :global(td) {
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--cb-border);
    text-align: left;
    vertical-align: top;
  }

  .guide-prose :global(th) {
    color: var(--cb-accent);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .guide-prose :global(.teach-test),
    .guide-prose :global(.hallucination),
    .guide-prose :global(.mail-row) {
      grid-template-columns: 1fr;
    }

    .guide-prose :global(.teach-arrow) {
      transform: rotate(90deg);
      padding-top: 0;
    }

    .guide-prose :global(table) {
      min-width: 0;
      font-size: 0.9rem;
    }
  }
</style>

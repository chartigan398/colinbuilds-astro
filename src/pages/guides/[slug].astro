---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = (await getCollection('guides')).filter((entry) => entry.data.draft !== true);

  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const published = guide.data.pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const isGuide02 = guide.slug === 'what-are-ai-machine-learning-and-generative-ai';
---

<BaseLayout title={`${guide.data.title} | ColinBuilds`} description={guide.data.description}>
  <article class:list={['mx-auto max-w-3xl px-6 py-12 pb-20', isGuide02 && 'guide-02']}>
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/guides/" class="transition hover:text-cyan-400">Guides</a>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-cyan-400 sm:text-4xl">{guide.data.title}</h1>
    <p class="mt-3 text-sm text-neutral-500">{published}</p>
    <p class:list={['mt-4', isGuide02 ? 'text-cyan-400' : 'text-neutral-400']}>{guide.data.description}</p>
    <div class="guide-prose mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLImageElement>('.guide-prose img').forEach((img, index) => {
    img.decoding = 'async';
    if (index > 0) img.loading = 'lazy';
  });
</script>

<style>
  .guide-prose :global(img:not(.guide-photo):not(.guide-logo):not(.mnist-sample)) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: #000;
    border-radius: 0.75rem;
    border: 1px solid #262626;
  }

  .guide-prose :global(p:has(img)) {
    margin-top: 2.75rem;
    margin-bottom: 0.75rem;
  }

  .guide-prose :global(p:has(img) + h2) {
    margin-top: 0;
  }

  .guide-prose :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #22d3ee;
  }

  .guide-prose :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: #22d3ee;
  }

  .guide-prose :global(p) {
    margin-top: 0.85rem;
    line-height: 1.7;
    color: #ffffff;
  }

  .guide-prose :global(ul) {
    margin-top: 0.85rem;
    padding-left: 1.25rem;
    color: #ffffff;
    line-height: 1.7;
    list-style: disc;
  }

  .guide-prose :global(ol) {
    margin-top: 0.85rem;
    padding-left: 1.25rem;
    color: #ffffff;
    line-height: 1.75;
    list-style: decimal;
  }

  .guide-prose :global(li) {
    margin-top: 0.35rem;
  }

  .guide-prose :global(blockquote) {
    margin-top: 1rem;
    border-left: 2px solid #22d3ee;
    padding-left: 1rem;
    color: #ffffff;
    font-style: italic;
  }

  .guide-prose :global(a) {
    color: #22d3ee;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .guide-prose :global(a:hover) {
    color: #67e8f9;
  }

  .guide-prose :global(em) {
    color: #ffffff;
  }

  .guide-prose :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  .guide-02 .guide-prose :global(strong) {
    color: var(--color-brand-cyan);
    font-weight: 600;
  }

  .guide-prose :global(.guide-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 1.75rem;
    color: #ffffff;
    font-size: 0.875rem;
  }

  .guide-prose :global(.guide-meta span) {
    padding: 0.35rem 0.65rem;
    border: 1px solid #262626;
    border-radius: 999px;
  }

  .guide-prose :global(figure) {
    margin: 1.75rem 0 2rem;
  }

  .guide-prose :global(figcaption) {
    margin-top: 0.75rem;
    color: #ffffff;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .guide-prose :global(.guide-diagram) {
    overflow: hidden;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid #262626;
    border-radius: 0.75rem;
    background: #0a0a0a;
  }

  .guide-prose :global(.guide-map) {
    display: grid;
    gap: 1.75rem;
  }

  .guide-prose :global(.map-box) {
    position: relative;
    padding: 1rem 1.15rem;
    border: 1px solid #262626;
    border-radius: 0.75rem;
    background: #111111;
  }

  .guide-prose :global(.map-box b) {
    display: block;
    color: var(--color-brand-cyan);
    font-size: 1.05rem;
  }

  .guide-prose :global(.map-box span) {
    color: #ffffff;
    font-size: 0.9rem;
  }

  .guide-prose :global(.map-box:not(:last-of-type)::after) {
    content: '↓';
    position: absolute;
    left: 50%;
    bottom: -1.45rem;
    color: var(--color-brand-cyan);
    font-weight: 700;
    transform: translateX(-50%);
  }

  .guide-prose :global(.map-note) {
    margin: 0;
    color: #ffffff;
    font-size: 0.875rem;
  }

  .guide-prose :global(.teach-test) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: start;
  }

  .guide-prose :global(.split-heading) {
    margin: 0 0 0.85rem;
    color: var(--color-brand-cyan);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .guide-prose :global(.teach-photos) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .guide-prose :global(.labelled-photo),
  .guide-prose :global(.test-photo) {
    margin: 0;
  }

  .guide-prose :global(.guide-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.65rem;
  }

  .guide-prose :global(.photo-label),
  .guide-prose :global(.computer-guess) {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-brand-cyan);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .guide-prose :global(.computer-guess) {
    font-size: 1.15rem;
    letter-spacing: 0.14em;
  }

  .guide-prose :global(.split-text) {
    margin: 0.85rem 0 0;
    color: #ffffff;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .guide-prose :global(.teach-arrow) {
    align-self: center;
    color: var(--color-brand-cyan);
    font-size: 1.75rem;
    font-weight: 700;
    text-align: center;
    padding-top: 1.5rem;
  }

  .guide-prose :global(.mnist-sample) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    background: #fff;
    border: 1px solid #262626;
    border-radius: 0.75rem;
    image-rendering: pixelated;
  }

  .guide-prose :global(.hallucination) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  .guide-prose :global(.answer-card) {
    padding: 1.15rem;
    border: 1px solid #262626;
    border-radius: 0.75rem;
    background: #111111;
  }

  .guide-prose :global(.answer-card p) {
    margin: 0.5rem 0 0;
    color: #ffffff;
  }

  .guide-prose :global(.answer-card .label) {
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .guide-prose :global(.answer-card.false) {
    border-color: var(--color-brand-cyan);
  }

  .guide-prose :global(.false-mark) {
    color: var(--color-brand-cyan);
    font-weight: 700;
  }

  .guide-prose :global(.guide-callout) {
    margin: 1.75rem 0 2.25rem;
    padding: 1.35rem;
    border: 1px solid var(--color-brand-cyan);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-brand-cyan) 12%, transparent);
  }

  .guide-prose :global(.guide-callout h2) {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.05rem;
  }

  .guide-prose :global(.guide-callout p) {
    margin-top: 0.45rem;
  }

  .guide-prose :global(.guide-recap p) {
    font-weight: 700;
    color: #ffffff;
  }

  .guide-prose :global(.guide-key) {
    margin: 1.25rem 0;
    padding: 1rem 1.15rem;
    border-left: 4px solid var(--color-brand-cyan);
    background: #0a0a0a;
  }

  .guide-prose :global(.guide-logo-wrap) {
    display: flex;
    justify-content: center;
    padding: 1.5rem 1.25rem;
    border: 1px solid #262626;
    border-radius: 0.75rem;
    background: #0a0a0a;
  }

  .guide-prose :global(.guide-logo) {
    display: block;
    width: min(100%, 18rem);
    height: auto;
  }

  .guide-prose :global(.table-wrap) {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    margin: 1.25rem 0;
  }

  .guide-prose :global(table) {
    width: 100%;
    min-width: 28rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .guide-prose :global(th),
  .guide-prose :global(td) {
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid #262626;
    text-align: left;
    vertical-align: top;
  }

  .guide-prose :global(th) {
    color: var(--color-brand-cyan);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .guide-prose :global(.teach-test),
    .guide-prose :global(.hallucination) {
      grid-template-columns: 1fr;
    }

    .guide-prose :global(.teach-arrow) {
      transform: rotate(90deg);
      padding-top: 0;
    }

    .guide-prose :global(table) {
      min-width: 0;
      font-size: 0.9rem;
    }
  }
</style>

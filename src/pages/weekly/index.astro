---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const editions = (await getCollection('weekly'))
  .filter((entry) => entry.data.draft !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="AI Weekly | ColinBuilds" description="A weekly roundup of AI news.">
  <div class="page">
    <p class="crumbs">
      <a href="/">Home</a>
      <span> · AI Weekly</span>
    </p>
    <h1 class="mt-4 text-4xl text-white sm:text-5xl">AI Weekly</h1>
    <p class="lede">A roundup of AI news. Written for people who already follow this field.</p>

    {
      editions.length === 0 ? (
        <p class="mt-10 text-sm" style="color: var(--cb-muted)">No editions yet.</p>
      ) : (
        <ul class="row-list">
          {editions.map((edition) => (
            <li>
              <a href={`/weekly/${edition.slug}/`} class="row-link">
                <div>
                  <p class="row-kicker">Edition {edition.data.edition}</p>
                  <h2 class="row-title">{edition.data.title}</h2>
                  <p class="row-desc">{edition.data.description}</p>
                </div>
                <span class="row-cta">Read →</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map((model) => ({
    params: { slug: model.id },
    props: { model },
  }));
}

const { model } = Astro.props;
const { Content } = await render(model);
const {
  title,
  cost_input_1m,
  cost_output_1m,
  context_window,
  parameters_active,
  mmlu_score,
  cac_filing,
} = model.data;

const usd = (value: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(value);

const formatNumber = (value: number) =>
  new Intl.NumberFormat('en-US').format(value);

const filingStatus = cac_filing.toLowerCase();
const filingStyles =
  filingStatus === 'filed'
    ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300'
    : filingStatus === 'pending'
      ? 'border-amber-500/30 bg-amber-500/10 text-amber-300'
      : 'border-slate-600 bg-slate-800/60 text-slate-300';
---

<BaseLayout title={`${title} | ColinBuilds`} description={`${title} pricing, benchmarks, and regulatory status.`}>
  <article>
    <!-- Hero -->
    <section class="border-b border-slate-800/80 bg-gradient-to-b from-slate-900 to-slate-950">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-cyan-400">
          AI Model Profile
        </p>
        <h1 class="max-w-4xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
          {title}
        </h1>
        <div class="mt-8 inline-flex items-center gap-3 rounded-2xl border border-slate-700/80 bg-slate-900/70 px-5 py-4">
          <span class="text-sm text-slate-400">Context window</span>
          <span class="text-2xl font-semibold text-white">
            {formatNumber(context_window)}
          </span>
          <span class="text-sm text-slate-500">tokens</span>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="grid gap-6 lg:grid-cols-3">
        <!-- Economic calculator / cost block -->
        <section class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 shadow-xl shadow-black/20 lg:col-span-2">
          <div class="mb-6 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-white">API Economics</h2>
            <span class="text-xs uppercase tracking-wider text-slate-500">Per 1M tokens · USD</span>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-5">
              <p class="text-sm text-cyan-300/80">Input cost</p>
              <p class="mt-2 text-3xl font-bold text-white">{usd(cost_input_1m)}</p>
              <p class="mt-2 text-xs text-slate-400">Charged on prompt tokens sent to the model.</p>
            </div>
            <div class="rounded-xl border border-violet-500/20 bg-violet-500/5 p-5">
              <p class="text-sm text-violet-300/80">Output cost</p>
              <p class="mt-2 text-3xl font-bold text-white">{usd(cost_output_1m)}</p>
              <p class="mt-2 text-xs text-slate-400">Charged on completion tokens returned.</p>
            </div>
          </div>
          <div class="mt-5 rounded-xl border border-slate-800 bg-slate-950/70 p-4 text-sm text-slate-400">
            Estimated blended cost for a 50/50 input-output workload:
            <span class="ml-1 font-medium text-slate-200">
              {usd((cost_input_1m + cost_output_1m) / 2)} / 1M tokens
            </span>
          </div>
        </section>

        <!-- Regulatory status -->
        <section class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 shadow-xl shadow-black/20">
          <h2 class="text-lg font-semibold text-white">Regulatory Status</h2>
          <p class="mt-2 text-sm text-slate-400">CAC filing disclosure for compliance tracking.</p>
          <div class={`mt-6 inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium ${filingStyles}`}>
            <span class="mr-2 h-2 w-2 rounded-full bg-current opacity-80"></span>
            {cac_filing}
          </div>
        </section>
      </div>

      <!-- Benchmark matrix -->
      <section class="mt-6 rounded-2xl border border-slate-800 bg-slate-900/50 p-6 shadow-xl shadow-black/20">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <h2 class="text-lg font-semibold text-white">Benchmark Matrix</h2>
            <p class="mt-1 text-sm text-slate-400">Standardized evaluation metrics for model comparison.</p>
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-5">
            <p class="text-xs uppercase tracking-wider text-slate-500">MMLU Score</p>
            <p class="mt-2 text-4xl font-bold text-white">{mmlu_score}%</p>
            <div class="mt-4 h-2 overflow-hidden rounded-full bg-slate-800">
              <div
                class="h-full rounded-full bg-gradient-to-r from-cyan-500 to-blue-500"
                style={`width: ${Math.min(mmlu_score, 100)}%`}
              />
            </div>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-950/70 p-5">
            <p class="text-xs uppercase tracking-wider text-slate-500">Active Parameters</p>
            <p class="mt-2 text-4xl font-bold text-white">{formatNumber(parameters_active)}B</p>
            <p class="mt-2 text-sm text-slate-400">Reported active parameter count at inference time.</p>
          </div>
        </div>
      </section>

      <!-- Markdown content body -->
      <section class="prose prose-invert prose-slate mt-10 max-w-none rounded-2xl border border-slate-800 bg-slate-900/30 p-8">
        <Content />
      </section>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose h2 {
    margin-top: 2rem;
    color: rgb(241 245 249);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .prose p {
    color: rgb(203 213 225);
    line-height: 1.75;
  }

  .prose ul {
    color: rgb(203 213 225);
  }
</style>

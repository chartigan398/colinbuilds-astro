---
// Template v2 — Colin requested less scroll (2026-07-09). Calculator + pricing math unchanged.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Brand from '../../components/Brand.astro';
import ModelRoutingCalculator from '../../components/ModelRoutingCalculator.astro';
import { comparisonsForModel, getLiveComparisonPairs, pickRelated } from '../../lib/compare';
import { getEffectivePricing, getCheapestOfferKeys, getPricingOffers, hasVerifiedPricing, offerKey } from '../../lib/pricing';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const models = (await getCollection('models')).filter(
    (entry) => entry.data.draft === true || hasVerifiedPricing(entry.data),
  );

  return models.map((model) => ({
    params: { slug: model.slug },
    props: { model },
  }));
}

const { model } = Astro.props;
const { Content } = await render(model);
const { allComparisons } = await getLiveComparisonPairs();
const modelComparisons = comparisonsForModel(model.slug, allComparisons);
const relatedComparisons = pickRelated(modelComparisons, model.slug, 6);
const comparisonModels = (await getCollection('models'))
  .filter((entry) => hasVerifiedPricing(entry.data))
  .map((entry) => {
    const pricing = getEffectivePricing(entry.data);
    if (!pricing) return null;
    return {
      title: entry.data.title,
      slug: entry.slug,
      costInput1m: pricing.costInput1m,
      costOutput1m: pricing.costOutput1m,
    };
  })
  .filter((entry): entry is NonNullable<typeof entry> => entry != null);
const {
  title,
  draft,
  entry_type,
  entry_badge,
  context_label,
  benchmark_note,
  parameters_note,
  cost_input_1m,
  cost_output_1m,
  context_window,
  parameters_active,
  mmlu_score,
  mmlu_pro_score,
  chatbot_arena_score,
  chatbot_arena_source_date,
  pricing_source_date,
  pricing_model_version,
  pricing_note,
  cac_status,
  cac_source,
} = model.data;

const pricingOffers = getPricingOffers(model.data);
const cheapestOfferKeys = getCheapestOfferKeys(pricingOffers);
const effectivePricing = getEffectivePricing(model.data);
const showProviderComparison = pricingOffers.length > 1;
const singleOffer = pricingOffers.length === 1 ? pricingOffers[0] : null;

const missing = '—';
const entryBadge = entry_badge ?? (entry_type === 'reference' ? 'Reference entry' : 'AI Model Profile');
const contextLabel = context_label ?? (entry_type === 'reference' ? 'Standard context window' : 'Context window');
const benchmarkFallback = benchmark_note ?? missing;
const parametersFallback = parameters_note ?? missing;

const hasPricing = pricingOffers.length > 0;
const hasOfficialPricing = cost_input_1m != null && cost_output_1m != null;
const hasPricingMeta = pricing_model_version && pricing_source_date;
const hasContext = context_window != null;
const hasBenchmarks =
  mmlu_score != null ||
  mmlu_pro_score != null ||
  parameters_active != null ||
  chatbot_arena_score != null;

const benchmarkCardCount = [
  mmlu_score,
  mmlu_pro_score,
  parameters_active,
  chatbot_arena_score,
].filter((value) => value != null).length;

const benchmarkGridClass =
  benchmarkCardCount >= 4
    ? 'sm:grid-cols-2 lg:grid-cols-4'
    : benchmarkCardCount === 3
      ? 'sm:grid-cols-2 lg:grid-cols-3'
      : 'sm:grid-cols-2';

const cacStatusKey = cac_status.toLowerCase();
const showCac = Boolean(cac_source) || ['filed', 'pending'].includes(cacStatusKey);

const usd = (value: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: value < 1 ? 3 : 2,
  }).format(value);

const pageDescription = effectivePricing
  ? `${title} on ColinBuilds.com — ${usd(effectivePricing.costInput1m)} input and ${usd(effectivePricing.costOutput1m)} output per 1M tokens${pricingOffers.length > 1 ? ` (${effectivePricing.label})` : ''}.`
  : `${title} on ColinBuilds.com.`;

const formatNumber = (value: number) =>
  new Intl.NumberFormat('en-US').format(value);

const formatActiveParameters = (value: number) => {
  if (value >= 1_000_000_000) {
    return `${new Intl.NumberFormat('en-US', {
      maximumFractionDigits: 1,
    }).format(value / 1_000_000_000)}B`;
  }

  return `${formatNumber(value)}B`;
};

const formatPricingDate = (value: string) => {
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return value;

  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(parsed);
};

const cacBadgeStyles =
  cacStatusKey === 'filed'
    ? 'border-cyan-500/40 bg-cyan-500/10 text-cyan-400'
    : cacStatusKey === 'pending'
      ? 'border-neutral-600 bg-neutral-900 text-neutral-300'
      : 'border-blue-500/40 bg-blue-500/10 text-blue-400';

const cacBadgeClass = `inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium ${cacBadgeStyles}`;
---

<BaseLayout title={`${title} | ColinBuilds.com`} description={pageDescription}>
  <article>
    {
      draft === true && (
        <div class="border-b border-amber-500/30 bg-amber-500/10 px-6 py-3 text-center text-sm text-amber-200">
          Local draft preview only — not indexed, not in comparisons, not published.
        </div>
      )
    }
    <section class="border-b border-neutral-800 bg-neutral-950">
      <div class="mx-auto max-w-6xl px-6 py-8">
        <p class="text-sm font-medium tracking-wide">
          <Brand />
          <span class="text-neutral-500"> · {entryBadge}</span>
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h1>
        {
          (hasOfficialPricing || hasContext) && (
            <dl class="mt-5 grid gap-3 sm:grid-cols-3">
              {
                hasOfficialPricing && singleOffer && (
                  <>
                    <div class="rounded-xl border border-cyan-500/25 bg-cyan-500/5 px-4 py-3">
                      <dt class="text-xs uppercase tracking-wide text-cyan-400/80">Input / 1M</dt>
                      <dd class="mt-1 text-xl font-bold tabular-nums text-white">{usd(singleOffer.costInput1m)}</dd>
                    </div>
                    <div class="rounded-xl border border-blue-500/25 bg-blue-500/5 px-4 py-3">
                      <dt class="text-xs uppercase tracking-wide text-blue-400/80">Output / 1M</dt>
                      <dd class="mt-1 text-xl font-bold tabular-nums text-white">{usd(singleOffer.costOutput1m)}</dd>
                    </div>
                  </>
                )
              }
              {
                hasContext && (
                  <div class="rounded-xl border border-neutral-800 bg-black/40 px-4 py-3">
                    <dt class="text-xs uppercase tracking-wide text-neutral-500">{contextLabel}</dt>
                    <dd class="mt-1 text-xl font-bold tabular-nums text-white">
                      {formatNumber(context_window!)}
                      <span class="ml-1 text-sm font-normal text-neutral-500">tokens</span>
                    </dd>
                  </div>
                )
              }
            </dl>
          )
        }
        {
          hasOfficialPricing && hasPricingMeta && (
            <p class="mt-4 text-xs leading-relaxed text-neutral-500">
              {pricing_model_version} · as of {formatPricingDate(pricing_source_date!)}
            </p>
          )
        }
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-6 py-6">
      <div class={`grid gap-6 ${showCac ? 'lg:grid-cols-3' : ''}`}>
        {
          showProviderComparison && (
            <section class={`rounded-2xl border border-neutral-800 bg-neutral-950 p-5 shadow-xl shadow-black/40 ${showCac ? 'lg:col-span-2' : ''}`}>
              <div class="mb-4 flex items-center justify-between gap-4">
                <h2 class="text-base font-semibold text-white">Provider pricing</h2>
                <span class="text-xs uppercase tracking-wider text-neutral-500">USD / 1M tokens</span>
              </div>
              <div class="overflow-x-auto rounded-xl border border-neutral-800">
                <table class="min-w-full text-left text-sm">
                  <thead class="border-b border-neutral-800 bg-black/60 text-xs uppercase tracking-wider text-neutral-500">
                    <tr>
                      <th class="px-4 py-3 font-medium">Provider</th>
                      <th class="px-4 py-3 font-medium">Input / 1M</th>
                      <th class="px-4 py-3 font-medium">Output / 1M</th>
                      <th class="px-4 py-3 font-medium">Source</th>
                    </tr>
                  </thead>
                  <tbody>
                    {
                      pricingOffers.map((offer) => {
                        const isCheapest = cheapestOfferKeys.has(offerKey(offer));
                        return (
                          <tr
                            class={
                              isCheapest
                                ? 'border-t border-emerald-500/30 bg-emerald-500/10 text-white'
                                : 'border-t border-neutral-800 text-neutral-300'
                            }
                          >
                            <td class="px-4 py-3 font-medium">
                              <div class="flex flex-wrap items-center gap-2">
                                <span>{offer.name}</span>
                                {offer.isOfficial && (
                                  <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 text-[10px] uppercase tracking-wide text-cyan-300">
                                    Official
                                  </span>
                                )}
                                {isCheapest && (
                                  <span class="rounded-full border border-emerald-500/40 bg-emerald-500/15 px-2 py-0.5 text-[10px] uppercase tracking-wide text-emerald-300">
                                    Best deal
                                  </span>
                                )}
                              </div>
                            </td>
                            <td class="px-4 py-3 tabular-nums">{usd(offer.costInput1m)}</td>
                            <td class="px-4 py-3 tabular-nums">{usd(offer.costOutput1m)}</td>
                            <td class="px-4 py-3">
                              {
                                offer.source ? (
                                  <a
                                    href={offer.source}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-cyan-400 transition hover:text-cyan-300"
                                  >
                                    Provider docs
                                  </a>
                                ) : offer.sourceDate ? (
                                  <span class="text-neutral-500">As of {formatPricingDate(offer.sourceDate)}</span>
                                ) : (
                                  <span class="text-neutral-500">Verified listing</span>
                                )
                              }
                            </td>
                          </tr>
                        );
                      })
                    }
                  </tbody>
                </table>
              </div>
              <p class="mt-3 text-xs leading-relaxed text-neutral-500">
                Provider prices are verified from third-party docs — not official model-maker pricing unless
                labelled Official.
              </p>
            </section>
          )
        }

        {
          !showProviderComparison && !hasOfficialPricing && (
            <section class="rounded-2xl border border-neutral-800 bg-neutral-950 p-5">
              <p class="text-sm text-cyan-400">Official pricing status</p>
              <p class="mt-2 text-base font-medium text-white">
                {pricing_note ?? 'No current official public API price recorded for this exact page.'}
              </p>
            </section>
          )
        }

        {
          showCac && (
            <section class="rounded-2xl border border-neutral-800 bg-neutral-950 p-6 shadow-xl shadow-black/40">
              <h2 class="text-lg font-semibold text-white">Regulatory Status</h2>
              <p class="mt-2 text-sm text-neutral-400">CAC filing disclosure for compliance tracking.</p>
              {
                cac_source ? (
                  <a
                    href={cac_source}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`${cacBadgeClass} mt-6 transition hover:opacity-80`}
                  >
                    <span class="mr-2 h-2 w-2 rounded-full bg-current opacity-80"></span>
                    {cac_status}
                  </a>
                ) : (
                  <div class={`${cacBadgeClass} mt-6`}>
                    <span class="mr-2 h-2 w-2 rounded-full bg-current opacity-80"></span>
                    {cac_status}
                  </div>
                )
              }
            </section>
          )
        }
      </div>

      {
        hasPricing && (
          <ModelRoutingCalculator
            modelTitle={title}
            modelSlug={model.slug}
            costInput1m={effectivePricing?.costInput1m}
            costOutput1m={effectivePricing?.costOutput1m}
            comparisonModels={comparisonModels}
          />
        )
      }

      {
        hasBenchmarks && (
          <section class="mt-6 rounded-2xl border border-neutral-800 bg-neutral-950 p-6 shadow-xl shadow-black/40">
            <div class="mb-6">
              <h2 class="text-lg font-semibold text-white">Benchmark Matrix</h2>
              <p class="mt-1 text-sm text-neutral-400">Reported model metrics from published sources.</p>
            </div>
            <div class={`grid gap-4 ${benchmarkGridClass}`}>
              {chatbot_arena_score != null && (
                <div class="rounded-xl border border-neutral-800 bg-black p-5">
                  <p class="text-xs uppercase tracking-wider text-neutral-500">Chatbot Arena Elo</p>
                  <p class="mt-2 text-4xl font-bold tabular-nums text-white">
                    {formatNumber(chatbot_arena_score)}
                  </p>
                  <p class="mt-2 text-sm text-neutral-400">Human preference ranking from Chatbot Arena.</p>
                  {
                    chatbot_arena_source_date && (
                      <p class="mt-2 text-xs text-neutral-500">
                        As of {formatPricingDate(chatbot_arena_source_date)}.
                      </p>
                    )
                  }
                </div>
              )}
              {mmlu_score != null && (
                <div class="rounded-xl border border-neutral-800 bg-black p-5">
                  <p class="text-xs uppercase tracking-wider text-neutral-500">MMLU Score</p>
                  <p class="mt-2 text-4xl font-bold text-white">{mmlu_score}%</p>
                  <div class="mt-4 h-2 overflow-hidden rounded-full bg-neutral-800">
                    <div
                      class="h-full rounded-full bg-gradient-to-r from-cyan-400 to-blue-500"
                      style={`width: ${Math.min(mmlu_score, 100)}%`}
                    />
                  </div>
                </div>
              )}
              {mmlu_pro_score != null && (
                <div class="rounded-xl border border-neutral-800 bg-black p-5">
                  <p class="text-xs uppercase tracking-wider text-neutral-500">MMLU-Pro Score</p>
                  <p class="mt-2 text-4xl font-bold text-white">{mmlu_pro_score}%</p>
                  <div class="mt-4 h-2 overflow-hidden rounded-full bg-neutral-800">
                    <div
                      class="h-full rounded-full bg-gradient-to-r from-cyan-400 to-blue-500"
                      style={`width: ${Math.min(mmlu_pro_score, 100)}%`}
                    />
                  </div>
                </div>
              )}
              {parameters_active != null && (
                <div class="rounded-xl border border-neutral-800 bg-black p-5">
                  <p class="text-xs uppercase tracking-wider text-neutral-500">Active Parameters</p>
                  <p class="mt-2 text-4xl font-bold text-white">{formatActiveParameters(parameters_active)}</p>
                  <p class="mt-2 text-sm text-neutral-400">Reported active parameter count at inference time.</p>
                </div>
              )}
            </div>
          </section>
        )
      }

      {
        relatedComparisons.length > 0 && (
          <section class="mt-6 rounded-2xl border border-neutral-800 bg-neutral-950 p-5">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <h2 class="text-base font-semibold text-white">Popular comparisons</h2>
                <p class="mt-1 text-sm text-neutral-500">
                  {modelComparisons.length} total featuring {title}.
                </p>
              </div>
              <a
                href={`/compare/?q=${encodeURIComponent(model.slug)}`}
                class="text-sm text-cyan-400 transition hover:text-cyan-300"
              >
                Open compare hub →
              </a>
            </div>
            <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
              {
                relatedComparisons.map((comparison) => (
                  <li>
                    <a
                      href={comparison.href}
                      class="block rounded-xl border border-neutral-800 bg-black/40 px-3 py-2.5 text-sm text-neutral-300 transition hover:border-cyan-500/40 hover:text-cyan-300"
                    >
                      {comparison.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
        )
      }

      <section class="model-prose prose prose-invert prose-compact mt-6 max-w-none rounded-2xl border border-neutral-800 bg-neutral-950 p-5 sm:p-6">
        <Content />
      </section>
    </div>
  </article>
</BaseLayout>

<script>
  function initProseAccordion(root: HTMLElement) {
    const headings = Array.from(root.querySelectorAll(':scope > h2'));
    if (headings.length === 0) return;

    for (const [index, heading] of headings.entries()) {
      const details = document.createElement('details');
      details.className = 'prose-section border-b border-neutral-800 last:border-b-0';
      if (index === 0) details.open = true;

      const summary = document.createElement('summary');
      summary.className = 'cursor-pointer list-none py-3 text-base font-semibold text-white marker:content-none';
      summary.textContent = heading.textContent ?? 'Section';
      details.appendChild(summary);

      const body = document.createElement('div');
      body.className = 'prose-section-body pb-4';

      let sibling = heading.nextElementSibling;
      while (sibling && sibling.tagName !== 'H2') {
        const next = sibling.nextElementSibling;
        body.appendChild(sibling);
        sibling = next;
      }

      details.appendChild(body);
      heading.replaceWith(details);
    }
  }

  document.querySelectorAll<HTMLElement>('.model-prose').forEach(initProseAccordion);
</script>

<style is:global>
  .prose-compact > p:first-child {
    margin-top: 0;
    margin-bottom: 1rem;
    color: #d4d4d4;
    line-height: 1.6;
  }

  .prose-section summary::-webkit-details-marker {
    display: none;
  }

  .prose-section summary::after {
    content: '+';
    float: right;
    color: #737373;
    font-weight: 400;
  }

  .prose-section[open] summary::after {
    content: '−';
  }

  .prose-section-body h2 {
    display: none;
  }

  .prose-section-body p {
    color: #a3a3a3;
    line-height: 1.65;
    margin-top: 0.75rem;
  }

  .prose-section-body ul {
    color: #a3a3a3;
  }

  .prose-section-body strong {
    color: #22d3ee;
  }

  .prose-section-body a {
    color: #22d3ee;
  }
</style>

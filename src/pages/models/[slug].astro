---
// LOCKED TEMPLATE — Colin approved 2026-06-30. See .cursor/rules/model-template-locked.mdc
import BaseLayout from '../../layouts/BaseLayout.astro';
import Brand from '../../components/Brand.astro';
import ModelRoutingCalculator from '../../components/ModelRoutingCalculator.astro';
import { comparisonsForModel, getLiveComparisonPairs } from '../../lib/compare';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const models = (await getCollection('models')).filter(
    (entry) => entry.data.cost_input_1m != null && entry.data.cost_output_1m != null,
  );

  return models.map((model) => ({
    params: { slug: model.slug },
    props: { model },
  }));
}

const { model } = Astro.props;
const { Content } = await render(model);
const { allComparisons } = await getLiveComparisonPairs();
const modelComparisons = comparisonsForModel(model.slug, allComparisons);
const comparisonModels = (await getCollection('models'))
  .filter((entry) => entry.data.cost_input_1m != null && entry.data.cost_output_1m != null)
  .map((entry) => ({
    title: entry.data.title,
    slug: entry.slug,
    costInput1m: entry.data.cost_input_1m!,
    costOutput1m: entry.data.cost_output_1m!,
  }));
const {
  title,
  entry_type,
  entry_badge,
  context_label,
  benchmark_note,
  parameters_note,
  cost_input_1m,
  cost_output_1m,
  context_window,
  parameters_active,
  mmlu_score,
  mmlu_pro_score,
  pricing_source_date,
  pricing_model_version,
  pricing_note,
  cac_status,
  cac_source,
} = model.data;

const missing = '—';
const entryBadge = entry_badge ?? (entry_type === 'reference' ? 'Reference entry' : 'AI Model Profile');
const contextLabel = context_label ?? (entry_type === 'reference' ? 'Standard context window' : 'Context window');
const benchmarkFallback = benchmark_note ?? missing;
const parametersFallback = parameters_note ?? missing;

const hasPricing = cost_input_1m != null && cost_output_1m != null;
const hasPricingMeta = pricing_model_version && pricing_source_date;
const hasContext = context_window != null;
const hasBenchmarks = mmlu_score != null || mmlu_pro_score != null || parameters_active != null;

const cacStatusKey = cac_status.toLowerCase();
const showCac = Boolean(cac_source) || ['filed', 'pending'].includes(cacStatusKey);

const usd = (value: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: value < 1 ? 3 : 2,
  }).format(value);

const pageDescription = hasPricing
  ? `${title} on ColinBuilds.com — ${usd(cost_input_1m!)} input and ${usd(cost_output_1m!)} output per 1M tokens.`
  : `${title} on ColinBuilds.com.`;

const formatNumber = (value: number) =>
  new Intl.NumberFormat('en-US').format(value);

const formatActiveParameters = (value: number) => {
  if (value >= 1_000_000_000) {
    return `${new Intl.NumberFormat('en-US', {
      maximumFractionDigits: 1,
    }).format(value / 1_000_000_000)}B`;
  }

  return `${formatNumber(value)}B`;
};

const formatPricingDate = (value: string) => {
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return value;

  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(parsed);
};

const cacBadgeStyles =
  cacStatusKey === 'filed'
    ? 'border-cyan-500/40 bg-cyan-500/10 text-cyan-400'
    : cacStatusKey === 'pending'
      ? 'border-neutral-600 bg-neutral-900 text-neutral-300'
      : 'border-blue-500/40 bg-blue-500/10 text-blue-400';

const cacBadgeClass = `inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium ${cacBadgeStyles}`;
---

<BaseLayout title={`${title} | ColinBuilds.com`} description={pageDescription}>
  <article>
    <section class="border-b border-neutral-800 bg-gradient-to-b from-neutral-950 to-black">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <p class="mb-3 text-sm font-medium tracking-wide">
          <Brand />
          <span class="text-neutral-500"> · {entryBadge}</span>
        </p>
        <h1 class="max-w-4xl text-4xl font-bold tracking-tight text-white sm:text-5xl">
          {title}
        </h1>
        {
          hasContext && (
            <div class="mt-8 inline-flex items-center gap-3 rounded-2xl border border-neutral-700 bg-neutral-950 px-5 py-4">
              <span class="text-sm text-neutral-400">{contextLabel}</span>
              <span class="text-2xl font-semibold text-white">{formatNumber(context_window!)}</span>
              <span class="text-sm text-neutral-500">tokens</span>
            </div>
          )
        }
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class={`grid gap-6 ${showCac ? 'lg:grid-cols-3' : ''}`}>
        <section class={`rounded-2xl border border-neutral-800 bg-neutral-950 p-6 shadow-xl shadow-black/40 ${showCac ? 'lg:col-span-2' : ''}`}>
          <div class="mb-6 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-white">API Economics</h2>
            <span class="text-xs uppercase tracking-wider text-neutral-500">Input & output priced separately · USD</span>
          </div>
          {
            hasPricing ? (
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="rounded-xl border border-cyan-500/30 bg-cyan-500/5 p-5">
                  <p class="text-sm text-cyan-400">Input · per 1M tokens</p>
                  <p class="mt-2 text-3xl font-bold text-white">{usd(cost_input_1m!)}</p>
                  <p class="mt-2 text-xs text-neutral-500">What you pay for 1 million prompt tokens.</p>
                </div>
                <div class="rounded-xl border border-blue-500/30 bg-blue-500/5 p-5">
                  <p class="text-sm text-blue-400">Output · per 1M tokens</p>
                  <p class="mt-2 text-3xl font-bold text-white">{usd(cost_output_1m!)}</p>
                  <p class="mt-2 text-xs text-neutral-500">What you pay for 1 million completion tokens.</p>
                </div>
              </div>
            ) : (
              <div class="rounded-xl border border-neutral-800 bg-black p-5">
                <p class="text-sm text-cyan-400">Official pricing status</p>
                <p class="mt-2 text-lg font-medium text-white">
                  {pricing_note ?? 'No current official public API price recorded for this exact page.'}
                </p>
              </div>
            )
          }
          {
            hasPricingMeta ? (
              <p class="mt-4 text-xs leading-relaxed text-neutral-500">
                Pricing applies to model version{' '}
                <span class="font-medium text-neutral-300">{pricing_model_version}</span>
                as of{' '}
                <span class="font-medium text-neutral-300">{formatPricingDate(pricing_source_date!)}</span>.
              </p>
            ) : pricing_note ? (
              <p class="mt-4 text-xs leading-relaxed text-neutral-500">{pricing_note}</p>
            ) : null
          }
        </section>

        {
          showCac && (
            <section class="rounded-2xl border border-neutral-800 bg-neutral-950 p-6 shadow-xl shadow-black/40">
              <h2 class="text-lg font-semibold text-white">Regulatory Status</h2>
              <p class="mt-2 text-sm text-neutral-400">CAC filing disclosure for compliance tracking.</p>
              {
                cac_source ? (
                  <a
                    href={cac_source}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`${cacBadgeClass} mt-6 transition hover:opacity-80`}
                  >
                    <span class="mr-2 h-2 w-2 rounded-full bg-current opacity-80"></span>
                    {cac_status}
                  </a>
                ) : (
                  <div class={`${cacBadgeClass} mt-6`}>
                    <span class="mr-2 h-2 w-2 rounded-full bg-current opacity-80"></span>
                    {cac_status}
                  </div>
                )
              }
            </section>
          )
        }
      </div>

      <ModelRoutingCalculator
        modelTitle={title}
        modelSlug={model.slug}
        costInput1m={cost_input_1m}
        costOutput1m={cost_output_1m}
        comparisonModels={comparisonModels}
      />

      {
        hasBenchmarks && (
          <section class="mt-6 rounded-2xl border border-neutral-800 bg-neutral-950 p-6 shadow-xl shadow-black/40">
            <div class="mb-6">
              <h2 class="text-lg font-semibold text-white">Benchmark Matrix</h2>
              <p class="mt-1 text-sm text-neutral-400">Reported model metrics from published sources.</p>
            </div>
            <div class={`grid gap-4 ${mmlu_pro_score != null ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2'}`}>
              {mmlu_score != null && (
                <div class="rounded-xl border border-neutral-800 bg-black p-5">
                  <p class="text-xs uppercase tracking-wider text-neutral-500">MMLU Score</p>
                  <p class="mt-2 text-4xl font-bold text-white">{mmlu_score}%</p>
                  <div class="mt-4 h-2 overflow-hidden rounded-full bg-neutral-800">
                    <div
                      class="h-full rounded-full bg-gradient-to-r from-cyan-400 to-blue-500"
                      style={`width: ${Math.min(mmlu_score, 100)}%`}
                    />
                  </div>
                </div>
              )}
              {mmlu_pro_score != null && (
                <div class="rounded-xl border border-neutral-800 bg-black p-5">
                  <p class="text-xs uppercase tracking-wider text-neutral-500">MMLU-Pro Score</p>
                  <p class="mt-2 text-4xl font-bold text-white">{mmlu_pro_score}%</p>
                  <div class="mt-4 h-2 overflow-hidden rounded-full bg-neutral-800">
                    <div
                      class="h-full rounded-full bg-gradient-to-r from-cyan-400 to-blue-500"
                      style={`width: ${Math.min(mmlu_pro_score, 100)}%`}
                    />
                  </div>
                </div>
              )}
              {parameters_active != null && (
                <div class="rounded-xl border border-neutral-800 bg-black p-5">
                  <p class="text-xs uppercase tracking-wider text-neutral-500">Active Parameters</p>
                  <p class="mt-2 text-4xl font-bold text-white">{formatActiveParameters(parameters_active)}</p>
                  <p class="mt-2 text-sm text-neutral-400">Reported active parameter count at inference time.</p>
                </div>
              )}
            </div>
          </section>
        )
      }

      {
        modelComparisons.length > 0 && (
          <section class="mt-6 rounded-2xl border border-neutral-800 bg-neutral-950 p-6 shadow-xl shadow-black/40">
            <h2 class="text-lg font-semibold text-white">Compare {title}</h2>
            <p class="mt-1 text-sm text-neutral-400">
              Head-to-head API cost and benchmark pages featuring {title}.
            </p>
            <ul class="mt-4 grid gap-2 sm:grid-cols-2">
              {
                modelComparisons.map((comparison) => (
                  <li>
                    <a
                      href={comparison.href}
                      class="block rounded-xl border border-neutral-800 bg-black/40 px-4 py-3 text-sm text-neutral-300 transition hover:border-cyan-500/40 hover:text-cyan-300"
                    >
                      {comparison.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
        )
      }

      <section class="prose prose-invert mt-10 max-w-none rounded-2xl border border-neutral-800 bg-neutral-950 p-8">
        <Content />
      </section>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose h2 {
    margin-top: 2rem;
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .prose p {
    color: #a3a3a3;
    line-height: 1.75;
  }

  .prose ul {
    color: #a3a3a3;
  }

  .prose strong {
    color: #22d3ee;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompareHubApp from '../../components/compare-hub/CompareHubApp.astro';
import { getLiveComparisonPairs } from '../../lib/compare';
import { buildCompareHubRows } from '../../lib/compareHub';
import { getCollection } from 'astro:content';

const entries = await getCollection('models');
const { allComparisons } = await getLiveComparisonPairs();
const rows = buildCompareHubRows(entries, allComparisons);
---

<BaseLayout
  title="AI Tools | ColinBuilds"
  description="Compare API prices and model pages. A tool on the ColinBuilds learning hub, not the whole site."
>
  <section class="mx-auto max-w-6xl px-6 py-10 pb-24">
    <p class="mb-2 text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · AI Tools</span>
    </p>
    <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Compare models
    </h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      API prices, context, and verified sources. This is a tool. The lessons start on Learn.
    </p>

    <CompareHubApp rows={rows} comparisons={allComparisons} />
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonPairCalculator from '../../components/ComparisonPairCalculator.astro';
import {
  comparisonPath,
  getLiveComparisonPairs,
  pickRelated,
  type ModelEntry,
} from '../../lib/compare';

export async function getStaticPaths() {
  const { paths } = await getLiveComparisonPairs();
  return paths;
}

interface Props {
  modelAEntry: ModelEntry;
  modelBEntry: ModelEntry;
  allComparisons: Array<{ href: string; label: string }>;
}

const { modelAEntry, modelBEntry, allComparisons } = Astro.props;
const { title: titleA, cost_input_1m: inputA, cost_output_1m: outputA, context_window: contextA, mmlu_score: mmluA, chatbot_arena_score: arenaA, cac_filing_number: cacFilingA } =
  modelAEntry.data;
const { title: titleB, cost_input_1m: inputB, cost_output_1m: outputB, context_window: contextB, mmlu_score: mmluB, chatbot_arena_score: arenaB, cac_filing_number: cacFilingB } =
  modelBEntry.data;

const usd = (value: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: value < 1 ? 3 : 2,
  }).format(value);

const formatNumber = (value: number) => new Intl.NumberFormat('en-US').format(value);
const missing = '—';

const pageTitle = `${titleA} vs ${titleB}: API Cost & Benchmark Comparison`;
const pageDescription = `Compare ${titleA} and ${titleB} API pricing, context windows, and benchmarks. Input ${usd(inputA!)} vs ${usd(inputB!)} per 1M tokens.`;

const pairModels = {
  modelA: {
    title: titleA,
    slug: modelAEntry.slug,
    costInput1m: inputA!,
    costOutput1m: outputA!,
  },
  modelB: {
    title: titleB,
    slug: modelBEntry.slug,
    costInput1m: inputB!,
    costOutput1m: outputB!,
  },
};

const currentPath = comparisonPath(modelAEntry.slug, modelBEntry.slug);
const relatedComparisons = pickRelated(
  allComparisons.filter((comparison) => comparison.href !== currentPath),
  currentPath,
  3,
);

const matrixRows = [
  {
    label: 'Input cost / 1M',
    valueA: usd(inputA!),
    valueB: usd(inputB!),
    highlight: inputA !== inputB,
  },
  {
    label: 'Output cost / 1M',
    valueA: usd(outputA!),
    valueB: usd(outputB!),
    highlight: outputA !== outputB,
  },
  {
    label: 'Context window',
    valueA: contextA != null ? `${formatNumber(contextA)} tokens` : missing,
    valueB: contextB != null ? `${formatNumber(contextB)} tokens` : missing,
    highlight: contextA !== contextB,
  },
  ...(arenaA != null || arenaB != null
    ? [
        {
          label: 'Chatbot Arena Elo',
          valueA: arenaA != null ? formatNumber(arenaA) : missing,
          valueB: arenaB != null ? formatNumber(arenaB) : missing,
          highlight: arenaA !== arenaB,
        },
      ]
    : []),
  {
    label: 'MMLU score',
    valueA: mmluA != null ? `${mmluA}%` : missing,
    valueB: mmluB != null ? `${mmluB}%` : missing,
    highlight: mmluA !== mmluB,
  },
  ...(cacFilingA || cacFilingB
    ? [
        {
          label: 'CAC filing number',
          valueA: cacFilingA ?? missing,
          valueB: cacFilingB ?? missing,
          highlight: cacFilingA !== cacFilingB,
        },
      ]
    : []),
];
---

<BaseLayout title={`${pageTitle} | ColinBuilds.com`} description={pageDescription}>
  <article>
    <section class="border-b border-neutral-800 bg-gradient-to-b from-neutral-950 to-black">
      <div class="mx-auto max-w-6xl px-6 py-14">
        <p class="mb-3 text-sm text-neutral-500">
          <a href="/" class="transition hover:text-cyan-400">Directory</a>
          <span> · Model comparison</span>
        </p>
        <h1 class="max-w-4xl text-3xl font-bold tracking-tight text-white sm:text-4xl">
          {titleA}
          <span class="text-neutral-500"> vs </span>
          {titleB}
        </h1>
        <p class="mt-4 max-w-3xl text-neutral-400">
          Side-by-side API economics and benchmarks. Per-1M input and output rates, context window, and verified metrics.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 text-sm">
          <a
            href={`/models/${modelAEntry.slug}/`}
            class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-4 py-2 text-cyan-300 transition hover:border-cyan-400"
          >
            {titleA} profile →
          </a>
          <a
            href={`/models/${modelBEntry.slug}/`}
            class="rounded-full border border-blue-500/30 bg-blue-500/10 px-4 py-2 text-blue-300 transition hover:border-blue-400"
          >
            {titleB} profile →
          </a>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-6 py-12">
      <section class="rounded-2xl border border-neutral-800 bg-neutral-950 p-6 shadow-xl shadow-black/40">
        <h2 class="text-lg font-semibold text-white">Tale of the tape</h2>
        <p class="mt-1 text-sm text-neutral-500">Head-to-head specs pulled from each model profile.</p>

        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[640px] border-collapse text-sm">
            <thead>
              <tr class="border-b border-neutral-800 text-left">
                <th class="pb-3 pr-4 font-medium text-neutral-500">Metric</th>
                <th class="pb-3 pr-4 font-medium text-cyan-400">{titleA}</th>
                <th class="pb-3 font-medium text-blue-400">{titleB}</th>
              </tr>
            </thead>
            <tbody>
              {
                matrixRows.map((row) => (
                  <tr class="border-b border-neutral-800/80">
                    <th scope="row" class="py-4 pr-4 font-normal text-neutral-400">
                      {row.label}
                    </th>
                    <td class={`py-4 pr-4 tabular-nums ${row.highlight ? 'font-semibold text-white' : 'text-neutral-300'}`}>
                      {row.valueA}
                    </td>
                    <td class={`py-4 tabular-nums ${row.highlight ? 'font-semibold text-white' : 'text-neutral-300'}`}>
                      {row.valueB}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <div class="mt-6">
        <ComparisonPairCalculator modelA={pairModels.modelA} modelB={pairModels.modelB} />
      </div>

      {
        relatedComparisons.length > 0 && (
          <section class="mt-6 rounded-2xl border border-neutral-800 bg-neutral-950 p-6">
            <h2 class="text-lg font-semibold text-white">Related comparisons</h2>
            <p class="mt-1 text-sm text-neutral-500">More head-to-head model matchups.</p>
            <ul class="mt-4 grid gap-2 sm:grid-cols-3">
              {
                relatedComparisons.map((comparison) => (
                  <li>
                    <a
                      href={comparison.href}
                      class="block rounded-xl border border-neutral-800 bg-black/40 px-4 py-3 text-sm text-neutral-300 transition hover:border-cyan-500/40 hover:text-cyan-300"
                    >
                      {comparison.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Quiz Show | ColinBuilds"
  description="Four quiz levels. Each one is harder and gives you less time."
>
  <div class="mx-auto max-w-3xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/games/" class="transition hover:text-cyan-400">Games</a>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">Quiz Show</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Four levels. Each one is harder and the clock is shorter. Five points for a correct answer. A wrong answer, or
      running out of time, does not change your score.
    </p>

    <div class="mt-6 flex items-center justify-between gap-3">
      <a
        href="/games/"
        class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
      >
        Back to Games
      </a>
      <button
        type="button"
        id="qs-sound"
        aria-pressed="true"
        class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
      >
        Sound on
      </button>
    </div>

    <div id="quiz-show" class="mt-6">
      <section data-screen="pick" aria-label="Choose a level">
        <h2 class="text-sm font-semibold tracking-widest text-cyan-400">Choose a level</h2>
        <ul class="mt-4 grid grid-cols-1 gap-3">
          <li>
            <button type="button" data-level="easy" class="qs-pick">
              <span class="text-lg font-semibold text-brand-cyan">Easy</span>
              <span class="mt-1 text-sm text-neutral-400">Five questions. Fifteen seconds each.</span>
            </button>
          </li>
          <li>
            <button type="button" data-level="medium" class="qs-pick">
              <span class="text-lg font-semibold text-brand-cyan">Medium</span>
              <span class="mt-1 text-sm text-neutral-400">Harder facts. Twelve seconds each.</span>
            </button>
          </li>
          <li>
            <button type="button" data-level="hard" class="qs-pick">
              <span class="text-lg font-semibold text-brand-cyan">Hard</span>
              <span class="mt-1 text-sm text-neutral-400">Tighter questions. Ten seconds each.</span>
            </button>
          </li>
          <li>
            <button type="button" data-level="expert" class="qs-pick">
              <span class="text-lg font-semibold text-brand-cyan">Expert</span>
              <span class="mt-1 text-sm text-neutral-400">The hard set. Eight seconds each.</span>
            </button>
          </li>
        </ul>
      </section>

      <section data-screen="play" hidden aria-label="Quiz in progress">
        <button
          type="button"
          id="qs-back"
          class="mb-4 inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Levels
        </button>
        <div class="grid grid-cols-3 gap-3 rounded-xl border border-neutral-800 bg-neutral-950 p-4 text-center">
          <div>
            <p id="qs-score" class="text-3xl font-bold tabular-nums text-brand-cyan">0</p>
            <p class="mt-1 text-xs text-neutral-500">Score</p>
          </div>
          <div>
            <p id="qs-time" class="text-3xl font-bold tabular-nums text-brand-cyan">15</p>
            <p class="mt-1 text-xs text-neutral-500">Seconds</p>
          </div>
          <div>
            <p id="qs-progress" class="text-3xl font-bold tabular-nums text-brand-cyan">1 / 5</p>
            <p class="mt-1 text-xs text-neutral-500">Question</p>
          </div>
        </div>

        <div class="mt-6 rounded-xl border border-neutral-800 bg-neutral-950 p-6 sm:p-8">
          <h2 id="qs-question" class="text-2xl font-bold tracking-tight text-brand-cyan sm:text-3xl">Question</h2>
          <p id="qs-feedback" class="mt-3 min-h-6 text-sm text-neutral-500" aria-live="polite"></p>
          <div id="qs-options" class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <button type="button" data-option="0" class="qs-option">A</button>
            <button type="button" data-option="1" class="qs-option">B</button>
            <button type="button" data-option="2" class="qs-option">C</button>
            <button type="button" data-option="3" class="qs-option">D</button>
          </div>
        </div>
      </section>

      <section data-screen="done" hidden aria-label="Results">
        <div class="rounded-xl border border-neutral-800 bg-neutral-950 p-6 text-center sm:p-10">
          <h2 class="text-2xl font-bold tracking-tight text-brand-cyan">Quiz over</h2>
          <div class="mt-8 grid grid-cols-2 gap-3">
            <div class="rounded-lg border border-neutral-800 p-4">
              <p id="qs-final-score" class="text-3xl font-bold tabular-nums text-brand-cyan">0</p>
              <p class="mt-1 text-xs text-neutral-500">Score</p>
            </div>
            <div class="rounded-lg border border-neutral-800 p-4">
              <p id="qs-final-correct" class="text-3xl font-bold tabular-nums text-brand-cyan">0</p>
              <p class="mt-1 text-xs text-neutral-500">Correct</p>
            </div>
          </div>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
            <button
              type="button"
              id="qs-again"
              class="inline-flex items-center justify-center rounded-lg bg-cyan-400 px-4 py-2.5 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              Play again
            </button>
            <a
              href="/games/"
              class="inline-flex items-center justify-center rounded-lg border border-neutral-600 bg-neutral-950 px-4 py-2.5 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              Back to Games
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const SOUND_KEY = 'colinbuilds-quiz-show-sound';
  const LEVELS = {
    easy: {
      label: 'Easy',
      seconds: 15,
      questions: [
        { question: 'What is the capital of France?', options: ['London', 'Berlin', 'Paris', 'Madrid'], answer: 2 },
        { question: 'Which planet is known as the Red Planet?', options: ['Venus', 'Mars', 'Jupiter', 'Saturn'], answer: 1 },
        { question: 'What is 5 × 5?', options: ['10', '20', '25', '55'], answer: 2 },
        { question: 'Which animal is the fastest land animal?', options: ['Lion', 'Cheetah', 'Horse', 'Elephant'], answer: 1 },
        { question: 'What do plants need to make food?', options: ['Sunlight', 'Pizza', 'Music', 'Sleep'], answer: 0 },
      ],
    },
    medium: {
      label: 'Medium',
      seconds: 12,
      questions: [
        { question: 'How many continents are there?', options: ['5', '6', '7', '8'], answer: 2 },
        { question: 'What gas do humans need to breathe?', options: ['Oxygen', 'Helium', 'Nitrogen only', 'Steam'], answer: 0 },
        { question: 'What is 12 × 8?', options: ['86', '96', '108', '128'], answer: 1 },
        { question: 'Which ocean is the largest?', options: ['Atlantic', 'Indian', 'Arctic', 'Pacific'], answer: 3 },
        { question: 'Who wrote Romeo and Juliet?', options: ['Dickens', 'Shakespeare', 'Austen', 'Homer'], answer: 1 },
      ],
    },
    hard: {
      label: 'Hard',
      seconds: 10,
      questions: [
        { question: 'In which year did the Second World War end?', options: ['1918', '1939', '1945', '1963'], answer: 2 },
        { question: 'What is the chemical symbol for gold?', options: ['Au', 'Ag', 'Gd', 'Go'], answer: 0 },
        { question: 'What is the square root of 81?', options: ['8', '9', '10', '18'], answer: 1 },
        { question: 'What is the capital of Japan?', options: ['Kyoto', 'Osaka', 'Tokyo', 'Seoul'], answer: 2 },
        { question: 'How many degrees are in a right angle?', options: ['45', '90', '180', '360'], answer: 1 },
      ],
    },
    expert: {
      label: 'Expert',
      seconds: 8,
      questions: [
        { question: 'What is 17 × 19?', options: ['303', '313', '323', '333'], answer: 2 },
        { question: 'What is the first element on the periodic table?', options: ['Helium', 'Hydrogen', 'Carbon', 'Oxygen'], answer: 1 },
        { question: 'In which year did the first person walk on the Moon?', options: ['1959', '1961', '1969', '1975'], answer: 2 },
        { question: 'What does CPU stand for?', options: ['Central Processing Unit', 'Computer Power Unit', 'Core Program Utility', 'Central Print Unit'], answer: 0 },
        { question: 'What is the boiling point of water at standard pressure?', options: ['90°C', '100°C', '120°C', '212°C only'], answer: 1 },
      ],
    },
  };

  const root = document.getElementById('quiz-show');
  if (!root) {
    throw new Error('Quiz Show root missing');
  }

  const screens = {
    pick: root.querySelector('[data-screen="pick"]'),
    play: root.querySelector('[data-screen="play"]'),
    done: root.querySelector('[data-screen="done"]'),
  };

  const scoreEl = document.getElementById('qs-score');
  const timeEl = document.getElementById('qs-time');
  const progressEl = document.getElementById('qs-progress');
  const questionEl = document.getElementById('qs-question');
  const feedbackEl = document.getElementById('qs-feedback');
  const optionEls = [...root.querySelectorAll('[data-option]')];
  const finalScoreEl = document.getElementById('qs-final-score');
  const finalCorrectEl = document.getElementById('qs-final-correct');
  const againEl = document.getElementById('qs-again');
  const backEl = document.getElementById('qs-back');
  const soundBtn = document.getElementById('qs-sound');

  let soundOn = window.localStorage.getItem(SOUND_KEY) !== 'off';
  /** @type {AudioContext | null} */
  let audioCtx = null;

  /** @type {{ level: string | null, index: number, score: number, correct: number, timeLeft: number, locked: boolean, timer: number | null, nextTimer: number | null }} */
  const state = {
    level: null,
    index: 0,
    score: 0,
    correct: 0,
    timeLeft: 15,
    locked: false,
    timer: null,
    nextTimer: null,
  };

  function currentLevel() {
    return state.level ? LEVELS[state.level] : null;
  }

  function getAudio() {
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    if (!audioCtx) audioCtx = new AC();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  function beep({ freq, dur = 0.09, type = 'sine', vol = 0.07, delay = 0 }) {
    if (!soundOn) return;
    const c = getAudio();
    if (!c) return;
    const t0 = c.currentTime + delay;
    const osc = c.createOscillator();
    const g = c.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, t0);
    g.gain.setValueAtTime(vol, t0);
    g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
    osc.connect(g);
    g.connect(c.destination);
    osc.start(t0);
    osc.stop(t0 + dur + 0.02);
  }

  function playCorrect() {
    beep({ freq: 880, dur: 0.07, vol: 0.06 });
    beep({ freq: 1175, dur: 0.1, vol: 0.06, delay: 0.07 });
  }

  function playWrong() {
    beep({ freq: 180, dur: 0.14, type: 'square', vol: 0.04 });
  }

  function playTick() {
    beep({ freq: 920, dur: 0.04, vol: 0.045 });
  }

  function playWin() {
    beep({ freq: 523, dur: 0.1, vol: 0.06 });
    beep({ freq: 659, dur: 0.1, vol: 0.06, delay: 0.1 });
    beep({ freq: 784, dur: 0.18, vol: 0.07, delay: 0.2 });
  }

  function paintSoundButton() {
    if (!soundBtn) return;
    soundBtn.textContent = soundOn ? 'Sound on' : 'Sound off';
    soundBtn.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
  }

  function show(name) {
    for (const [key, el] of Object.entries(screens)) {
      if (el) el.hidden = key !== name;
    }
  }

  function stopTimers() {
    if (state.timer !== null) {
      window.clearInterval(state.timer);
      state.timer = null;
    }
    if (state.nextTimer !== null) {
      window.clearTimeout(state.nextTimer);
      state.nextTimer = null;
    }
  }

  function current() {
    const level = currentLevel();
    return level ? level.questions[state.index] : null;
  }

  function paintHud() {
    const level = currentLevel();
    if (scoreEl) scoreEl.textContent = String(state.score);
    if (timeEl) {
      timeEl.textContent = String(state.timeLeft);
      timeEl.classList.toggle('qs-pulse', state.timeLeft <= 5 && !state.locked);
    }
    if (progressEl && level) progressEl.textContent = `${state.index + 1} / ${level.questions.length}`;
  }

  function paintQuestion() {
    const q = current();
    if (!q) return;
    if (questionEl) questionEl.textContent = q.question;
    if (feedbackEl) feedbackEl.textContent = '';
    optionEls.forEach((btn, i) => {
      btn.textContent = q.options[i];
      btn.disabled = false;
      btn.dataset.state = 'idle';
      btn.blur();
      btn.classList.remove('qs-in');
      void btn.offsetWidth;
      btn.style.animationDelay = `${i * 55}ms`;
      btn.classList.add('qs-in');
    });
  }

  function reveal(selected) {
    const q = current();
    if (!q) return;
    optionEls.forEach((btn, i) => {
      btn.disabled = true;
      if (i === q.answer) btn.dataset.state = 'right';
      else if (selected === i) btn.dataset.state = 'wrong';
      else btn.dataset.state = 'idle';
    });
  }

  function endGame() {
    stopTimers();
    playWin();
    if (finalScoreEl) finalScoreEl.textContent = String(state.score);
    const level = currentLevel();
    if (finalCorrectEl && level) finalCorrectEl.textContent = `${state.correct} / ${level.questions.length}`;
    show('done');
  }

  function goNext() {
    const level = currentLevel();
    if (level && state.index < level.questions.length - 1) {
      state.index += 1;
      showQuestion();
      return;
    }
    endGame();
  }

  function settle(kind, selected) {
    if (state.locked) return;
    state.locked = true;
    stopTimers();
    if (timeEl) timeEl.classList.remove('qs-pulse');
    reveal(selected);

    if (kind === 'correct') {
      state.score += 5;
      state.correct += 1;
      if (feedbackEl) feedbackEl.textContent = 'Correct.';
      playCorrect();
      paintHud();
    } else if (kind === 'timeout') {
      if (feedbackEl) feedbackEl.textContent = 'Time’s up. The correct answer is highlighted.';
      playWrong();
    } else {
      if (feedbackEl) feedbackEl.textContent = 'Wrong. The correct answer is highlighted.';
      playWrong();
    }

    state.nextTimer = window.setTimeout(goNext, 1400);
  }

  function showQuestion() {
    const level = currentLevel();
    if (!level) return;
    stopTimers();
    state.timeLeft = level.seconds;
    state.locked = false;
    paintQuestion();
    paintHud();

    state.timer = window.setInterval(() => {
      if (state.locked) return;
      state.timeLeft -= 1;
      paintHud();
      if (state.timeLeft <= 5 && state.timeLeft > 0) playTick();
      if (state.timeLeft <= 0) settle('timeout', null);
    }, 1000);
  }

  function startLevel(levelId) {
    if (!LEVELS[levelId]) return;
    stopTimers();
    state.level = levelId;
    state.index = 0;
    state.score = 0;
    state.correct = 0;
    getAudio();
    show('play');
    showQuestion();
  }

  root.querySelectorAll('[data-level]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const levelId = btn.getAttribute('data-level');
      if (levelId) startLevel(levelId);
    });
  });
  againEl?.addEventListener('click', () => {
    stopTimers();
    show('pick');
  });

  backEl?.addEventListener('click', () => {
    stopTimers();
    show('pick');
  });

  optionEls.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (state.locked) return;
      const selected = Number(btn.getAttribute('data-option'));
      const q = current();
      if (!q) return;
      const kind = selected === q.answer ? 'correct' : 'wrong';
      settle(kind, selected);
    });
  });

  soundBtn?.addEventListener('click', () => {
    soundOn = !soundOn;
    window.localStorage.setItem(SOUND_KEY, soundOn ? 'on' : 'off');
    paintSoundButton();
    if (soundOn) beep({ freq: 880, dur: 0.08, vol: 0.05 });
  });

  paintSoundButton();
  window.addEventListener('pagehide', stopTimers);
</script>

<style is:global>
  .qs-pick {
    display: flex;
    width: 100%;
    flex-direction: column;
    border-radius: 0.75rem;
    border: 1px solid #262626;
    background: #0a0a0a;
    padding: 1.25rem;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .qs-pick:hover,
  .qs-pick:focus-visible {
    border-color: #22d3ee;
  }

  .qs-pick:focus-visible {
    outline: 2px solid #22d3ee;
    outline-offset: 2px;
  }

  .qs-option {
    min-height: 3.5rem;
    border-radius: 0.75rem;
    border: 2px solid #404040;
    background: #0a0a0a;
    padding: 0.9rem 1rem;
    text-align: left;
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .qs-option:focus {
    outline: none;
  }

  .qs-option:focus-visible {
    outline: 2px solid #22d3ee;
    outline-offset: 2px;
    border-color: #22d3ee;
  }

  @media (hover: hover) and (pointer: fine) {
    .qs-option:hover:not(:disabled) {
      border-color: #22d3ee;
      outline: 2px solid #22d3ee;
      outline-offset: 2px;
    }
  }

  .qs-option[data-state='right'] {
    border-color: #22d3ee;
    background: #083344;
    color: #22d3ee;
  }

  .qs-option[data-state='wrong'] {
    border-color: #737373;
    color: #a3a3a3;
  }

  .qs-option:disabled {
    cursor: default;
  }

  #qs-time.qs-pulse {
    animation: qs-pulse 0.9s ease-in-out infinite;
  }

  @keyframes qs-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #qs-time.qs-pulse {
      animation: none;
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { games } from '../../data/games.js';

const live = games.filter((game) => game.live);
const skillOrder = ['Memory', 'Maths', 'Spelling', 'Typing', 'Reactions', 'Planning', 'General knowledge'];
const grouped = skillOrder
  .map((skill) => ({
    skill,
    games: live.filter((game) => game.skill === skill),
  }))
  .filter((group) => group.games.length > 0);
---

<BaseLayout
  title="Practice | ColinBuilds"
  description="Practise memory, maths, spelling, typing and reactions. Short games, grouped by skill."
>
  <div class="page">
    <p class="crumbs">
      <a href="/">Home</a>
      <span> · </span>
      <a href="/learn/">Learn</a>
      <span> · Games</span>
    </p>
    <h1 class="mt-4 text-4xl text-white sm:text-5xl">Practice</h1>
    <p class="lede">
      Play after you read. Each game trains one skill.
    </p>

    {
      grouped.length === 0 ? (
        <p class="mt-10 text-sm text-neutral-500">No games yet.</p>
      ) : (
        grouped.map((group) => (
          <section class="skill-block mt-12" aria-labelledby={`skill-${group.skill}`}>
            <h2 id={`skill-${group.skill}`}>{group.skill}</h2>
            <ul class="row-list">
              {group.games.map((game) => (
                <li>
                  <a href={`/games/${game.slug}/`} class="row-link">
                    <div>
                      <h3 class="row-title">{game.title}</h3>
                      <p class="row-desc">{game.description}</p>
                    </div>
                    <span class="row-cta">Play →</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </div>
</BaseLayout>

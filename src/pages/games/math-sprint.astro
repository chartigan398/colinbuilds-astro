---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Math Sprint | ColinBuilds"
  description="Solve as many maths problems as you can in 60 seconds."
>
  <div class="mx-auto max-w-3xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/games/" class="transition hover:text-cyan-400">Games</a>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">Math Sprint</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      60 seconds. Type the answer, then Enter. Five points for a correct answer. A wrong answer does not change your score.
      The last 20 seconds count down.
    </p>

    <div class="mt-6 flex justify-end">
      <button
        type="button"
        id="ms-sound"
        aria-pressed="true"
        class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
      >
        Sound on
      </button>
    </div>

    <div id="math-sprint" class="mt-6">
      <section data-screen="pick" aria-label="Choose difficulty">
        <h2 class="text-sm font-semibold tracking-widest text-cyan-400">Choose a level</h2>
        <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <li>
            <button
              type="button"
              data-difficulty="beginner"
              class="flex h-full w-full flex-col rounded-xl border border-neutral-800 bg-neutral-950 p-5 text-left transition hover:border-cyan-400 focus-visible:border-cyan-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              <span class="text-lg font-semibold text-brand-cyan">Beginner</span>
              <span class="mt-1 text-sm text-neutral-400">Numbers 1–10. Add and subtract.</span>
            </button>
          </li>
          <li>
            <button
              type="button"
              data-difficulty="intermediate"
              class="flex h-full w-full flex-col rounded-xl border border-neutral-800 bg-neutral-950 p-5 text-left transition hover:border-cyan-400 focus-visible:border-cyan-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              <span class="text-lg font-semibold text-brand-cyan">Intermediate</span>
              <span class="mt-1 text-sm text-neutral-400">Numbers 1–25. Add, subtract, multiply.</span>
            </button>
          </li>
          <li>
            <button
              type="button"
              data-difficulty="pro"
              class="flex h-full w-full flex-col rounded-xl border border-neutral-800 bg-neutral-950 p-5 text-left transition hover:border-cyan-400 focus-visible:border-cyan-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              <span class="text-lg font-semibold text-brand-cyan">Pro</span>
              <span class="mt-1 text-sm text-neutral-400">Numbers 1–50. All four operations. Division is exact.</span>
            </button>
          </li>
          <li>
            <button
              type="button"
              data-difficulty="superstar"
              class="flex h-full w-full flex-col rounded-xl border border-neutral-800 bg-neutral-950 p-5 text-left transition hover:border-cyan-400 focus-visible:border-cyan-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              <span class="text-lg font-semibold text-brand-cyan">Superstar</span>
              <span class="mt-1 text-sm text-neutral-400">Numbers 1–100. All four operations. Division is exact.</span>
            </button>
          </li>
        </ul>
      </section>

      <section data-screen="play" hidden aria-label="Math sprint in progress">
        <div
          id="ms-hud"
          class="grid grid-cols-3 gap-3 rounded-xl border border-neutral-800 bg-neutral-950 p-4 text-center"
        >
          <div>
            <p id="ms-time" class="text-3xl font-bold tabular-nums text-brand-cyan">60</p>
            <p class="mt-1 text-xs text-neutral-500">Seconds</p>
          </div>
          <div>
            <p id="ms-score" class="text-3xl font-bold tabular-nums text-brand-cyan">0</p>
            <p class="mt-1 text-xs text-neutral-500">Score</p>
          </div>
          <div>
            <p id="ms-streak" class="text-3xl font-bold tabular-nums text-brand-cyan">0</p>
            <p class="mt-1 text-xs text-neutral-500">Streak</p>
          </div>
        </div>
        <p
          id="ms-hurry"
          class="mt-4 hidden text-center text-xl font-semibold tracking-tight text-brand-cyan"
          aria-live="polite"
        >
        </p>

        <form id="ms-form" class="mt-6 rounded-xl border border-neutral-800 bg-neutral-950 p-6 text-center sm:p-10">
          <p id="ms-question" class="font-mono text-5xl font-bold tracking-tight text-brand-cyan sm:text-7xl">
            0 + 0
          </p>
          <label class="sr-only" for="ms-answer">Answer</label>
          <input
            id="ms-answer"
            name="answer"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            spellcheck="false"
            class="mt-8 w-full rounded-lg border border-neutral-700 bg-black px-4 py-4 text-center font-mono text-3xl text-brand-cyan outline-none transition focus:border-cyan-400"
          />
          <p id="ms-feedback" class="mt-3 min-h-6 text-sm text-neutral-500" aria-live="polite"></p>
          <button
            type="submit"
            class="mt-4 inline-flex w-full items-center justify-center rounded-lg bg-cyan-400 px-4 py-3 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
          >
            Submit
          </button>
        </form>
      </section>

      <section data-screen="done" hidden aria-label="Results">
        <div class="rounded-xl border border-neutral-800 bg-neutral-950 p-6 text-center sm:p-10">
          <h2 class="text-2xl font-bold tracking-tight text-brand-cyan">Time’s up</h2>
          <div class="mt-8 grid grid-cols-3 gap-3">
            <div class="rounded-lg border border-neutral-800 p-4">
              <p id="ms-final-score" class="text-3xl font-bold tabular-nums text-brand-cyan">0</p>
              <p class="mt-1 text-xs text-neutral-500">Score</p>
            </div>
            <div class="rounded-lg border border-neutral-800 p-4">
              <p id="ms-final-solved" class="text-3xl font-bold tabular-nums text-brand-cyan">0</p>
              <p class="mt-1 text-xs text-neutral-500">Solved</p>
            </div>
            <div class="rounded-lg border border-neutral-800 p-4">
              <p id="ms-final-streak" class="text-3xl font-bold tabular-nums text-brand-cyan">0</p>
              <p class="mt-1 text-xs text-neutral-500">Best streak</p>
            </div>
          </div>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
            <button
              type="button"
              id="ms-again"
              class="inline-flex items-center justify-center rounded-lg bg-cyan-400 px-4 py-2.5 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              Play again
            </button>
            <a
              href="/games/"
              class="inline-flex items-center justify-center rounded-lg border border-neutral-600 bg-neutral-950 px-4 py-2.5 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              Back to Games
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const SOUND_KEY = 'colinbuilds-math-sprint-sound';
  const root = document.getElementById('math-sprint');
  if (!root) {
    throw new Error('Math Sprint root missing');
  }

  const screens = {
    pick: root.querySelector('[data-screen="pick"]'),
    play: root.querySelector('[data-screen="play"]'),
    done: root.querySelector('[data-screen="done"]'),
  };

  const timeEl = document.getElementById('ms-time');
  const hudEl = document.getElementById('ms-hud');
  const hurryEl = document.getElementById('ms-hurry');
  const scoreEl = document.getElementById('ms-score');
  const streakEl = document.getElementById('ms-streak');
  const questionEl = document.getElementById('ms-question');
  const answerEl = document.getElementById('ms-answer');
  const feedbackEl = document.getElementById('ms-feedback');
  const formEl = document.getElementById('ms-form');
  const finalScoreEl = document.getElementById('ms-final-score');
  const finalSolvedEl = document.getElementById('ms-final-solved');
  const finalStreakEl = document.getElementById('ms-final-streak');
  const againEl = document.getElementById('ms-again');
  const soundBtn = document.getElementById('ms-sound');

  let soundOn = window.localStorage.getItem(SOUND_KEY) !== 'off';
  /** @type {AudioContext | null} */
  let audioCtx = null;

  /** @type {{ difficulty: string, score: number, streak: number, bestStreak: number, solved: number, timeLeft: number, answer: number, timer: number | null }} */
  const state = {
    difficulty: 'beginner',
    score: 0,
    streak: 0,
    bestStreak: 0,
    solved: 0,
    timeLeft: 60,
    answer: 0,
    timer: null,
  };

  function rand(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function getAudio() {
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    if (!audioCtx) audioCtx = new AC();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  function beep({ freq, dur = 0.09, type = 'sine', vol = 0.07, delay = 0, slide = 0 }) {
    if (!soundOn) return;
    const c = getAudio();
    if (!c) return;
    const t0 = c.currentTime + delay;
    const osc = c.createOscillator();
    const g = c.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, t0);
    if (slide) osc.frequency.linearRampToValueAtTime(freq + slide, t0 + dur);
    g.gain.setValueAtTime(vol, t0);
    g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
    osc.connect(g);
    g.connect(c.destination);
    osc.start(t0);
    osc.stop(t0 + dur + 0.02);
  }

  function playCorrect() {
    beep({ freq: 880, dur: 0.07, vol: 0.06 });
    beep({ freq: 1175, dur: 0.1, vol: 0.06, delay: 0.07 });
  }

  function playWrong() {
    beep({ freq: 180, dur: 0.14, type: 'square', vol: 0.04 });
  }

  function playWarn() {
    beep({ freq: 523, dur: 0.12, vol: 0.08 });
    beep({ freq: 784, dur: 0.16, vol: 0.08, delay: 0.14 });
  }

  function playTick(secondsLeft) {
    const freq = 720 + (20 - secondsLeft) * 55;
    beep({ freq, dur: 0.05, vol: 0.05 });
  }

  function playEnd() {
    beep({ freq: 392, dur: 0.16, vol: 0.07 });
    beep({ freq: 262, dur: 0.28, vol: 0.07, delay: 0.14, slide: -40 });
  }

  function paintSoundButton() {
    if (!soundBtn) return;
    soundBtn.textContent = soundOn ? 'Sound on' : 'Sound off';
    soundBtn.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
  }

  function show(name) {
    for (const [key, el] of Object.entries(screens)) {
      if (el) el.hidden = key !== name;
    }
  }

  function stopTimer() {
    if (state.timer !== null) {
      window.clearInterval(state.timer);
      state.timer = null;
    }
  }

  function makeQuestion() {
    const d = state.difficulty;
    let a;
    let b;
    let op;
    let answer;

    const ops =
      d === 'beginner'
        ? ['+', '-']
        : d === 'intermediate'
          ? ['+', '-', '×']
          : ['+', '-', '×', '÷'];

    op = ops[rand(0, ops.length - 1)];

    if (d === 'beginner') {
      a = rand(1, 10);
      b = rand(1, 10);
    } else if (d === 'intermediate') {
      a = rand(1, 25);
      b = rand(1, 25);
    } else if (d === 'pro') {
      a = rand(1, 50);
      b = rand(1, 20);
    } else {
      a = rand(1, 100);
      b = rand(1, 50);
    }

    if (op === '+') {
      answer = a + b;
    } else if (op === '-') {
      if (a < b) {
        const t = a;
        a = b;
        b = t;
      }
      answer = a - b;
    } else if (op === '×') {
      if (d === 'intermediate') {
        a = rand(2, 12);
        b = rand(2, 12);
      } else if (d === 'pro') {
        a = rand(2, 15);
        b = rand(2, 12);
      } else {
        a = rand(2, 20);
        b = rand(2, 15);
      }
      answer = a * b;
    } else {
      const divisorMax = d === 'pro' ? 12 : 15;
      const quotientMax = d === 'pro' ? 12 : 16;
      b = rand(2, divisorMax);
      answer = rand(2, quotientMax);
      a = b * answer;
    }

    state.answer = answer;
    if (questionEl) {
      questionEl.textContent = `${a} ${op} ${b}`;
      questionEl.classList.remove('ms-pop');
      void questionEl.offsetWidth;
      questionEl.classList.add('ms-pop');
    }
  }

  function paintPlay() {
    const hurry = state.timeLeft <= 20 && state.timeLeft > 0;
    if (timeEl) {
      timeEl.textContent = String(state.timeLeft);
      timeEl.classList.toggle('ms-pulse', hurry);
    }
    if (hudEl) hudEl.classList.toggle('ms-hurry-hud', hurry);
    if (hurryEl) {
      hurryEl.hidden = !hurry;
      hurryEl.classList.toggle('hidden', !hurry);
      if (hurry) {
        hurryEl.textContent =
          state.timeLeft === 1 ? '1 second left' : `${state.timeLeft} seconds left`;
      }
    }
    if (scoreEl) scoreEl.textContent = String(state.score);
    if (streakEl) streakEl.textContent = String(state.streak);
  }

  function endGame() {
    stopTimer();
    if (timeEl) timeEl.classList.remove('ms-pulse');
    if (hudEl) hudEl.classList.remove('ms-hurry-hud');
    if (hurryEl) {
      hurryEl.hidden = true;
      hurryEl.classList.add('hidden');
    }
    if (finalScoreEl) finalScoreEl.textContent = String(state.score);
    if (finalSolvedEl) finalSolvedEl.textContent = String(state.solved);
    if (finalStreakEl) finalStreakEl.textContent = String(state.bestStreak);
    show('done');
  }

  function startGame(difficulty) {
    stopTimer();
    state.difficulty = difficulty;
    state.score = 0;
    state.streak = 0;
    state.bestStreak = 0;
    state.solved = 0;
    state.timeLeft = 60;
    if (feedbackEl) feedbackEl.textContent = '';
    if (answerEl) {
      answerEl.value = '';
      answerEl.classList.remove('border-white');
    }
    makeQuestion();
    paintPlay();
    show('play');
    window.setTimeout(() => answerEl?.focus(), 0);

    state.timer = window.setInterval(() => {
      state.timeLeft -= 1;
      paintPlay();
      if (state.timeLeft === 20) playWarn();
      else if (state.timeLeft < 20 && state.timeLeft > 0) playTick(state.timeLeft);
      if (state.timeLeft <= 0) {
        playEnd();
        endGame();
      }
    }, 1000);
  }

  root.querySelectorAll('[data-difficulty]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const difficulty = btn.getAttribute('data-difficulty');
      if (difficulty) startGame(difficulty);
    });
  });

  formEl?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (state.timeLeft <= 0) return;

    const raw = (answerEl?.value || '').trim();
    const guess = Number.parseInt(raw, 10);
    if (raw === '' || Number.isNaN(guess)) {
      if (feedbackEl) feedbackEl.textContent = 'Type a number.';
      return;
    }

    if (guess === state.answer) {
      state.score += 5;
      state.streak += 1;
      if (state.streak > state.bestStreak) state.bestStreak = state.streak;
      state.solved += 1;
      if (feedbackEl) feedbackEl.textContent = '';
      if (answerEl) {
        answerEl.value = '';
        answerEl.classList.remove('border-white');
        answerEl.focus();
      }
      makeQuestion();
      paintPlay();
      playCorrect();
    } else {
      state.streak = 0;
      if (feedbackEl) feedbackEl.textContent = 'Wrong. Try again.';
      playWrong();
      if (answerEl) {
        answerEl.value = '';
        answerEl.classList.add('border-white');
        answerEl.focus();
      }
      paintPlay();
    }
  });

  againEl?.addEventListener('click', () => {
    stopTimer();
    show('pick');
  });

  soundBtn?.addEventListener('click', () => {
    soundOn = !soundOn;
    window.localStorage.setItem(SOUND_KEY, soundOn ? 'on' : 'off');
    paintSoundButton();
    if (soundOn) beep({ freq: 880, dur: 0.08, vol: 0.05 });
  });

  paintSoundButton();
  window.addEventListener('pagehide', stopTimer);
</script>

<style>
  #ms-question {
    color: #22d3ee;
  }

  #ms-hud.ms-hurry-hud {
    border-color: #22d3ee;
  }

  #ms-time.ms-pulse {
    animation: ms-pulse 0.9s ease-in-out infinite;
  }

  @keyframes ms-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.18);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ms-time.ms-pulse {
      animation: none;
    }
  }
</style>

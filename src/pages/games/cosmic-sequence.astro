---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Cosmic Sequence | ColinBuilds"
  description="Watch the pattern, then repeat it. Four speeds. Five points each."
>
  <div class="mx-auto max-w-3xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/games/" class="transition hover:text-cyan-400">Games</a>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">Cosmic Sequence</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Watch the pads light up, then tap the same order. Each full pattern is five points. A miss does not change
      your score. Q E A D or tap.
    </p>

    <div class="mt-6 flex items-center justify-between gap-3">
      <a
        href="/games/"
        class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
      >
        Back to Games
      </a>
      <button
        type="button"
        id="cs-sound"
        aria-pressed="true"
        class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
      >
        Sound on
      </button>
    </div>

    <div id="cosmic-sequence" class="mt-6">
      <section data-screen="pick" aria-label="Choose a level">
        <h2 class="text-sm font-semibold tracking-widest text-cyan-400">Choose a level</h2>
        <ul class="mt-4 grid grid-cols-1 gap-3">
          <li>
            <button type="button" data-level="easy" class="cs-pick">
              <span class="text-lg font-semibold text-brand-cyan">Easy</span>
              <span class="mt-1 text-sm text-neutral-400">Slow flashes. Time to think.</span>
            </button>
          </li>
          <li>
            <button type="button" data-level="medium" class="cs-pick">
              <span class="text-lg font-semibold text-brand-cyan">Medium</span>
              <span class="mt-1 text-sm text-neutral-400">Faster pattern.</span>
            </button>
          </li>
          <li>
            <button type="button" data-level="hard" class="cs-pick">
              <span class="text-lg font-semibold text-brand-cyan">Hard</span>
              <span class="mt-1 text-sm text-neutral-400">Short flashes.</span>
            </button>
          </li>
          <li>
            <button type="button" data-level="expert" class="cs-pick">
              <span class="text-lg font-semibold text-brand-cyan">Expert</span>
              <span class="mt-1 text-sm text-neutral-400">Very fast. Do not blink.</span>
            </button>
          </li>
        </ul>
      </section>

      <section data-screen="play" hidden aria-label="Cosmic Sequence in progress">
        <button
          type="button"
          id="cs-back"
          class="mb-4 inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Levels
        </button>
        <div class="grid grid-cols-3 gap-3 rounded-xl border border-neutral-800 bg-neutral-950 p-4 text-center">
          <div>
            <p id="cs-score" class="text-3xl font-bold tabular-nums text-brand-cyan">0</p>
            <p class="mt-1 text-xs text-neutral-500">Score</p>
          </div>
          <div>
            <p id="cs-round" class="text-3xl font-bold tabular-nums text-brand-cyan">1</p>
            <p class="mt-1 text-xs text-neutral-500">Round</p>
          </div>
          <div>
            <p id="cs-status" class="text-xl font-bold text-brand-cyan sm:text-2xl">Watch</p>
            <p class="mt-1 text-xs text-neutral-500">Turn</p>
          </div>
        </div>

        <div class="cs-board mt-6" role="group" aria-label="Sequence pads">
          <button type="button" class="cs-pad" data-pad="0" data-lit="false" aria-label="Circle">
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <circle cx="32" cy="32" r="18" fill="none" stroke="currentColor" stroke-width="3"></circle>
            </svg>
          </button>
          <button type="button" class="cs-pad" data-pad="1" data-lit="false" aria-label="Square">
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <rect x="16" y="16" width="32" height="32" rx="2" fill="none" stroke="currentColor" stroke-width="3"></rect>
            </svg>
          </button>
          <button type="button" class="cs-pad" data-pad="2" data-lit="false" aria-label="Triangle">
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <polygon
                points="32,14 50,50 14,50"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linejoin="round"></polygon>
            </svg>
          </button>
          <button type="button" class="cs-pad" data-pad="3" data-lit="false" aria-label="Diamond">
            <svg viewBox="0 0 64 64" aria-hidden="true">
              <polygon
                points="32,12 52,32 32,52 12,32"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linejoin="round"></polygon>
            </svg>
          </button>
        </div>

        <p id="cs-feedback" class="mt-4 min-h-6 text-center text-sm text-neutral-500" aria-live="polite"></p>
        <div id="cs-end" class="mt-4 hidden flex-col gap-3 sm:flex-row sm:justify-center">
          <button
            type="button"
            id="cs-next"
            class="inline-flex items-center justify-center rounded-lg bg-cyan-400 px-4 py-2.5 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
          >
            Next round
          </button>
          <button
            type="button"
            id="cs-change"
            class="inline-flex items-center justify-center rounded-lg border border-neutral-600 bg-neutral-950 px-4 py-2.5 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
          >
            Change level
          </button>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const SOUND_KEY = 'colinbuilds-cosmic-sequence-sound';
  const PADS = 4;
  const KEYS = {
    q: 0,
    e: 1,
    a: 2,
    d: 3,
    '1': 0,
    '2': 1,
    '3': 2,
    '4': 3,
  };
  const TONES = [261.63, 329.63, 392.0, 493.88];
  const LEVELS = {
    easy: { flash: 700, gap: 280 },
    medium: { flash: 500, gap: 180 },
    hard: { flash: 340, gap: 120 },
    expert: { flash: 200, gap: 70 },
  };

  const root = document.getElementById('cosmic-sequence');
  if (!root) {
    throw new Error('Cosmic Sequence root missing');
  }

  const screens = {
    pick: root.querySelector('[data-screen="pick"]'),
    play: root.querySelector('[data-screen="play"]'),
  };
  const pads = [...root.querySelectorAll('.cs-pad')];
  const scoreEl = document.getElementById('cs-score');
  const roundEl = document.getElementById('cs-round');
  const statusEl = document.getElementById('cs-status');
  const feedbackEl = document.getElementById('cs-feedback');
  const endEl = document.getElementById('cs-end');
  const nextEl = document.getElementById('cs-next');
  const changeEl = document.getElementById('cs-change');
  const backEl = document.getElementById('cs-back');
  const soundBtn = document.getElementById('cs-sound');

  let soundOn = window.localStorage.getItem(SOUND_KEY) !== 'off';
  /** @type {AudioContext | null} */
  let audioCtx = null;
  let playGen = 0;
  /** @type {number | null} */
  let flashTimer = null;
  /** @type {number | null} */
  let gapTimer = null;
  /** @type {number | null} */
  let nextTimer = null;
  /** @type {number | null} */
  let tapTimer = null;

  const state = {
    level: 'easy',
    score: 0,
    sequence: /** @type {number[]} */ ([]),
    input: /** @type {number[]} */ ([]),
    phase: 'idle',
  };

  function randPad() {
    return Math.floor(Math.random() * PADS);
  }

  function getAudio() {
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    if (!audioCtx) audioCtx = new AC();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  function beep({ freq, dur = 0.12, type = 'sine', vol = 0.07, delay = 0 }) {
    if (!soundOn) return;
    const c = getAudio();
    if (!c) return;
    const t0 = c.currentTime + delay;
    const osc = c.createOscillator();
    const g = c.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, t0);
    g.gain.setValueAtTime(vol, t0);
    g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
    osc.connect(g);
    g.connect(c.destination);
    osc.start(t0);
    osc.stop(t0 + dur + 0.02);
  }

  function playTone(pad) {
    beep({ freq: TONES[pad], dur: 0.16, vol: 0.08 });
  }

  function playMiss() {
    beep({ freq: 160, dur: 0.18, type: 'square', vol: 0.04 });
  }

  function playWin() {
    beep({ freq: 523, dur: 0.08, vol: 0.06 });
    beep({ freq: 659, dur: 0.1, vol: 0.06, delay: 0.08 });
  }

  function paintSoundButton() {
    if (!soundBtn) return;
    soundBtn.textContent = soundOn ? 'Sound on' : 'Sound off';
    soundBtn.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
  }

  function show(name) {
    for (const [key, el] of Object.entries(screens)) {
      if (el) el.hidden = key !== name;
    }
  }

  function lightPad(index, on) {
    const pad = pads[index];
    if (pad) pad.dataset.lit = on ? 'true' : 'false';
  }

  function unlightAll() {
    pads.forEach((pad) => {
      pad.dataset.lit = 'false';
      pad.blur();
    });
  }

  function clearTimers() {
    if (flashTimer !== null) {
      window.clearTimeout(flashTimer);
      flashTimer = null;
    }
    if (gapTimer !== null) {
      window.clearTimeout(gapTimer);
      gapTimer = null;
    }
    if (nextTimer !== null) {
      window.clearTimeout(nextTimer);
      nextTimer = null;
    }
    if (tapTimer !== null) {
      window.clearTimeout(tapTimer);
      tapTimer = null;
    }
  }

  function stopPlay() {
    playGen += 1;
    clearTimers();
    unlightAll();
  }

  function paintHud() {
    if (scoreEl) scoreEl.textContent = String(state.score);
    if (roundEl) roundEl.textContent = String(Math.max(state.sequence.length, 1));
    if (!statusEl) return;
    if (state.phase === 'watch') statusEl.textContent = 'Watch';
    else if (state.phase === 'play') statusEl.textContent = 'Your turn';
    else if (state.phase === 'miss') statusEl.textContent = 'Miss';
    else statusEl.textContent = 'Ready';
  }

  function setEndVisible(on) {
    if (!endEl) return;
    endEl.classList.toggle('hidden', !on);
    endEl.classList.toggle('flex', on);
  }

  function wait(ms) {
    return new Promise((resolve) => {
      gapTimer = window.setTimeout(() => {
        gapTimer = null;
        resolve();
      }, ms);
    });
  }

  function flashPad(index, ms) {
    return new Promise((resolve) => {
      unlightAll();
      lightPad(index, true);
      playTone(index);
      flashTimer = window.setTimeout(() => {
        flashTimer = null;
        lightPad(index, false);
        resolve();
      }, ms);
    });
  }

  async function playSequence() {
    const gen = ++playGen;
    clearTimers();
    unlightAll();
    state.phase = 'watch';
    state.input = [];
    setEndVisible(false);
    if (feedbackEl) feedbackEl.textContent = 'Watch the pattern.';
    paintHud();

    const timing = LEVELS[state.level] || LEVELS.easy;
    await wait(420);
    if (gen !== playGen) return;

    for (let i = 0; i < state.sequence.length; i += 1) {
      if (gen !== playGen) return;
      await flashPad(state.sequence[i], timing.flash);
      if (gen !== playGen) return;
      await wait(timing.gap);
    }

    if (gen !== playGen) return;
    unlightAll();
    state.phase = 'play';
    if (feedbackEl) feedbackEl.textContent = 'Your turn. Repeat it.';
    paintHud();
  }

  function startRound(keepScore) {
    stopPlay();
    if (!keepScore) state.score = 0;
    state.sequence = [randPad()];
    state.input = [];
    state.phase = 'watch';
    if (feedbackEl) feedbackEl.textContent = '';
    setEndVisible(false);
    paintHud();
    show('play');
    playSequence();
  }

  function miss() {
    stopPlay();
    state.phase = 'miss';
    playMiss();
    if (feedbackEl) feedbackEl.textContent = 'Wrong. Score stays.';
    setEndVisible(true);
    paintHud();
  }

  function onPad(index) {
    if (state.phase !== 'play') return;
    const expected = state.sequence[state.input.length];
    state.input.push(index);
    unlightAll();
    lightPad(index, true);
    playTone(index);
    if (tapTimer !== null) window.clearTimeout(tapTimer);
    tapTimer = window.setTimeout(() => {
      tapTimer = null;
      lightPad(index, false);
      pads[index]?.blur();
    }, 140);

    if (index !== expected) {
      miss();
      return;
    }

    if (state.input.length !== state.sequence.length) return;

    state.score += 5;
    state.phase = 'wait';
    playWin();
    paintHud();
    if (feedbackEl) feedbackEl.textContent = 'Correct. Next pattern.';
    nextTimer = window.setTimeout(() => {
      nextTimer = null;
      unlightAll();
      state.sequence.push(randPad());
      playSequence();
    }, 700);
  }

  function goPick() {
    stopPlay();
    state.phase = 'idle';
    setEndVisible(false);
    if (feedbackEl) feedbackEl.textContent = '';
    show('pick');
  }

  root.querySelectorAll('[data-level]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const level = btn.getAttribute('data-level');
      if (!level || !LEVELS[level]) return;
      state.level = level;
      startRound(false);
    });
  });

  pads.forEach((pad) => {
    pad.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      pad.blur();
      const index = Number(pad.getAttribute('data-pad'));
      if (Number.isInteger(index)) onPad(index);
    });
  });

  window.addEventListener('keydown', (event) => {
    if (event.repeat || screens.play?.hidden) return;
    const index = KEYS[event.key.toLowerCase()];
    if (index === undefined) return;
    event.preventDefault();
    onPad(index);
  });

  nextEl?.addEventListener('click', () => {
    startRound(true);
  });

  changeEl?.addEventListener('click', goPick);
  backEl?.addEventListener('click', goPick);

  soundBtn?.addEventListener('click', () => {
    soundOn = !soundOn;
    window.localStorage.setItem(SOUND_KEY, soundOn ? 'on' : 'off');
    paintSoundButton();
    if (soundOn) beep({ freq: 880, dur: 0.08, vol: 0.05 });
  });

  paintSoundButton();
  window.addEventListener('pagehide', stopPlay);
</script>

<style is:global>
  .cs-pick {
    display: flex;
    width: 100%;
    flex-direction: column;
    border-radius: 0.75rem;
    border: 1px solid #262626;
    background: #0a0a0a;
    padding: 1.25rem;
    text-align: left;
    cursor: pointer;
  }

  .cs-pick:hover,
  .cs-pick:focus-visible {
    border-color: #22d3ee;
  }

  .cs-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    max-width: 22rem;
    margin-inline: auto;
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid #262626;
    background: #0a0a0a;
  }

  .cs-pad {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    border: 1px solid #404040;
    background: #050505;
    color: #22d3ee;
    cursor: pointer;
  }

  .cs-pad svg {
    width: 58%;
    height: 58%;
    fill: none;
  }

  .cs-pad svg * {
    fill: none;
  }

  .cs-pad:hover:not([data-lit='true']),
  .cs-pad:focus:not([data-lit='true']),
  .cs-pad:focus-visible:not([data-lit='true']) {
    border-color: #404040;
    color: #22d3ee;
    background: #050505;
    box-shadow: none;
  }

  .cs-pad:focus,
  .cs-pad:focus-visible {
    outline: none;
  }

  .cs-pad[data-lit='true'] {
    background: #083344;
    border-color: #22d3ee;
    color: #a5f3fc;
    box-shadow: 0 0 28px rgb(34 211 238 / 0.35);
  }

  .cs-pad[data-lit='false'] {
    background: #050505;
    box-shadow: none;
  }
</style>

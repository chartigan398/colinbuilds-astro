---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhiloCard from '../../../components/PhiloCard.astro';
import { experiments } from '../../../data/experiments.js';
---

<BaseLayout
  title="Thought Experiments | ColinBuilds"
  description="Face classic ethical dilemmas where there are no easy answers."
>
  <div class="page">
    <p class="crumbs">
      <a href="/">Home</a>
      <span> · </span>
      <a href="/learn/">Learn</a>
      <span> · </span>
      <a href="/philosophia/">Philosophy</a>
      <span> · Thought experiments</span>
    </p>
    <h1 class="mt-4 text-4xl text-white sm:text-5xl">Thought experiments</h1>
    <p class="lede">A hard choice. Pick a side. See what it meant.</p>
    <ul class="row-list">
      {
        experiments.map((item) => (
          <li>
            <PhiloCard
              href={`/philosophia/thought-experiments/${item.id}/`}
              title={item.title}
              description={item.tagline}
            />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhiloCard from '../../../components/PhiloCard.astro';
import { experiments } from '../../../data/experiments.js';
---

<BaseLayout
  title="Thought Experiments | ColinBuilds"
  description="Face classic ethical dilemmas where there are no easy answers."
>
  <div class="mx-auto max-w-6xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/philosophia/" class="transition hover:text-cyan-400">Philosophia</a>
      <span> · Thought Experiments</span>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">Thought Experiments</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Face classic ethical dilemmas where there are no easy answers.
    </p>
    <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        experiments.map((item) => (
          <li>
            <PhiloCard
              href={`/philosophia/thought-experiments/${item.id}/`}
              title={item.title}
              description={item.tagline}
            />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

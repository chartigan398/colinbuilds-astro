---
import '../../../styles/philosophia.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { experiments, getExperiment } from '../../../data/experiments.js';

export function getStaticPaths() {
  return experiments.map((item) => ({ params: { slug: item.id } }));
}

const { slug } = Astro.params;
const experiment = getExperiment(slug);

if (!experiment) {
  throw new Error(`Unknown thought experiment: ${slug}`);
}
---

<BaseLayout title={`${experiment.title} | ColinBuilds`} description={experiment.tagline}>
  <div class="mx-auto max-w-3xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/philosophia/" class="transition hover:text-cyan-400">Philosophia</a>
      <span> · </span>
      <a href="/philosophia/thought-experiments/" class="transition hover:text-cyan-400">Thought Experiments</a>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">{experiment.title}</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">{experiment.tagline}</p>

    <div class="school-board" id="experiment-board">
      <p class="school-step" id="experiment-text">{experiment.description}</p>
      <div class="philo-choices mt-6" id="experiment-choices">
        {
          experiment.choices.map((choice, index) => (
            <button type="button" class="philo-choice" data-index={index}>
              {choice.text}
            </button>
          ))
        }
      </div>
      <div id="experiment-outcome" hidden>
        <p class="school-pos">Outcome</p>
        <p class="school-step mt-4" id="experiment-outcome-text"></p>
      </div>
      <div class="school-actions">
        <a
          href="/philosophia/thought-experiments/"
          class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Back
        </a>
        <button
          type="button"
          id="experiment-again"
          hidden
          class="inline-flex items-center rounded-lg border border-cyan-400 bg-cyan-400 px-4 py-2 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Try again
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ choices: experiment.choices }}>
  const choiceBox = document.getElementById('experiment-choices');
  const outcomeBox = document.getElementById('experiment-outcome');
  const outcomeText = document.getElementById('experiment-outcome-text');
  const again = document.getElementById('experiment-again');
  const buttons = choiceBox ? [...choiceBox.querySelectorAll('[data-index]')] : [];

  function reset() {
    if (!choiceBox || !outcomeBox || !again) return;
    choiceBox.hidden = false;
    outcomeBox.hidden = true;
    again.hidden = true;
    buttons.forEach((button) => {
      button.disabled = false;
      button.classList.remove('is-picked');
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const index = Number(button.getAttribute('data-index'));
      const choice = choices[index];
      if (!choice || !choiceBox || !outcomeBox || !outcomeText || !again) return;
      button.classList.add('is-picked');
      buttons.forEach((item) => {
        item.disabled = true;
      });
      choiceBox.hidden = true;
      outcomeText.textContent = choice.outcome;
      outcomeBox.hidden = false;
      again.hidden = false;
    });
  });

  again?.addEventListener('click', reset);
</script>

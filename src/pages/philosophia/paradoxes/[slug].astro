---
import '../../../styles/philosophia.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { paradoxes, getParadox } from '../../../data/paradoxes.js';

export function getStaticPaths() {
  return paradoxes.map((item) => ({ params: { slug: item.id } }));
}

const { slug } = Astro.params;
const paradox = getParadox(slug);

if (!paradox) {
  throw new Error(`Unknown paradox: ${slug}`);
}
---

<BaseLayout title={`${paradox.title} | ColinBuilds`} description={paradox.tagline}>
  <div class="mx-auto max-w-3xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/philosophia/" class="transition hover:text-cyan-400">Philosophia</a>
      <span> · </span>
      <a href="/philosophia/paradoxes/" class="transition hover:text-cyan-400">Paradoxes</a>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">{paradox.title}</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">{paradox.tagline}</p>

    <div class="school-board">
      <p class="school-step">{paradox.description}</p>
      <div class="philo-choices mt-6" id="paradox-choices">
        {
          paradox.choices.map((choice, index) => (
            <button type="button" class="philo-choice" data-index={index}>
              {choice.text}
            </button>
          ))
        }
      </div>
      <div id="paradox-resolution" hidden>
        <p class="school-pos mt-6">What philosophers say</p>
        <p class="school-step mt-4">{paradox.resolution}</p>
      </div>
      <div class="school-actions">
        <a
          href="/philosophia/paradoxes/"
          class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Back
        </a>
        <button
          type="button"
          id="paradox-again"
          hidden
          class="inline-flex items-center rounded-lg border border-cyan-400 bg-cyan-400 px-4 py-2 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Try again
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const choiceBox = document.getElementById('paradox-choices');
  const resolution = document.getElementById('paradox-resolution');
  const again = document.getElementById('paradox-again');
  const buttons = choiceBox ? [...choiceBox.querySelectorAll('[data-index]')] : [];

  function reset() {
    if (!resolution || !again) return;
    resolution.hidden = true;
    again.hidden = true;
    buttons.forEach((button) => {
      button.disabled = false;
      button.classList.remove('is-picked');
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!resolution || !again) return;
      buttons.forEach((item) => {
        item.disabled = true;
        item.classList.toggle('is-picked', item === button);
      });
      resolution.hidden = false;
      again.hidden = false;
    });
  });

  again?.addEventListener('click', reset);
</script>

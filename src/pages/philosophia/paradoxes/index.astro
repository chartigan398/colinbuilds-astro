---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhiloCard from '../../../components/PhiloCard.astro';
import { paradoxes } from '../../../data/paradoxes.js';
---

<BaseLayout
  title="Paradoxes | ColinBuilds"
  description="Untangle mind-bending puzzles that have stumped philosophers for centuries."
>
  <div class="page">
    <p class="crumbs">
      <a href="/">Home</a>
      <span> · </span>
      <a href="/learn/">Learn</a>
      <span> · </span>
      <a href="/philosophia/">Philosophy</a>
      <span> · Paradoxes</span>
    </p>
    <h1 class="mt-4 text-4xl text-white sm:text-5xl">Paradoxes</h1>
    <p class="lede">Untangle puzzles that have stumped philosophers for centuries.</p>
    <ul class="row-list">
      {
        paradoxes.map((item) => (
          <li>
            <PhiloCard href={`/philosophia/paradoxes/${item.id}/`} title={item.title} description={item.tagline} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

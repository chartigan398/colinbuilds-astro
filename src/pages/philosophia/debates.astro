---
import '../../styles/philosophia.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { debateLibrary } from '../../data/coming.js';
---

<BaseLayout
  title="Philosopher Debates | ColinBuilds"
  description="Stage a showdown between two great thinkers. Coming soon."
>
  <div class="mx-auto max-w-6xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/philosophia/" class="transition hover:text-cyan-400">Philosophia</a>
      <span> · Debates</span>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">Philosopher Debates</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Stage a showdown between two great thinkers on a topic of your choice.
    </p>

    <div class="philo-soon">
      <p class="text-sm text-neutral-400">Coming soon: live debates. The matchups are ready. The voices are not.</p>
    </div>

    {
      debateLibrary.map((group) => (
        <section class="mt-12">
          <h2 class="border-b border-neutral-800 pb-2 text-sm font-semibold tracking-widest text-cyan-400">
            {group.category}
          </h2>
          <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {group.debates.map((debate) => (
              <li class="rounded-xl border border-neutral-800 bg-neutral-950/80 p-5">
                <h3 class="text-lg font-semibold tracking-tight text-white">{debate.title}</h3>
                <p class="mt-2 text-sm text-neutral-400">{debate.prompt}</p>
                <p class="mt-4 text-sm text-neutral-500">Coming soon</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhiloCard from '../../components/PhiloCard.astro';

const playable = [
  {
    href: '/philosophia/schools/',
    title: 'Schools of Thought',
    description: 'Short lessons on ways of thinking. Start with Stoicism, Plato, or Empiricism.',
  },
  {
    href: '/philosophia/thought-experiments/',
    title: 'Thought experiments',
    description: 'A hard choice. Pick a side. See what it meant.',
  },
  {
    href: '/philosophia/paradoxes/',
    title: 'Paradoxes',
    description: 'Untangle puzzles that have stumped philosophers for centuries.',
  },
  {
    href: '/philosophia/dialogues/',
    title: 'Socratic dialogues',
    description: 'Guided, branching conversations.',
  },
  {
    href: '/philosophia/paths/',
    title: 'Learning paths',
    description: 'A set order. Epistemology, ethics, political philosophy.',
  },
  {
    href: '/philosophia/quiz/',
    title: 'Quiz',
    description: 'Four questions. Pick an answer, then see how you did.',
  },
  {
    href: '/philosophia/match/',
    title: 'Match',
    description: 'Pair each philosopher with the idea they are known for.',
  },
];
---

<BaseLayout
  title="Philosophy | ColinBuilds"
  description="Short beginner lessons on ways of thinking. Start with a school of thought."
>
  <div class="page">
    <p class="crumbs">
      <a href="/">Home</a>
      <span> · </span>
      <a href="/learn/">Learn</a>
      <span> · Philosophy</span>
    </p>
    <h1 class="mt-4 text-4xl text-white sm:text-5xl">Philosophy</h1>
    <p class="lede">Start with a school of thought. Then try a puzzle, a dialogue, or a path.</p>

    <ul class="row-list">
      {
        playable.map((item) => (
          <li>
            <PhiloCard href={item.href} title={item.title} description={item.description} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

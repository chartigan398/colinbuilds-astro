---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { schoolCategories } from '../../../data/schools.js';
---

<BaseLayout
  title="Schools of Thought | ColinBuilds"
  description="Explore the major philosophical movements in short, conversational lessons."
>
  <div class="mx-auto max-w-6xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/philosophia/" class="transition hover:text-cyan-400">Philosophia</a>
      <span> · Schools</span>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">Schools of Thought</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Explore the major philosophical movements in short, conversational lessons.
    </p>

    {
      schoolCategories.map((category) => (
        <section class="mt-12">
          <h2 class="border-b border-neutral-800 pb-2 text-sm font-semibold tracking-widest text-cyan-400">
            {category.name}
          </h2>
          <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {category.schools.map((school) => (
              <li>
                <a
                  href={`/philosophia/schools/${school.id}/`}
                  class="group game-listing-card flex h-full flex-col rounded-xl border border-neutral-800 bg-neutral-950/80 p-5 transition hover:border-cyan-400 focus-visible:border-cyan-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
                >
                  <h3 class="text-lg font-semibold tracking-tight text-white">{school.name}</h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-400">{school.summary}</p>
                  <p class="mt-3 text-xs text-neutral-500">
                    {school.region} · {school.era}
                  </p>
                  <span class="mt-5 text-sm text-cyan-400 group-hover:text-cyan-300">Begin →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { schoolCategories } from '../../../data/schools.js';

const startHere = [
  {
    href: '/philosophia/schools/stoicism/',
    title: 'Stoicism',
    description: 'Stay steady. You do not control what happens. You do control how you answer.',
  },
  {
    href: '/philosophia/schools/platonism/',
    title: 'Platonism',
    description: 'The real world is a shadow of perfect ideas, like a perfect circle.',
  },
  {
    href: '/philosophia/schools/empiricism/',
    title: 'Empiricism',
    description: 'Knowledge comes from what we see, hear and test.',
  },
];
---

<BaseLayout
  title="Schools of Thought | ColinBuilds"
  description="Short beginner lessons on ways of thinking. Start with Stoicism, Plato, or Empiricism."
>
  <div class="page">
    <p class="crumbs">
      <a href="/">Home</a>
      <span> · </span>
      <a href="/learn/">Learn</a>
      <span> · </span>
      <a href="/philosophia/">Philosophy</a>
      <span> · Schools</span>
    </p>
    <h1 class="mt-4 text-4xl text-white sm:text-5xl">Schools of Thought</h1>
    <p class="lede">Each school is a short read. Start with one of these three.</p>

    <section class="mt-12" aria-labelledby="start-schools">
      <h2 id="start-schools" class="kicker">Start here</h2>
      <ul class="row-list">
        {
          startHere.map((school) => (
            <li>
              <a href={school.href} class="row-link">
                <div>
                  <h3 class="row-title">{school.title}</h3>
                  <p class="row-desc">{school.description}</p>
                </div>
                <span class="row-cta">Begin →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      schoolCategories.map((category) => (
        <section class="skill-block mt-14">
          <h2>{category.name}</h2>
          <ul class="row-list">
            {category.schools.map((school) => (
              <li>
                <a href={`/philosophia/schools/${school.id}/`} class="row-link">
                  <div>
                    <p class="row-kicker">
                      {school.region} · {school.era}
                    </p>
                    <h3 class="row-title">{school.name}</h3>
                    <p class="row-desc">{school.summary}</p>
                  </div>
                  <span class="row-cta">Begin →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

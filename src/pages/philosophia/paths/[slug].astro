---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { paths, getPath, moduleHref } from '../../../data/paths.js';

export function getStaticPaths() {
  return paths.map((item) => ({ params: { slug: item.id } }));
}

const { slug } = Astro.params;
const path = getPath(slug);

if (!path) {
  throw new Error(`Unknown path: ${slug}`);
}

function typeLabel(type) {
  if (type === 'lesson') return 'Lesson';
  if (type === 'thought-experiment') return 'Thought experiment';
  if (type === 'socratic-dialogue') return 'Dialogue';
  if (type === 'paradox') return 'Paradox';
  if (type === 'quiz') return 'Quiz';
  return type;
}
---

<BaseLayout title={`${path.title} | ColinBuilds`} description={path.tagline}>
  <div class="page">
    <p class="crumbs">
      <a href="/">Home</a>
      <span> · </span>
      <a href="/learn/">Learn</a>
      <span> · </span>
      <a href="/philosophia/">Philosophy</a>
      <span> · </span>
      <a href="/philosophia/paths/">Paths</a>
    </p>
    <h1 class="mt-4 text-4xl text-white sm:text-5xl">{path.title}</h1>
    <p class="lede">{path.description}</p>

    <ol class="row-list">
      {
        path.modules.map((module, index) => (
          <li>
            <a href={moduleHref(path.id, module)} class="row-link">
              <div>
                <p class="row-kicker">
                  {index + 1} · {typeLabel(module.type)} · {module.estimatedTime}
                </p>
                <h2 class="row-title">{module.title}</h2>
              </div>
              <span class="row-cta">Begin →</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

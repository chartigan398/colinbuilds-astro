---
import '../../../../styles/philosophia.css';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { playablePathModules, getPathModule } from '../../../../data/paths.js';

export function getStaticPaths() {
  return playablePathModules().map(({ pathId, moduleId }) => ({
    params: { slug: pathId, module: moduleId },
  }));
}

const { slug, module: moduleId } = Astro.params;
const found = getPathModule(slug, moduleId);

if (!found) {
  throw new Error(`Unknown path module: ${slug}/${moduleId}`);
}

const { path, module } = found;
const isQuiz = module.type === 'quiz';
---

<BaseLayout title={`${module.title} | ColinBuilds`} description={path.tagline}>
  <div class="mx-auto max-w-3xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/philosophia/" class="transition hover:text-cyan-400">Philosophia</a>
      <span> · </span>
      <a href="/philosophia/paths/" class="transition hover:text-cyan-400">Paths</a>
      <span> · </span>
      <a href={`/philosophia/paths/${path.id}/`} class="transition hover:text-cyan-400">{path.title}</a>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">{module.title}</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">{path.title}</p>

    {
      isQuiz ? (
        <div class="school-board" id="quiz-board">
          <p class="school-pos" id="quiz-pos"></p>
          <p class="school-step mt-4" id="quiz-question"></p>
          <div class="philo-choices mt-6" id="quiz-choices"></div>
          <p class="mt-4 text-sm text-neutral-400" id="quiz-feedback" hidden></p>
          <div class="school-actions">
            <a
              href={`/philosophia/paths/${path.id}/`}
              class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              Back to path
            </a>
            <button
              type="button"
              id="quiz-next"
              hidden
              class="inline-flex items-center rounded-lg border border-cyan-400 bg-cyan-400 px-4 py-2 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              Next
            </button>
          </div>
        </div>
      ) : (
        <div class="school-board" id="school-lesson">
          <p class="school-pos" id="school-pos"></p>
          <p class="school-step mt-4" id="school-step"></p>
          <div class="school-progress" aria-hidden="true">
            <span id="school-bar"></span>
          </div>
          <div class="school-actions">
            <a
              href={`/philosophia/paths/${path.id}/`}
              class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              Back to path
            </a>
            <button
              type="button"
              id="school-next"
              class="inline-flex items-center rounded-lg border border-cyan-400 bg-cyan-400 px-4 py-2 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
            >
              Continue
            </button>
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>

{
  isQuiz ? (
    <script define:vars={{ questions: module.questions, backHref: `/philosophia/paths/${path.id}/` }}>
      const posEl = document.getElementById('quiz-pos');
      const questionEl = document.getElementById('quiz-question');
      const choicesEl = document.getElementById('quiz-choices');
      const feedbackEl = document.getElementById('quiz-feedback');
      const nextEl = document.getElementById('quiz-next');
      let index = 0;
      let score = 0;
      let locked = false;

      function renderQuestion() {
        const item = questions[index];
        if (!item || !posEl || !questionEl || !choicesEl || !feedbackEl || !nextEl) return;
        locked = false;
        posEl.textContent = `${index + 1} / ${questions.length}`;
        questionEl.textContent = item.question;
        feedbackEl.hidden = true;
        nextEl.hidden = true;
        choicesEl.replaceChildren();
        item.options.forEach((option) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'philo-choice';
          button.textContent = option;
          button.addEventListener('click', () => pick(option, item.correctAnswer, button));
          choicesEl.appendChild(button);
        });
      }

      function pick(option, correct, button) {
        if (locked || !feedbackEl || !nextEl || !choicesEl) return;
        locked = true;
        const right = option === correct;
        if (right) score += 1;
        [...choicesEl.querySelectorAll('.philo-choice')].forEach((item) => {
          item.disabled = true;
          if (item.textContent === correct) item.classList.add('is-right');
          if (item === button && !right) item.classList.add('is-wrong');
        });
        feedbackEl.textContent = right ? 'Correct.' : `The answer is ${correct}.`;
        feedbackEl.hidden = false;
        nextEl.hidden = false;
        nextEl.textContent = index === questions.length - 1 ? 'See score' : 'Next';
      }

      function showScore() {
        if (!posEl || !questionEl || !choicesEl || !feedbackEl || !nextEl) return;
        posEl.textContent = 'Done';
        questionEl.textContent = `You scored ${score} out of ${questions.length}.`;
        choicesEl.replaceChildren();
        feedbackEl.hidden = true;
        nextEl.textContent = 'Back to path';
        nextEl.hidden = false;
        nextEl.onclick = () => {
          window.location.href = backHref;
        };
      }

      nextEl?.addEventListener('click', () => {
        if (index < questions.length - 1) {
          index += 1;
          renderQuestion();
          return;
        }
        showScore();
      });

      renderQuestion();
    </script>
  ) : (
    <script define:vars={{ steps: module.lesson, backHref: `/philosophia/paths/${path.id}/` }}>
      const textEl = document.getElementById('school-step');
      const posEl = document.getElementById('school-pos');
      const barEl = document.getElementById('school-bar');
      const nextEl = document.getElementById('school-next');
      let index = 0;

      function render() {
        if (!textEl || !posEl || !barEl || !nextEl) return;
        textEl.textContent = steps[index];
        posEl.textContent = `${index + 1} / ${steps.length}`;
        barEl.style.width = `${((index + 1) / steps.length) * 100}%`;
        nextEl.textContent = index === steps.length - 1 ? 'Finish' : 'Continue';
      }

      nextEl?.addEventListener('click', () => {
        if (index < steps.length - 1) {
          index += 1;
          render();
          return;
        }
        window.location.href = backHref;
      });

      render();
    </script>
  )
}

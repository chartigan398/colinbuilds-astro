---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhiloCard from '../../../components/PhiloCard.astro';
import { paths } from '../../../data/paths.js';
---

<BaseLayout
  title="Learning Paths | ColinBuilds"
  description="Follow structured courses to build your philosophical knowledge from the ground up."
>
  <div class="page">
    <p class="crumbs">
      <a href="/">Home</a>
      <span> · </span>
      <a href="/learn/">Learn</a>
      <span> · </span>
      <a href="/philosophia/">Philosophy</a>
      <span> · Paths</span>
    </p>
    <h1 class="mt-4 text-4xl text-white sm:text-5xl">Learning paths</h1>
    <p class="lede">A set order. Build from the ground up.</p>
    <ul class="row-list">
      {
        paths.map((item) => (
          <li>
            <PhiloCard href={`/philosophia/paths/${item.id}/`} title={item.title} description={item.tagline} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

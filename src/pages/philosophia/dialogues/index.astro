---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhiloCard from '../../../components/PhiloCard.astro';
import { dialogues } from '../../../data/dialogues.js';
---

<BaseLayout
  title="Socratic Dialogues | ColinBuilds"
  description="Explore philosophical ideas through guided, branching conversations."
>
  <div class="page">
    <p class="crumbs">
      <a href="/">Home</a>
      <span> · </span>
      <a href="/learn/">Learn</a>
      <span> · </span>
      <a href="/philosophia/">Philosophy</a>
      <span> · Dialogues</span>
    </p>
    <h1 class="mt-4 text-4xl text-white sm:text-5xl">Socratic dialogues</h1>
    <p class="lede">Explore ideas through guided, branching conversations.</p>
    <ul class="row-list">
      {
        dialogues.map((item) => (
          <li>
            <PhiloCard href={`/philosophia/dialogues/${item.id}/`} title={item.title} description={item.tagline} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

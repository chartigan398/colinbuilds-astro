---
import '../../../styles/philosophia.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { dialogues, getDialogue } from '../../../data/dialogues.js';

export function getStaticPaths() {
  return dialogues.map((item) => ({ params: { slug: item.id } }));
}

const { slug } = Astro.params;
const dialogue = getDialogue(slug);

if (!dialogue) {
  throw new Error(`Unknown dialogue: ${slug}`);
}
---

<BaseLayout title={`${dialogue.title} | ColinBuilds`} description={dialogue.tagline}>
  <div class="mx-auto max-w-3xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/philosophia/" class="transition hover:text-cyan-400">Philosophia</a>
      <span> · </span>
      <a href="/philosophia/dialogues/" class="transition hover:text-cyan-400">Dialogues</a>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">{dialogue.title}</h1>
    <p class="mt-2 text-sm text-neutral-500">{dialogue.philosopher}</p>
    <p class="mt-3 max-w-2xl text-neutral-400">{dialogue.tagline}</p>

    <div class="school-board">
      <div class="philo-log" id="dialogue-log"></div>
      <div class="philo-choices mt-6" id="dialogue-choices"></div>
      <div class="school-actions">
        <a
          href="/philosophia/dialogues/"
          class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Back
        </a>
        <button
          type="button"
          id="dialogue-again"
          hidden
          class="inline-flex items-center rounded-lg border border-cyan-400 bg-cyan-400 px-4 py-2 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Start over
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ nodes: dialogue.nodes }}>
  const logEl = document.getElementById('dialogue-log');
  const choicesEl = document.getElementById('dialogue-choices');
  const again = document.getElementById('dialogue-again');

  function nodeById(id) {
    return nodes.find((item) => item.id === id);
  }

  function addLine(kind, text) {
    if (!logEl) return;
    const p = document.createElement('p');
    p.className = kind === 'you' ? 'philo-log-you' : 'philo-log-ai';
    p.textContent = text;
    logEl.appendChild(p);
    p.scrollIntoView({ block: 'nearest' });
  }

  function showNode(node, append = true) {
    if (!node || !choicesEl || !again) return;
    if (append) addLine('ai', node.text.replace(/\*/g, ''));
    choicesEl.replaceChildren();
    const choices = node.choices || [];
    if (choices.length === 0) {
      again.hidden = false;
      return;
    }
    again.hidden = true;
    choices.forEach((choice) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'philo-choice';
      button.textContent = choice.text;
      button.addEventListener('click', () => {
        addLine('you', choice.text);
        showNode(nodeById(choice.nextNodeId));
      });
      choicesEl.appendChild(button);
    });
  }

  function start() {
    if (logEl) logEl.replaceChildren();
    showNode(nodeById('start'));
  }

  again?.addEventListener('click', start);
  start();
</script>

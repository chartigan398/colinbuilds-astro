---
import '../../styles/philosophia.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { matchPhilosophers, matchIdeas } from '../../data/match.js';
---

<BaseLayout
  title="Match | ColinBuilds"
  description="Pair each philosopher with the idea they are known for."
>
  <div class="mx-auto max-w-4xl px-6 py-12 pb-20">
    <p class="text-sm text-neutral-500">
      <a href="/" class="transition hover:text-cyan-400">Home</a>
      <span> · </span>
      <a href="/philosophia/" class="transition hover:text-cyan-400">Philosophia</a>
      <span> · Match</span>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-cyan sm:text-4xl">Match</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Click a philosopher, then click the idea that belongs with them.
    </p>

    <div class="school-board mt-8">
      <p class="school-pos" id="match-status">Pick a philosopher</p>
      <div class="match-board mt-6">
        <div>
          <h2 class="mb-3 text-sm font-semibold tracking-widest text-cyan-400">Philosophers</h2>
          <div class="match-col" id="match-philosophers"></div>
        </div>
        <div>
          <h2 class="mb-3 text-sm font-semibold tracking-widest text-cyan-400">Ideas</h2>
          <div class="match-col" id="match-ideas"></div>
        </div>
      </div>
      <div id="match-pairs" class="mt-6 grid gap-2"></div>
      <div class="school-actions">
        <a
          href="/philosophia/"
          class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-3 py-2 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Back
        </a>
        <button
          type="button"
          id="match-again"
          hidden
          class="inline-flex items-center rounded-lg border border-cyan-400 bg-cyan-400 px-4 py-2 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Play again
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ philosophers: matchPhilosophers, ideas: matchIdeas }}>
  const statusEl = document.getElementById('match-status');
  const leftEl = document.getElementById('match-philosophers');
  const rightEl = document.getElementById('match-ideas');
  const pairsEl = document.getElementById('match-pairs');
  const again = document.getElementById('match-again');

  function shuffle(list) {
    const next = [...list];
    for (let i = next.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      [next[i], next[j]] = [next[j], next[i]];
    }
    return next;
  }

  let left = [];
  let usedIdeas = new Set();
  let picked = null;
  let pairs = [];

  function render() {
    if (!leftEl || !rightEl || !statusEl || !pairsEl || !again) return;
    leftEl.replaceChildren();
    rightEl.replaceChildren();
    pairsEl.replaceChildren();

    left.forEach((item) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'match-chip';
      if (picked === item.id) button.classList.add('is-picked');
      button.textContent = item.text;
      button.addEventListener('click', () => {
        picked = item.id;
        statusEl.textContent = 'Now pick the idea';
        render();
      });
      leftEl.appendChild(button);
    });

    ideas.forEach((item) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'match-chip';
      if (usedIdeas.has(item.id)) {
        button.classList.add('is-used');
        button.disabled = true;
      }
      button.textContent = item.text;
      button.addEventListener('click', () => pair(item.id));
      rightEl.appendChild(button);
    });

    pairs.forEach((pair) => {
      const p = document.createElement('p');
      p.className = 'match-pair';
      p.textContent = pair.correct
        ? `${pair.philosopher} → ${pair.idea}`
        : `${pair.philosopher} → ${pair.idea} (not a match)`;
      if (pair.correct) p.style.borderColor = 'var(--cb-accent)';
      pairsEl.appendChild(p);
    });

    if (pairs.length === philosophers.length) {
      const score = pairs.filter((item) => item.correct).length;
      statusEl.textContent = `You matched ${score} of ${philosophers.length}.`;
      again.hidden = false;
    } else {
      again.hidden = true;
      if (!picked) statusEl.textContent = 'Pick a philosopher';
    }
  }

  function pair(ideaId) {
    if (!picked || usedIdeas.has(ideaId)) return;
    const philosopher = philosophers.find((item) => item.id === picked);
    const idea = ideas.find((item) => item.id === ideaId);
    if (!philosopher || !idea) return;
    pairs.push({
      philosopher: philosopher.text,
      idea: idea.text,
      correct: philosopher.matchId === idea.id,
    });
    usedIdeas.add(ideaId);
    left = left.filter((item) => item.id !== picked);
    picked = null;
    render();
  }

  function start() {
    left = shuffle(philosophers);
    usedIdeas = new Set();
    picked = null;
    pairs = [];
    render();
  }

  again?.addEventListener('click', start);
  start();
</script>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Nebula X | ColinBuilds"
  description="Nebula X is a free music visualizer. It runs in your browser on your computer. Open it here, or download a copy."
  hideFooter={true}
>
  <div class="flex min-h-0 flex-1 flex-col">
    <section class="shrink-0 border-b border-neutral-800 px-6 py-5">
      <p class="text-sm text-neutral-500">
        <a href="/" class="transition hover:text-cyan-400">Home</a>
        <span> · Builds · Nebula X</span>
      </p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-white sm:text-3xl">Nebula X</h1>
      <p class="mt-2 max-w-2xl text-sm text-neutral-400">
        A free music visualizer. It runs on <strong class="font-medium text-neutral-200">your</strong> computer,
        in <strong class="font-medium text-neutral-200">your</strong> browser — your songs, your microphone, your screen.
        This site only sends you the app. Nothing plays through anyone else’s machine.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="/builds/nebula-x/play/"
          class="inline-flex items-center rounded-lg bg-cyan-400 px-4 py-2.5 text-sm font-medium text-black transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Open in your browser
        </a>
        <a
          href="/builds/nebula-x/download/"
          class="inline-flex items-center rounded-lg border border-neutral-600 bg-neutral-950 px-4 py-2.5 text-sm font-medium text-white transition hover:border-cyan-400 hover:text-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400"
        >
          Download a copy
        </a>
      </div>
      <p class="mt-3 max-w-2xl text-xs text-neutral-500">
        Browser: click File to pick a song on your computer, or Mic to allow your microphone. Press ? for help.
        Download: unzip, then run the start file, and use it even when you are not on this site.
      </p>
    </section>
    <iframe
      id="visualizer"
      src="/nebula-x/index.html"
      title="Nebula X"
      class="min-h-0 w-full flex-1 border-0 bg-black"
      allow="microphone; autoplay; fullscreen; clipboard-write"
    ></iframe>
  </div>
</BaseLayout>

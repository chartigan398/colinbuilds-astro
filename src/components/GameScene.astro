    }

    {
      (scene === 'hub' || scene === 'runner' || scene === 'asteroids' || scene === 'snake' || scene === 'connect' || scene === 'hangman' || scene === 'sprint' || scene === 'match' || scene === 'quiz' || scene === 'type' || scene === 'scramble') && (
        <>
          <g class="game-scene-ring game-scene-ring-slow" opacity="0.55">
            <circle cx="400" cy="210" r="150" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
            <circle cx="400" cy="210" r="150" fill="none" stroke="currentColor" stroke-width="1.25" stroke-dasharray="4 18"></circle>
          </g>
          <g class="game-scene-ring" opacity="0.42">
            <circle cx="400" cy="210" r="220" fill="none" stroke="currentColor" stroke-width="1.25" stroke-dasharray="2 14"></circle>
          </g>
        </>
      )
    }

    {
      scene === 'runner' && (
        <g fill="none" stroke="currentColor" stroke-opacity="0.22" stroke-width="2" stroke-linejoin="round">
          <rect x="220" y="200" width="48" height="48"></rect>
          <path d="M360 248 400 168 440 248Z"></path>
          <path d="M500 248 540 188 580 248Z"></path>
          <path d="M160 260h480"></path>
        </g>
      )
    }
    {
      scene === 'connect' && (
        <g fill="none" stroke="currentColor" stroke-opacity="0.22" stroke-width="2">
          <circle cx="220" cy="240" r="28"></circle>
          <circle cx="300" cy="240" r="28"></circle>
          <circle cx="380" cy="240" r="28"></circle>
          <circle cx="460" cy="240" r="28"></circle>
          <circle cx="540" cy="240" r="28"></circle>
          <circle cx="300" cy="160" r="28"></circle>
          <circle cx="380" cy="160" r="28"></circle>
          <circle cx="460" cy="160" r="28"></circle>
          <circle cx="380" cy="80" r="28"></circle>
        </g>
      )
    }
    {
      scene === 'hangman' && (
        <g fill="none" stroke="currentColor" stroke-opacity="0.22" stroke-width="2" stroke-linecap="round">
          <path d="M250 360h220M300 360V90h180v40"></path>
          <circle cx="480" cy="160" r="28"></circle>
          <path d="M480 188v70M455 210h50M460 290l20-32 20 32"></path>
        </g>
      )
    }
    {
      scene === 'sprint' && (
        <g fill="none" stroke="currentColor" stroke-opacity="0.2" stroke-width="18">
          <path d="M250 210h300M400 60v300"></path>
        </g>
      )
    }
    {
      scene === 'match' && (
        <g fill="none" stroke="currentColor" stroke-opacity="0.18" stroke-width="2">
          <rect x="250" y="90" width="140" height="190" rx="12"></rect>
          <rect x="410" y="120" width="140" height="190" rx="12"></rect>
        </g>
      )
    }
    {
      scene === 'quiz' && (
        <g fill="none" stroke="currentColor" stroke-opacity="0.2" stroke-width="2">
          <path d="M400 70 560 230 400 390 240 230Z"></path>
        </g>
      )
    }
    {
      scene === 'type' && (
        <g stroke="currentColor" stroke-opacity="0.2" stroke-width="3" stroke-linecap="round">
          <path d="M180 160h440M180 230h320M180 300h380"></path>
        </g>
      )
    }
    {
      scene === 'scramble' && (
        <g fill="none" stroke="currentColor" stroke-opacity="0.2" stroke-width="2">
          <rect x="250" y="110" width="90" height="90" rx="10"></rect>
          <rect x="360" y="110" width="90" height="90" rx="10"></rect>
          <rect x="470" y="110" width="90" height="90" rx="10"></rect>
          <rect x="305" y="220" width="90" height="90" rx="10"></rect>
          <rect x="415" y="220" width="90" height="90" rx="10"></rect>
        </g>
      )
    }

    {
      scene !== 'home' && scene !== 'guides' && scene !== 'builds' && (
        <g stroke="url(#game-floor)" stroke-width="1">
          <path class="game-scene-grid-line" d="M0 360 L400 240 L800 360" fill="none"></path>
          <path class="game-scene-grid-line" d="M80 480 L400 240 L720 480" fill="none"></path>
          <path class="game-scene-grid-line" d="M160 480 L400 260 L640 480" fill="none"></path>
          <path class="game-scene-grid-line" d="M40 400 H760" fill="none"></path>
          <path class="game-scene-grid-line" d="M70 430 H730" fill="none"></path>
          <path class="game-scene-grid-line" d="M110 460 H690" fill="none"></path>
        </g>
      )
    }
  </svg>
</div>

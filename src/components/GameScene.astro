---
import '../styles/games.css';

const path = Astro.url.pathname;

const scene = path.includes('geometry-runner')
  ? 'runner'
  : path.includes('asteroids')
    ? 'asteroids'
  : path.includes('snake')
    ? 'snake'
  : path.includes('connect-4')
    ? 'connect'
  : path.includes('hangman')
    ? 'hangman'
  : path.includes('math-sprint')
    ? 'sprint'
  : path.includes('memory-match')
    ? 'match'
    : path.includes('quiz-show')
      ? 'quiz'
      : path.includes('typing-speed')
        ? 'type'
        : path.includes('word-scramble')
          ? 'scramble'
          : path.startsWith('/games')
            ? 'hub'
            : path.startsWith('/guides')
              ? 'guides'
              : path.startsWith('/builds')
                ? 'builds'
                : path === '/'
                  ? 'home'
                  : 'home';
---

<div class="game-scene" data-scene={scene} aria-hidden="true">
  <div class="game-scene-glow"></div>
  {scene === 'home' && <div class="home-nebula"></div>}
  <svg class="game-scene-svg" viewBox="0 0 800 480" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="game-floor" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="currentColor" stop-opacity="0.18"></stop>
        <stop offset="100%" stop-color="currentColor" stop-opacity="0"></stop>

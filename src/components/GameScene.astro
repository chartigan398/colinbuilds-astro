              <circle cx="501.3" cy="106" r="1.8" fill-opacity="0.34"></circle>
              <circle cx="557.9" cy="136.4" r="1.2" fill-opacity="0.36"></circle>
              <circle cx="591.5" cy="181.1" r="1.2" fill-opacity="0.44"></circle>
              <circle cx="592.1" cy="212.5" r="1.8" fill-opacity="0.5"></circle>

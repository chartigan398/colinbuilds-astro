              <circle cx="441.6" cy="307.1" r="1.2" fill-opacity="0.32"></circle>
              <circle cx="360.3" cy="320.8" r="1.5" fill-opacity="0.4"></circle>
            </g>
            <circle cx="400" cy="168" r="6" fill="currentColor" fill-opacity="0.62"></circle>
            <circle cx="400" cy="168" r="16" fill="currentColor" fill-opacity="0.14"></circle>
            <circle cx="400" cy="168" r="28" fill="currentColor" fill-opacity="0.05"></circle>
          </g>
        </>
      )
    }

    {
      scene === 'guides' && (
        <g class="game-scene-pages" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="220" y="90" width="240" height="300" rx="6" stroke-opacity="0.16"></rect>
          <rect x="250" y="70" width="240" height="300" rx="6" stroke-opacity="0.22"></rect>
          <rect x="280" y="50" width="240" height="300" rx="6" stroke-opacity="0.32"></rect>
          <g stroke-linecap="round" stroke-opacity="0.28" stroke-width="2">
            <path d="M310 110h180"></path>
            <path d="M310 150h160"></path>
            <path d="M310 190h170"></path>
            <path d="M310 230h140"></path>
          </g>
        </g>
      )
    }

    {
      scene === 'builds' && (
        <>
          <g class="game-scene-ring" opacity="0.45">
            <circle cx="400" cy="210" r="70" fill="none" stroke="currentColor" stroke-width="1.5"></circle>

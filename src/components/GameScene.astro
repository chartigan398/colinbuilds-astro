          <g class="game-scene-ring-fast" opacity="0.22">
            <circle cx="400" cy="210" r="210" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1 18"></circle>
          </g>
          <circle cx="470" cy="140" r="2" fill="currentColor" fill-opacity="0.5"></circle>
          <circle cx="330" cy="260" r="1.5" fill="currentColor" fill-opacity="0.4"></circle>
          <circle cx="510" cy="250" r="1.5" fill="currentColor" fill-opacity="0.4"></circle>
        </>

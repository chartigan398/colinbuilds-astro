---
import '../styles/games.css';

const path = Astro.url.pathname;
const scene = path.includes('math-sprint')
  ? 'sprint'
  : path.includes('memory-match')
    ? 'match'
    : path.includes('quiz-show')
      ? 'quiz'
      : path.includes('typing-speed')
        ? 'type'
        : path.includes('word-scramble')
          ? 'scramble'
          : 'hub';
---

<div class="game-scene" data-scene={scene} aria-hidden="true">
  <div class="game-scene-glow"></div>
  <svg class="game-scene-svg" viewBox="0 0 800 480" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="game-floor" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"></stop>
        <stop offset="100%" stop-color="#22d3ee" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <g class="game-scene-ring game-scene-ring-slow" opacity="0.55">
      <circle cx="400" cy="210" r="150" fill="none" stroke="#22d3ee" stroke-width="1.25"></circle>
      <circle cx="400" cy="210" r="150" fill="none" stroke="#22d3ee" stroke-width="1.25" stroke-dasharray="4 18"></circle>
    </g>
    <g class="game-scene-ring" opacity="0.42">
      <circle cx="400" cy="210" r="220" fill="none" stroke="#22d3ee" stroke-width="1.25" stroke-dasharray="2 14"></circle>
    </g>
    {
      scene === 'sprint' && (
        <g fill="none" stroke="#22d3ee" stroke-opacity="0.2" stroke-width="18">
          <path d="M250 210h300M400 60v300"></path>
        </g>
      )
    }
    {
      scene === 'match' && (
        <g fill="none" stroke="#22d3ee" stroke-opacity="0.18" stroke-width="2">
          <rect x="250" y="90" width="140" height="190" rx="12"></rect>
          <rect x="410" y="120" width="140" height="190" rx="12"></rect>
        </g>
      )
    }
    {
      scene === 'quiz' && (
        <g fill="none" stroke="#22d3ee" stroke-opacity="0.2" stroke-width="2">
          <path d="M400 70 560 230 400 390 240 230Z"></path>
        </g>
      )
    }
    {
      scene === 'type' && (
        <g stroke="#22d3ee" stroke-opacity="0.2" stroke-width="3" stroke-linecap="round">
          <path d="M180 160h440M180 230h320M180 300h380"></path>
        </g>
      )
    }
    {
      scene === 'scramble' && (
        <g fill="none" stroke="#22d3ee" stroke-opacity="0.2" stroke-width="2">
          <rect x="250" y="110" width="90" height="90" rx="10"></rect>
          <rect x="360" y="110" width="90" height="90" rx="10"></rect>
          <rect x="470" y="110" width="90" height="90" rx="10"></rect>
          <rect x="305" y="220" width="90" height="90" rx="10"></rect>
          <rect x="415" y="220" width="90" height="90" rx="10"></rect>
        </g>
      )
    }
    <g stroke="url(#game-floor)" stroke-width="1">
      <path class="game-scene-grid-line" d="M0 360 L400 240 L800 360" fill="none"></path>
      <path class="game-scene-grid-line" d="M80 480 L400 240 L720 480" fill="none"></path>
      <path class="game-scene-grid-line" d="M160 480 L400 260 L640 480" fill="none"></path>
      <path class="game-scene-grid-line" d="M40 400 H760" fill="none"></path>
      <path class="game-scene-grid-line" d="M70 430 H730" fill="none"></path>
      <path class="game-scene-grid-line" d="M110 460 H690" fill="none"></path>
    </g>
  </svg>
</div>

              <circle cx="479.3" cy="202.8" r="1.2" fill-opacity="0.36"></circle>
              <circle cx="460.5" cy="215.9" r="1.8" fill-opacity="0.44"></circle>
              <circle cx="410.5" cy="233.9" r="1.2" fill-opacity="0.5"></circle>
              <circle cx="344.9" cy="232.9" r="1.5" fill-opacity="0.55"></circle>
              <circle cx="298.7" cy="230" r="1.8" fill-opacity="0.34"></circle>
              <circle cx="242.1" cy="199.6" r="1.2" fill-opacity="0.36"></circle>
              <circle cx="208.5" cy="154.9" r="1.2" fill-opacity="0.44"></circle>

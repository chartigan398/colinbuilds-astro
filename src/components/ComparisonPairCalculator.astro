---
interface PairModel {
  title: string;
  slug: string;
  costInput1m: number;
  costOutput1m: number;
}

interface Props {
  modelA: PairModel;
  modelB: PairModel;
}

const { modelA, modelB } = Astro.props;
const defaultInputMillions = 1;
const defaultOutputMillions = 1;
const calculatorId = `pair-calc-${Math.random().toString(36).slice(2, 9)}`;

const usd = (value: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: value < 1 ? 3 : 2,
  }).format(value);

const formatMillions = (millions: number) =>
  Number.isInteger(millions) ? String(millions) : String(millions);

const costsForModel = (model: PairModel, inputMillions: number, outputMillions: number) => {
  const inputCost = inputMillions * model.costInput1m;
  const outputCost = outputMillions * model.costOutput1m;
  return { inputCost, outputCost, total: inputCost + outputCost };
};

const costLine = (kind: 'Input' | 'Output', millions: number, rate: number, cost: number) =>
  `${kind}: ${formatMillions(millions)}M × ${usd(rate)} = ${usd(cost)}`;

const initialACosts = costsForModel(modelA, defaultInputMillions, defaultOutputMillions);
const initialBCosts = costsForModel(modelB, defaultInputMillions, defaultOutputMillions);
const initialDifference = initialBCosts.total - initialACosts.total;
const cheaperTitle = initialDifference > 0 ? modelA.title : initialDifference < 0 ? modelB.title : null;
const savingsAmount = Math.abs(initialDifference);
---

<section
  class="pair-calculator overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-950"
  data-calculator-id={calculatorId}
  data-model-a={JSON.stringify(modelA)}
  data-model-b={JSON.stringify(modelB)}
>
  <div class="border-b border-neutral-800 px-6 py-4">
    <h2 class="text-lg font-semibold text-white">Cost verdict</h2>
    <p class="mt-1 text-sm text-neutral-500">Enter monthly input and output volumes to see total cost savings.</p>
  </div>

  <div class="px-6 py-6">
    <div class="grid gap-3 sm:grid-cols-2">
      <label class="block text-xs font-medium uppercase tracking-wide text-neutral-500" for={`${calculatorId}-input-millions`}>
        Monthly input tokens, in millions
        <input
          id={`${calculatorId}-input-millions`}
          type="number"
          min="0"
          step="0.1"
          value={defaultInputMillions}
          class="mt-1.5 w-full rounded-lg border border-neutral-800 bg-black px-3 py-2.5 text-sm font-semibold tabular-nums text-white outline-none focus:border-cyan-400"
        />
      </label>

      <label class="block text-xs font-medium uppercase tracking-wide text-neutral-500" for={`${calculatorId}-output-millions`}>
        Monthly output tokens, in millions
        <input
          id={`${calculatorId}-output-millions`}
          type="number"
          min="0"
          step="0.1"
          value={defaultOutputMillions}
          class="mt-1.5 w-full rounded-lg border border-neutral-800 bg-black px-3 py-2.5 text-sm font-semibold tabular-nums text-white outline-none focus:border-cyan-400"
        />
      </label>
    </div>

    <div class="mt-6 grid gap-3 lg:grid-cols-2">
      <div class="rounded-xl border border-neutral-800 bg-black/40 p-4">
        <p class="pair-a-label text-sm font-medium text-cyan-400">{modelA.title}</p>
        <dl class="mt-3 space-y-2 text-sm">
          <dd class="pair-a-input-line tabular-nums text-neutral-300">
            {costLine('Input', defaultInputMillions, modelA.costInput1m, initialACosts.inputCost)}
          </dd>
          <dd class="pair-a-output-line tabular-nums text-neutral-300">
            {costLine('Output', defaultOutputMillions, modelA.costOutput1m, initialACosts.outputCost)}
          </dd>
          <div class="flex justify-between gap-4 border-t border-neutral-800 pt-3">
            <dt class="font-medium text-neutral-300">Total</dt>
            <dd class="pair-a-total text-lg font-bold tabular-nums text-white">{usd(initialACosts.total)}</dd>
          </div>
        </dl>
      </div>

      <div class="rounded-xl border border-neutral-800 bg-black/40 p-4">
        <p class="pair-b-label text-sm font-medium text-blue-400">{modelB.title}</p>
        <dl class="mt-3 space-y-2 text-sm">
          <dd class="pair-b-input-line tabular-nums text-neutral-300">
            {costLine('Input', defaultInputMillions, modelB.costInput1m, initialBCosts.inputCost)}
          </dd>
          <dd class="pair-b-output-line tabular-nums text-neutral-300">
            {costLine('Output', defaultOutputMillions, modelB.costOutput1m, initialBCosts.outputCost)}
          </dd>
          <div class="flex justify-between gap-4 border-t border-neutral-800 pt-3">
            <dt class="font-medium text-neutral-300">Total</dt>
            <dd class="pair-b-total text-lg font-bold tabular-nums text-white">{usd(initialBCosts.total)}</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="pair-savings-block mt-5 rounded-xl border border-cyan-500/30 bg-cyan-500/5 px-5 py-4">
      <p class="text-xs font-medium uppercase tracking-wide text-cyan-400">Total cost savings</p>
      <p class="pair-savings mt-1 text-3xl font-bold tabular-nums text-white">{usd(savingsAmount)}</p>
      <p class="pair-savings-note mt-2 text-sm text-neutral-400">
        {
          initialDifference === 0
            ? `Same monthly cost for ${modelA.title} and ${modelB.title} at this volume.`
            : cheaperTitle
              ? `${cheaperTitle} saves ${usd(savingsAmount)} per month vs the other model at this volume.`
              : ''
        }
      </p>
    </div>
  </div>
</section>

<script>
  type PairModel = {
    title: string;
    slug: string;
    costInput1m: number;
    costOutput1m: number;
  };

  function formatUsd(value: number) {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 2,
      maximumFractionDigits: value < 1 ? 3 : 2,
    }).format(value);
  }

  function formatMillions(millions: number) {
    return Number.isInteger(millions) ? String(millions) : String(millions);
  }

  function costsForModel(model: PairModel, inputMillions: number, outputMillions: number) {
    const inputCost = inputMillions * model.costInput1m;
    const outputCost = outputMillions * model.costOutput1m;
    return { inputCost, outputCost, total: inputCost + outputCost };
  }

  function costLine(kind: 'Input' | 'Output', millions: number, rate: number, cost: number) {
    return `${kind}: ${formatMillions(millions)}M × ${formatUsd(rate)} = ${formatUsd(cost)}`;
  }

  function initPairCalculator(root: HTMLElement) {
    const modelA = JSON.parse(root.dataset.modelA ?? '{}') as PairModel;
    const modelB = JSON.parse(root.dataset.modelB ?? '{}') as PairModel;
    const id = root.dataset.calculatorId ?? '';

    const inputEl = root.querySelector<HTMLInputElement>(`#${id}-input-millions`);
    const outputEl = root.querySelector<HTMLInputElement>(`#${id}-output-millions`);
    const aInputLine = root.querySelector('.pair-a-input-line');
    const aOutputLine = root.querySelector('.pair-a-output-line');
    const aTotal = root.querySelector('.pair-a-total');
    const bInputLine = root.querySelector('.pair-b-input-line');
    const bOutputLine = root.querySelector('.pair-b-output-line');
    const bTotal = root.querySelector('.pair-b-total');
    const savingsEl = root.querySelector('.pair-savings');
    const savingsNoteEl = root.querySelector('.pair-savings-note');

    if (
      !inputEl ||
      !outputEl ||
      !aInputLine ||
      !aOutputLine ||
      !aTotal ||
      !bInputLine ||
      !bOutputLine ||
      !bTotal ||
      !savingsEl ||
      !savingsNoteEl
    ) {
      return;
    }

    const parseMillions = (value: string) => {
      const parsed = Number(value);
      return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
    };

    const updateCard = (
      model: PairModel,
      inputMillions: number,
      outputMillions: number,
      inputLineEl: Element,
      outputLineEl: Element,
      totalEl: Element,
    ) => {
      const costs = costsForModel(model, inputMillions, outputMillions);
      inputLineEl.textContent = costLine('Input', inputMillions, model.costInput1m, costs.inputCost);
      outputLineEl.textContent = costLine('Output', outputMillions, model.costOutput1m, costs.outputCost);
      totalEl.textContent = formatUsd(costs.total);
      return costs.total;
    };

    const update = () => {
      const inputMillions = parseMillions(inputEl.value);
      const outputMillions = parseMillions(outputEl.value);

      const aTotalValue = updateCard(modelA, inputMillions, outputMillions, aInputLine, aOutputLine, aTotal);
      const bTotalValue = updateCard(modelB, inputMillions, outputMillions, bInputLine, bOutputLine, bTotal);
      const difference = bTotalValue - aTotalValue;
      const savings = Math.abs(difference);

      savingsEl.textContent = formatUsd(savings);
      if (difference === 0) {
        savingsNoteEl.textContent = `Same monthly cost for ${modelA.title} and ${modelB.title} at this volume.`;
      } else {
        const cheaper = difference > 0 ? modelA.title : modelB.title;
        savingsNoteEl.textContent = `${cheaper} saves ${formatUsd(savings)} per month vs the other model at this volume.`;
      }
    };

    inputEl.addEventListener('input', update);
    outputEl.addEventListener('input', update);
    update();
  }

  document.querySelectorAll<HTMLElement>('.pair-calculator').forEach(initPairCalculator);
</script>

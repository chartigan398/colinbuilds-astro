---
import {
  calculateEnterpriseRouting,
  PREMIUM_TRAFFIC_SHARE,
  ROUTINE_TRAFFIC_SHARE,
  type RoutingModel,
} from '../lib/enterpriseRouting';

interface Props {
  models: RoutingModel[];
  defaultPremiumSlug?: string;
  defaultEconomicalSlug?: string;
  defaultInputMillions?: number;
  defaultOutputMillions?: number;
}

const {
  models,
  defaultPremiumSlug = 'gpt-4o',
  defaultEconomicalSlug = 'deepseek-v4-flash',
  defaultInputMillions = 50,
  defaultOutputMillions = 50,
} = Astro.props;

const pricedModels = models
  .filter((model) => Number.isFinite(model.costInput1m) && Number.isFinite(model.costOutput1m))
  .sort((a, b) => a.title.localeCompare(b.title));

const modelsBySlug = new Map(pricedModels.map((model) => [model.slug, model]));
const defaultPremium =
  modelsBySlug.get(defaultPremiumSlug) ??
  pricedModels.find((model) => model.slug.includes('gpt')) ??
  pricedModels[0];
const defaultEconomical =
  modelsBySlug.get(defaultEconomicalSlug) ??
  pricedModels.find((model) => model.slug.includes('deepseek')) ??
  pricedModels.find((model) => model.slug !== defaultPremium?.slug) ??
  pricedModels[1];

const calculatorId = `enterprise-routing-${Math.random().toString(36).slice(2, 9)}`;
const canCalculate = pricedModels.length >= 2 && defaultPremium && defaultEconomical;

const usd = (value: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: value < 1 ? 3 : 2,
  }).format(value);

const formatPercent = (value: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'percent',
    minimumFractionDigits: 0,
    maximumFractionDigits: 1,
  }).format(value / 100);

const initial =
  defaultPremium && defaultEconomical
    ? calculateEnterpriseRouting({
        premium: defaultPremium,
        economical: defaultEconomical,
        inputMillions: defaultInputMillions,
        outputMillions: defaultOutputMillions,
      })
    : null;
---

{
  canCalculate && initial && defaultPremium && defaultEconomical ? (
    <section
      class="enterprise-routing-calculator overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-950 shadow-xl shadow-black/40"
      data-calculator-id={calculatorId}
      data-models={JSON.stringify(pricedModels)}
      data-routine-share={ROUTINE_TRAFFIC_SHARE}
      data-premium-share={PREMIUM_TRAFFIC_SHARE}
    >
      <div class="border-b border-neutral-800 bg-gradient-to-r from-neutral-950 via-neutral-950 to-cyan-950/20 px-6 py-5">
        <p class="text-xs font-medium uppercase tracking-wider text-cyan-400">Enterprise cost planning</p>
        <h2 class="mt-1 text-xl font-semibold text-white">Model routing savings calculator</h2>
        <p class="mt-2 max-w-3xl text-sm text-neutral-400">
          Compare sending every request to a premium model versus routing{' '}
          <span class="font-medium text-neutral-200">{ROUTINE_TRAFFIC_SHARE * 100}%</span> of routine traffic to a
          low-cost open-weight model and keeping{' '}
          <span class="font-medium text-neutral-200">{PREMIUM_TRAFFIC_SHARE * 100}%</span> on premium for hard tasks.
        </p>
      </div>

      <div class="px-6 py-6">
        <div class="grid gap-3 lg:grid-cols-2">
          <label class="block text-xs font-medium uppercase tracking-wide text-neutral-500" for={`${calculatorId}-premium`}>
            Premium model (100% baseline)
            <select
              id={`${calculatorId}-premium`}
              class="mt-1.5 w-full rounded-lg border border-neutral-800 bg-black px-3 py-2.5 text-sm font-medium text-white outline-none focus:border-cyan-400"
            >
              {pricedModels.map((model) => (
                <option value={model.slug} selected={model.slug === defaultPremium.slug}>
                  {model.title}
                </option>
              ))}
            </select>
          </label>

          <label class="block text-xs font-medium uppercase tracking-wide text-neutral-500" for={`${calculatorId}-economical`}>
            Economical model (routine traffic)
            <select
              id={`${calculatorId}-economical`}
              class="mt-1.5 w-full rounded-lg border border-neutral-800 bg-black px-3 py-2.5 text-sm font-medium text-white outline-none focus:border-cyan-400"
            >
              {pricedModels.map((model) => (
                <option value={model.slug} selected={model.slug === defaultEconomical.slug}>
                  {model.title}
                </option>
              ))}
            </select>
          </label>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <label class="block text-xs font-medium uppercase tracking-wide text-neutral-500" for={`${calculatorId}-input-millions`}>
            Monthly input tokens (millions)
            <input
              id={`${calculatorId}-input-millions`}
              type="number"
              min="0"
              step="1"
              value={defaultInputMillions}
              class="mt-1.5 w-full rounded-lg border border-neutral-800 bg-black px-3 py-2.5 text-sm font-semibold tabular-nums text-white outline-none focus:border-cyan-400"
            />
          </label>

          <label class="block text-xs font-medium uppercase tracking-wide text-neutral-500" for={`${calculatorId}-output-millions`}>
            Monthly output tokens (millions)
            <input
              id={`${calculatorId}-output-millions`}
              type="number"
              min="0"
              step="1"
              value={defaultOutputMillions}
              class="mt-1.5 w-full rounded-lg border border-neutral-800 bg-black px-3 py-2.5 text-sm font-semibold tabular-nums text-white outline-none focus:border-cyan-400"
            />
          </label>
        </div>

        <div class="mt-6 grid gap-4 lg:grid-cols-3">
          <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-5">
            <p class="text-xs font-medium uppercase tracking-wide text-rose-300">All premium</p>
            <p class="enterprise-premium-label mt-2 text-sm font-medium text-white">{defaultPremium.title}</p>
            <p class="enterprise-premium-only mt-4 text-3xl font-bold tabular-nums text-white">
              {usd(initial.premiumOnly)}
            </p>
            <p class="mt-2 text-xs text-neutral-500">100% of input and output on the premium route</p>
          </div>

          <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-5 lg:col-span-1">
            <p class="text-xs font-medium uppercase tracking-wide text-emerald-300">Routed stack</p>
            <p class="mt-2 text-sm text-neutral-300">
              <span class="enterprise-routine-share font-medium text-white">{ROUTINE_TRAFFIC_SHARE * 100}%</span>
              {' '}→ <span class="enterprise-economical-label text-emerald-200">{defaultEconomical.title}</span>
            </p>
            <p class="mt-1 text-sm text-neutral-300">
              <span class="enterprise-premium-share font-medium text-white">{PREMIUM_TRAFFIC_SHARE * 100}%</span>
              {' '}→ <span class="enterprise-premium-route-label text-cyan-200">{defaultPremium.title}</span>
            </p>
            <p class="enterprise-routed-total mt-4 text-3xl font-bold tabular-nums text-white">
              {usd(initial.routedTotal)}
            </p>
            <dl class="enterprise-routed-breakdown mt-3 space-y-1 text-xs text-neutral-400">
              <div class="flex justify-between gap-3">
                <dt>Routine slice</dt>
                <dd class="enterprise-routine-cost tabular-nums text-neutral-300">{usd(initial.routineCost)}</dd>
              </div>
              <div class="flex justify-between gap-3">
                <dt>Premium slice</dt>
                <dd class="enterprise-premium-slice-cost tabular-nums text-neutral-300">
                  {usd(initial.premiumSliceCost)}
                </dd>
              </div>
            </dl>
          </div>

          <div class="rounded-xl border border-cyan-500/30 bg-cyan-500/5 p-5">
            <p class="text-xs font-medium uppercase tracking-wide text-cyan-300">Monthly savings</p>
            <p class="enterprise-savings mt-4 text-3xl font-bold tabular-nums text-white">
              {usd(initial.savings)}
            </p>
            <p class="enterprise-savings-percent mt-2 text-lg font-semibold tabular-nums text-cyan-300">
              {formatPercent(initial.savingsPercent)} lower
            </p>
            <p class="enterprise-savings-note mt-3 text-xs leading-relaxed text-neutral-500">
              Illustration only. Uses verified per-1M rates from this directory; real routing needs quality gates and
              monitoring.
            </p>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="rounded-2xl border border-neutral-800 bg-neutral-950 p-6">
      <h2 class="text-lg font-semibold text-white">Model routing savings calculator</h2>
      <p class="mt-2 text-sm text-neutral-500">Needs pricing on at least two live models.</p>
    </section>
  )
}

<script>
  type RoutingModel = {
    title: string;
    slug: string;
    costInput1m: number;
    costOutput1m: number;
  };

  type EnterpriseRoutingResult = {
    premiumOnly: number;
    routedTotal: number;
    routineCost: number;
    premiumSliceCost: number;
    savings: number;
    savingsPercent: number;
  };

  function monthlyBill(model: RoutingModel, inputMillions: number, outputMillions: number) {
    return inputMillions * model.costInput1m + outputMillions * model.costOutput1m;
  }

  function calculateEnterpriseRouting(
    premium: RoutingModel,
    economical: RoutingModel,
    inputMillions: number,
    outputMillions: number,
    routineShare: number,
  ): EnterpriseRoutingResult {
    const premiumShare = 1 - routineShare;
    const routineInputMillions = inputMillions * routineShare;
    const routineOutputMillions = outputMillions * routineShare;
    const premiumInputMillions = inputMillions * premiumShare;
    const premiumOutputMillions = outputMillions * premiumShare;

    const premiumOnly = monthlyBill(premium, inputMillions, outputMillions);
    const routineCost = monthlyBill(economical, routineInputMillions, routineOutputMillions);
    const premiumSliceCost = monthlyBill(premium, premiumInputMillions, premiumOutputMillions);
    const routedTotal = routineCost + premiumSliceCost;
    const savings = premiumOnly - routedTotal;
    const savingsPercent = premiumOnly > 0 ? (savings / premiumOnly) * 100 : 0;

    return { premiumOnly, routedTotal, routineCost, premiumSliceCost, savings, savingsPercent };
  }

  function formatUsd(value: number) {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 2,
      maximumFractionDigits: value < 1 ? 3 : 2,
    }).format(value);
  }

  function formatPercent(value: number) {
    return new Intl.NumberFormat('en-US', {
      style: 'percent',
      minimumFractionDigits: 0,
      maximumFractionDigits: 1,
    }).format(value / 100);
  }

  function initEnterpriseCalculator(root: HTMLElement) {
    const models = JSON.parse(root.dataset.models ?? '[]') as RoutingModel[];
    const modelsBySlug = new Map(models.map((model) => [model.slug, model]));
    const routineShare = Number(root.dataset.routineShare ?? '0.8');
    const premiumShare = Number(root.dataset.premiumShare ?? '0.2');
    const id = root.dataset.calculatorId ?? '';

    const premiumSelect = root.querySelector<HTMLSelectElement>(`#${id}-premium`);
    const economicalSelect = root.querySelector<HTMLSelectElement>(`#${id}-economical`);
    const inputEl = root.querySelector<HTMLInputElement>(`#${id}-input-millions`);
    const outputEl = root.querySelector<HTMLInputElement>(`#${id}-output-millions`);

    const premiumOnlyEl = root.querySelector('.enterprise-premium-only');
    const premiumLabelEl = root.querySelector('.enterprise-premium-label');
    const economicalLabelEl = root.querySelector('.enterprise-economical-label');
    const premiumRouteLabelEl = root.querySelector('.enterprise-premium-route-label');
    const routedTotalEl = root.querySelector('.enterprise-routed-total');
    const routineCostEl = root.querySelector('.enterprise-routine-cost');
    const premiumSliceCostEl = root.querySelector('.enterprise-premium-slice-cost');
    const savingsEl = root.querySelector('.enterprise-savings');
    const savingsPercentEl = root.querySelector('.enterprise-savings-percent');
    const routineShareEl = root.querySelector('.enterprise-routine-share');
    const premiumShareEl = root.querySelector('.enterprise-premium-share');

    if (
      !premiumSelect ||
      !economicalSelect ||
      !inputEl ||
      !outputEl ||
      !premiumOnlyEl ||
      !premiumLabelEl ||
      !economicalLabelEl ||
      !premiumRouteLabelEl ||
      !routedTotalEl ||
      !routineCostEl ||
      !premiumSliceCostEl ||
      !savingsEl ||
      !savingsPercentEl ||
      !routineShareEl ||
      !premiumShareEl
    ) {
      return;
    }

    routineShareEl.textContent = String(routineShare * 100);
    premiumShareEl.textContent = String(premiumShare * 100);

    const parseMillions = (value: string) => {
      const parsed = Number(value);
      return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
    };

    const update = () => {
      const premium = modelsBySlug.get(premiumSelect.value);
      const economical = modelsBySlug.get(economicalSelect.value);
      if (!premium || !economical) return;

      const inputMillions = parseMillions(inputEl.value);
      const outputMillions = parseMillions(outputEl.value);
      const result = calculateEnterpriseRouting(
        premium,
        economical,
        inputMillions,
        outputMillions,
        routineShare,
      );

      premiumLabelEl.textContent = premium.title;
      economicalLabelEl.textContent = economical.title;
      premiumRouteLabelEl.textContent = premium.title;
      premiumOnlyEl.textContent = formatUsd(result.premiumOnly);
      routedTotalEl.textContent = formatUsd(result.routedTotal);
      routineCostEl.textContent = formatUsd(result.routineCost);
      premiumSliceCostEl.textContent = formatUsd(result.premiumSliceCost);
      savingsEl.textContent = formatUsd(result.savings);
      savingsPercentEl.textContent = `${formatPercent(result.savingsPercent)} lower`;
    };

    premiumSelect.addEventListener('change', update);
    economicalSelect.addEventListener('change', update);
    inputEl.addEventListener('input', update);
    outputEl.addEventListener('input', update);
    update();
  }

  document.querySelectorAll<HTMLElement>('.enterprise-routing-calculator').forEach(initEnterpriseCalculator);
</script>

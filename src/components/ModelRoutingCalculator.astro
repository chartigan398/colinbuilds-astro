---
interface Props {
  modelTitle: string;
  costInput1m: number;
}

const { modelTitle, costInput1m } = Astro.props;
const gpt4oBaseline = 5;
const defaultMillions = 10;
const initialGpt4oCost = defaultMillions * gpt4oBaseline;
const initialModelCost = defaultMillions * costInput1m;
const initialSavings = initialGpt4oCost - initialModelCost;
const calculatorId = `routing-calc-${Math.random().toString(36).slice(2, 9)}`;

const usd = (value: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(value);
---

<section
  class="routing-calculator mt-6 overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-950 shadow-xl shadow-black/40"
  data-calculator-id={calculatorId}
  data-model-title={modelTitle}
  data-cost-input={costInput1m}
  data-gpt4o-baseline={gpt4oBaseline}
>
  <div class="border-b border-neutral-800 bg-gradient-to-r from-neutral-950 via-black to-neutral-950 px-6 py-5">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-cyan-400">Model Routing</p>
    <h2 class="mt-1 text-xl font-semibold text-white">Cost Calculator</h2>
    <p class="mt-2 max-w-2xl text-sm text-neutral-400">
      Compare monthly input spend against a GPT-4o baseline of ${gpt4oBaseline.toFixed(2)} per 1M tokens
      versus routing to {modelTitle} at ${costInput1m.toFixed(2)} per 1M tokens.
    </p>
  </div>

  <div class="px-6 py-8">
    <label class="block text-sm font-medium text-neutral-300" for={`${calculatorId}-input`}>
      Estimated monthly input tokens (millions)
    </label>
    <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-end">
      <div class="flex-1">
        <input
          id={`${calculatorId}-range`}
          type="range"
          min="1"
          max="500"
          step="1"
          value="10"
          class="routing-range h-2 w-full cursor-pointer appearance-none rounded-full bg-neutral-800 accent-cyan-400"
        />
        <div class="mt-2 flex justify-between text-xs text-neutral-500">
          <span>1M</span>
          <span>500M</span>
        </div>
      </div>
      <div class="w-full sm:w-40">
        <input
          id={`${calculatorId}-input`}
          type="number"
          min="1"
          max="500"
          step="1"
          value="10"
          class="w-full rounded-xl border border-neutral-700 bg-black px-4 py-3 text-lg font-semibold text-white outline-none focus:border-cyan-400"
        />
      </div>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      <div class="rounded-xl border border-neutral-700 bg-black p-5">
        <p class="text-xs uppercase tracking-wider text-neutral-500">GPT-4o baseline</p>
        <p class="routing-gpt4o-cost mt-2 text-3xl font-bold text-white">{usd(initialGpt4oCost)}</p>
        <p class="mt-2 text-sm text-neutral-500">Premium Western model reference</p>
      </div>
      <div class="rounded-xl border border-cyan-500/30 bg-cyan-500/5 p-5">
        <p class="text-xs uppercase tracking-wider text-cyan-400">{modelTitle}</p>
        <p class="routing-model-cost mt-2 text-3xl font-bold text-white">{usd(initialModelCost)}</p>
        <p class="mt-2 text-sm text-neutral-500">This model's input pricing</p>
      </div>
    </div>

    <div class="routing-savings-block mt-8 rounded-2xl border border-cyan-500/30 bg-gradient-to-br from-cyan-500/10 via-black to-blue-500/10 px-6 py-8 text-center">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-cyan-400">Total monthly savings</p>
      <p class="routing-savings mt-3 text-5xl font-bold tracking-tight text-white sm:text-6xl">{usd(Math.max(initialSavings, 0))}</p>
      <p class="routing-savings-note mt-3 text-sm text-neutral-400">
        Savings vs GPT-4o at your selected input volume
      </p>
    </div>
  </div>
</section>

<script>
  function formatUsd(value: number) {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(value);
  }

  function initCalculator(root: HTMLElement) {
    const modelTitle = root.dataset.modelTitle ?? 'This model';
    const costInput = Number(root.dataset.costInput ?? 0);
    const gpt4oBaseline = Number(root.dataset.gpt4oBaseline ?? 5);
    const id = root.dataset.calculatorId ?? '';

    const range = root.querySelector<HTMLInputElement>(`#${id}-range`);
    const input = root.querySelector<HTMLInputElement>(`#${id}-input`);
    const gpt4oEl = root.querySelector('.routing-gpt4o-cost');
    const modelEl = root.querySelector('.routing-model-cost');
    const savingsEl = root.querySelector('.routing-savings');
    const savingsNoteEl = root.querySelector('.routing-savings-note');
    const savingsBlock = root.querySelector('.routing-savings-block');

    if (!range || !input || !gpt4oEl || !modelEl || !savingsEl || !savingsNoteEl || !savingsBlock) {
      return;
    }

    const clamp = (value: number) => Math.min(500, Math.max(1, value));

    const update = (rawValue: number) => {
      const millions = clamp(rawValue);
      range.value = String(millions);
      input.value = String(millions);

      const gpt4oCost = millions * gpt4oBaseline;
      const modelCost = millions * costInput;
      const savings = gpt4oCost - modelCost;

      gpt4oEl.textContent = formatUsd(gpt4oCost);
      modelEl.textContent = formatUsd(modelCost);

      if (savings > 0) {
        savingsEl.textContent = formatUsd(savings);
        savingsNoteEl.textContent = `You save by routing to ${modelTitle} instead of GPT-4o at ${millions}M input tokens/month.`;
        savingsBlock.classList.remove('border-neutral-700', 'from-neutral-900/20', 'to-neutral-900/20');
        savingsBlock.classList.add('border-cyan-500/30', 'from-cyan-500/10', 'to-blue-500/10');
        savingsEl.classList.remove('text-neutral-400');
        savingsEl.classList.add('text-white');
      } else if (savings < 0) {
        savingsEl.textContent = formatUsd(Math.abs(savings));
        savingsNoteEl.textContent = `${modelTitle} costs more than the GPT-4o baseline at ${millions}M input tokens/month.`;
        savingsBlock.classList.remove('border-cyan-500/30', 'from-cyan-500/10', 'to-blue-500/10');
        savingsBlock.classList.add('border-neutral-700', 'from-neutral-900/20', 'to-neutral-900/20');
        savingsEl.classList.remove('text-white');
        savingsEl.classList.add('text-neutral-400');
      } else {
        savingsEl.textContent = formatUsd(0);
        savingsNoteEl.textContent = `Same input cost as the GPT-4o baseline at ${millions}M tokens/month.`;
      }
    };

    range.addEventListener('input', () => update(Number(range.value)));
    input.addEventListener('input', () => update(Number(input.value)));
    update(Number(input.value));
  }

  document.querySelectorAll<HTMLElement>('.routing-calculator').forEach(initCalculator);
</script>

<style>
  .routing-range::-webkit-slider-thumb {
    appearance: none;
    height: 1.125rem;
    width: 1.125rem;
    border-radius: 9999px;
    border: 2px solid #22d3ee;
    background: #000;
    cursor: pointer;
  }

  .routing-range::-moz-range-thumb {
    height: 1.125rem;
    width: 1.125rem;
    border-radius: 9999px;
    border: 2px solid #22d3ee;
    background: #000;
    cursor: pointer;
  }
</style>

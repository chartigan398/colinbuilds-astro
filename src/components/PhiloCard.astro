---
interface Props {
  href?: string;
  title: string;
  description: string;
  cta?: string;
  kicker?: string;
  soon?: boolean;
}

const { href, title, description, cta = 'Open →', kicker, soon = false } = Astro.props;
---

{
  href && !soon ? (
    <a href={href} class="row-link">
      <div>
        {kicker && <p class="row-kicker">{kicker}</p>}
        <h2 class="row-title">{title}</h2>
        <p class="row-desc">{description}</p>
      </div>
      <span class="row-cta">{cta}</span>
    </a>
  ) : (
    <div class="row-link">
      <div>
        {kicker && <p class="row-kicker">{kicker}</p>}
        <h2 class="row-title">{title}</h2>
        <p class="row-desc">{description}</p>
      </div>
      <span class="row-cta">{soon ? 'Not ready' : cta}</span>
    </div>
  )
}
